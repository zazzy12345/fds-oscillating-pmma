+SUBROUTINE DEV159_WRITE_OPEN_FACES(T,NM,STAGE_NAME,ESTIMATED,UU,VV,WW,RHOP)
+
+USE FRAME_FUNCTIONS, ONLY: GET_FRAME_KINEMATICS
+REAL(EB), INTENT(IN) :: T
+INTEGER, INTENT(IN) :: NM
+CHARACTER(LEN=*), INTENT(IN) :: STAGE_NAME
+LOGICAL, INTENT(IN) :: ESTIMATED
+REAL(EB), POINTER, INTENT(IN) :: UU(:,:,:),VV(:,:,:),WW(:,:,:),RHOP(:,:,:)
+INTEGER :: IW,IOR,IIG,JJG,KKG,II,JJ,KK
+REAL(EB) :: X_FRAME(3),U_FRAME_LOCAL(3),A_FRAME_LOCAL(3),TARGET(3),ORACLE(3),ACTUAL(3),EDGES(4),XYZ(3),N_IN(3)
+INTEGER :: BRANCH_CODE,BRANCH_PRESSURE_ITERATION
+REAL(EB) :: AREA,RHO_TARGET,RHO_ACTUAL,UN_TARGET,UN_ACTUAL,UN_INTERIOR,BRANCH_SOURCE_UN, &
+            MDOT_TARGET,MDOT_ACTUAL,MOM_TARGET(3),MOM_ACTUAL(3)
+CHARACTER(LEN=32) :: NORMAL_CONTRACT,TANGENTIAL_FACE_CONTRACT,PRESSURE_BRANCH,EXPECTED_ROLE, &
+                     TARGET_SIGN,ACTUAL_SIGN,SOURCE_SIGN
+LOGICAL :: BRANCH_JOIN_VALID
+CHARACTER(LEN=8192) :: LINE
+TYPE(WALL_TYPE), POINTER :: WC
+TYPE(BOUNDARY_COORD_TYPE), POINTER :: BC
+TYPE(BOUNDARY_PROP1_TYPE), POINTER :: B1
+
+IF (DEV159_TRACE_MODE(NM)/=1) RETURN
+IF (.NOT.DEV161_BC_CACHE_MATCH(T,STAGE_NAME)) RETURN
+CALL GET_FRAME_KINEMATICS(T,X_FRAME,U_FRAME_LOCAL,A_FRAME_LOCAL)
+ORACLE=-U_FRAME_LOCAL
+
+OPEN_FACE_LOOP: DO IW=1,N_EXTERNAL_WALL_CELLS
+   WC=>WALL(IW)
+   IF (WC%BOUNDARY_TYPE/=OPEN_BOUNDARY) CYCLE OPEN_FACE_LOOP
+   BC=>BOUNDARY_COORD(WC%BC_INDEX)
+   B1=>BOUNDARY_PROP1(WC%B1_INDEX)
+   IOR=BC%IOR
+   IIG=BC%IIG
+   JJG=BC%JJG
+   KKG=BC%KKG
+   II=BC%II
+   JJ=BC%JJ
+   KK=BC%KK
+   TARGET=[U_WIND(KK),V_WIND(KK),W_WIND(KK)]
+   XYZ=[BC%X,BC%Y,BC%Z]
+   ACTUAL=0._EB
+   EDGES=0._EB
+   N_IN=0._EB
+   N_IN(ABS(IOR))=SIGN(1._EB,REAL(IOR,EB))
+   SELECT CASE(IOR)
+      CASE(IAXIS);  ACTUAL(1)=UU(IIG-1,JJG,KKG)
+      CASE(-IAXIS); ACTUAL(1)=UU(IIG,JJG,KKG)
+      CASE(JAXIS);  ACTUAL(2)=VV(IIG,JJG-1,KKG)
+      CASE(-JAXIS); ACTUAL(2)=VV(IIG,JJG,KKG)
+      CASE(KAXIS);  ACTUAL(3)=WW(IIG,JJG,KKG-1)
+      CASE(-KAXIS); ACTUAL(3)=WW(IIG,JJG,KKG)
+      CASE DEFAULT; CYCLE OPEN_FACE_LOOP
+   END SELECT
+   SELECT CASE(ABS(IOR))
+      CASE(IAXIS)
+         EDGES=[VV(II,JJG-1,KKG),VV(II,JJG,KKG),WW(II,JJG,KKG-1),WW(II,JJG,KKG)]
+         ACTUAL(2)=0.5_EB*(EDGES(1)+EDGES(2))
+         ACTUAL(3)=0.5_EB*(EDGES(3)+EDGES(4))
+         AREA=(BC%Y2-BC%Y1)*(BC%Z2-BC%Z1)
+      CASE(JAXIS)
+         EDGES=[UU(IIG-1,JJ,KKG),UU(IIG,JJ,KKG),WW(IIG,JJ,KKG-1),WW(IIG,JJ,KKG)]
+         ACTUAL(1)=0.5_EB*(EDGES(1)+EDGES(2))
+         ACTUAL(3)=0.5_EB*(EDGES(3)+EDGES(4))
+         AREA=(BC%X2-BC%X1)*(BC%Z2-BC%Z1)
+      CASE(KAXIS)
+         EDGES=[UU(IIG-1,JJG,KK),UU(IIG,JJG,KK),VV(IIG,JJG-1,KK),VV(IIG,JJG,KK)]
+         ACTUAL(1)=0.5_EB*(EDGES(1)+EDGES(2))
+         ACTUAL(2)=0.5_EB*(EDGES(3)+EDGES(4))
+         AREA=(BC%X2-BC%X1)*(BC%Y2-BC%Y1)
+   END SELECT
+   RHO_TARGET=B1%RHO_F
+   RHO_ACTUAL=RHOP(IIG,JJG,KKG)
+   UN_TARGET=DOT_PRODUCT(TARGET,N_IN)
+   UN_ACTUAL=DOT_PRODUCT(ACTUAL,N_IN)
+   SELECT CASE(IOR)
+      CASE(IAXIS);  UN_INTERIOR= UU(IIG,JJG,KKG)
+      CASE(-IAXIS); UN_INTERIOR=-UU(IIG-1,JJG,KKG)
+      CASE(JAXIS);  UN_INTERIOR= VV(IIG,JJG,KKG)
+      CASE(-JAXIS); UN_INTERIOR=-VV(IIG,JJG-1,KKG)
+      CASE(KAXIS);  UN_INTERIOR= WW(IIG,JJG,KKG)
+      CASE(-KAXIS); UN_INTERIOR=-WW(IIG,JJG,KKG-1)
+   END SELECT
+
+   BRANCH_JOIN_VALID=.FALSE.
+   BRANCH_CODE=0
+   BRANCH_SOURCE_UN=0._EB
+   BRANCH_PRESSURE_ITERATION=-1
+   IF (DEV161_OPEN_BRANCH_VALID .AND. DEV161_OPEN_BRANCH_ICYC==ICYC .AND. &
+       DEV161_OPEN_BRANCH_PRESSURE_ITERATION==PRESSURE_ITERATIONS .AND. &
+       ((STAGE_NAME=='predictor_bc' .AND. DEV161_OPEN_BRANCH_ESTIMATED .AND. ESTIMATED) .OR. &
+        (STAGE_NAME=='corrector_bc' .AND. .NOT.DEV161_OPEN_BRANCH_ESTIMATED .AND. .NOT.ESTIMATED))) THEN
+      IF (ALLOCATED(DEV161_OPEN_BRANCH) .AND. ALLOCATED(DEV161_OPEN_BRANCH_UN)) THEN
+         IF (IW<=SIZE(DEV161_OPEN_BRANCH) .AND. IW<=SIZE(DEV161_OPEN_BRANCH_UN)) THEN
+            BRANCH_CODE=DEV161_OPEN_BRANCH(IW)
+            BRANCH_SOURCE_UN=DEV161_OPEN_BRANCH_UN(IW)
+            BRANCH_PRESSURE_ITERATION=DEV161_OPEN_BRANCH_PRESSURE_ITERATION
+            BRANCH_JOIN_VALID=BRANCH_CODE==1 .OR. BRANCH_CODE==2
+         ENDIF
+      ENDIF
+   ENDIF
+
+   IF (UN_TARGET>0._EB) THEN
+      TARGET_SIGN='positive'
+      EXPECTED_ROLE='target_inflow'
+   ELSEIF (UN_TARGET<0._EB) THEN
+      TARGET_SIGN='negative'
+      EXPECTED_ROLE='target_outflow'
+   ELSE
+      TARGET_SIGN='zero'
+      EXPECTED_ROLE='transition_exact'
+   ENDIF
+   IF (UN_ACTUAL>0._EB) THEN
+      ACTUAL_SIGN='positive'
+   ELSEIF (UN_ACTUAL<0._EB) THEN
+      ACTUAL_SIGN='negative'
+   ELSE
+      ACTUAL_SIGN='zero'
+   ENDIF
+   IF (.NOT.BRANCH_JOIN_VALID) THEN
+      SOURCE_SIGN='not_recorded'
+   ELSEIF (BRANCH_SOURCE_UN>0._EB) THEN
+      SOURCE_SIGN='positive'
+   ELSEIF (BRANCH_SOURCE_UN<0._EB) THEN
+      SOURCE_SIGN='negative'
+   ELSE
+      SOURCE_SIGN='zero'
+   ENDIF
+
+   SELECT CASE(BRANCH_CODE)
+      CASE(1)
+         PRESSURE_BRANCH='prescribed_inflow'
+         NORMAL_CONTRACT='prescribed_target'
+      CASE(2)
+         PRESSURE_BRANCH='characteristic_outflow'
+         NORMAL_CONTRACT='characteristic_extrapolation'
+      CASE DEFAULT
+         PRESSURE_BRANCH='not_recorded'
+         NORMAL_CONTRACT='not_recorded'
+   END SELECT
+   TANGENTIAL_FACE_CONTRACT='edge_branch_not_traced'
+   MDOT_TARGET=RHO_TARGET*UN_TARGET*AREA
+   MDOT_ACTUAL=RHO_ACTUAL*UN_ACTUAL*AREA
+   MOM_TARGET=MDOT_TARGET*TARGET
+   MOM_ACTUAL=MDOT_ACTUAL*ACTUAL
+   LINE='DEV161_G1_TRACE v=2 kind=open_face mode=kin4 chid='//TRIM(CHID)// &
+        ' restart='//MERGE('1','0',RESTART)//' rank='//TRIM(DEV159_INT(MY_RANK))// &
+        ' mesh='//TRIM(DEV159_INT(NM))//' icyc='//TRIM(DEV159_INT(ICYC))// &
+        ' routine=velocity_bc stage='//TRIM(STAGE_NAME)//' estimated='//MERGE('1','0',ESTIMATED)
+   LINE=TRIM(LINE)//' T='//TRIM(DEV159_REAL(T))//' T_bits='//DEV159_BITS(T)// &
+        ' DT='//TRIM(DEV159_REAL(DEV159_LAST_FLUX_DT))//' DT_bits='//DEV159_BITS(DEV159_LAST_FLUX_DT)// &
+        ' iw='//TRIM(DEV159_INT(IW))//' vent='//TRIM(DEV159_INT(WC%VENT_INDEX))// &
+        ' ior='//TRIM(DEV159_INT(IOR))//' ii='//TRIM(DEV159_INT(II))// &
+        ' jj='//TRIM(DEV159_INT(JJ))//' kk='//TRIM(DEV159_INT(KK))// &
+        ' iig='//TRIM(DEV159_INT(IIG))//' jjg='//TRIM(DEV159_INT(JJG))//' kkg='//TRIM(DEV159_INT(KKG))
+   LINE=TRIM(LINE)//' xyz='//TRIM(DEV159_VEC3(XYZ))//' xyz_bits='//TRIM(DEV159_BITS3(XYZ))// &
+        ' area='//TRIM(DEV159_REAL(AREA))//' area_bits='//DEV159_BITS(AREA)// &
+        ' target='//TRIM(DEV159_VEC3(TARGET))//' target_bits='//TRIM(DEV159_BITS3(TARGET))// &
+        ' oracle='//TRIM(DEV159_VEC3(ORACLE))//' oracle_bits='//TRIM(DEV159_BITS3(ORACLE))
+   LINE=TRIM(LINE)//' actual='//TRIM(DEV159_VEC3(ACTUAL))//' actual_bits='//TRIM(DEV159_BITS3(ACTUAL))// &
+        ' edges='//TRIM(DEV159_VEC4(EDGES))//' edges_bits='//TRIM(DEV159_BITS4(EDGES))// &
+        ' rho_target='//TRIM(DEV159_REAL(RHO_TARGET))//' rho_target_bits='//DEV159_BITS(RHO_TARGET)// &
+        ' rho_actual='//TRIM(DEV159_REAL(RHO_ACTUAL))//' rho_actual_bits='//DEV159_BITS(RHO_ACTUAL)
+   LINE=TRIM(LINE)//' un_target='//TRIM(DEV159_REAL(UN_TARGET))//' un_target_bits='//DEV159_BITS(UN_TARGET)// &
+        ' un_actual='//TRIM(DEV159_REAL(UN_ACTUAL))//' un_actual_bits='//DEV159_BITS(UN_ACTUAL)// &
+        ' un_interior='//TRIM(DEV159_REAL(UN_INTERIOR))//' un_interior_bits='//DEV159_BITS(UN_INTERIOR)// &
+        ' branch_source_un='//TRIM(DEV159_REAL(BRANCH_SOURCE_UN))// &
+        ' branch_source_un_bits='//DEV159_BITS(BRANCH_SOURCE_UN)// &
+        ' branch_join_valid='//MERGE('1','0',BRANCH_JOIN_VALID)
+   LINE=TRIM(LINE)//' branch_pressure_iteration='//TRIM(DEV159_INT(BRANCH_PRESSURE_ITERATION))// &
+        ' expected_role_exact='//TRIM(EXPECTED_ROLE)//' target_sign_exact='//TRIM(TARGET_SIGN)// &
+        ' actual_sign_exact='//TRIM(ACTUAL_SIGN)//' branch_source_sign_exact='//TRIM(SOURCE_SIGN)// &
+        ' pressure_branch='//TRIM(PRESSURE_BRANCH)// &
+        ' normal_contract='//TRIM(NORMAL_CONTRACT)// &
+        ' tangential_face_contract='//TRIM(TANGENTIAL_FACE_CONTRACT)// &
+        ' mdot_target='//TRIM(DEV159_REAL(MDOT_TARGET))//' mdot_target_bits='//DEV159_BITS(MDOT_TARGET)// &
+        ' mdot_actual='//TRIM(DEV159_REAL(MDOT_ACTUAL))//' mdot_actual_bits='//DEV159_BITS(MDOT_ACTUAL)
+   LINE=TRIM(LINE)//' mom_target='//TRIM(DEV159_VEC3(MOM_TARGET))// &
+        ' mom_target_bits='//TRIM(DEV159_BITS3(MOM_TARGET))// &
+        ' mom_actual='//TRIM(DEV159_VEC3(MOM_ACTUAL))//' mom_actual_bits='//TRIM(DEV159_BITS3(MOM_ACTUAL))
+   WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+ENDDO OPEN_FACE_LOOP
+
+END SUBROUTINE DEV159_WRITE_OPEN_FACES
