+   WRITE(RG_AUDIT) BC%X,BC%Y,BC%Z,TF,TB,OLD%LAYER_DIVIDE_DEPTH
+   WRITE(RG_AUDIT) OLD%MATL_INDEX
+   WRITE(RG_AUDIT) OLD%X(0:NO),OLD%TMP(0:NO+1)
