+   ENDDO ; ENDDO ; ENDDO
+   DX_MIN=MIN(MINVAL(M%DX(1:M%IBAR)),MINVAL(M%DY(1:M%JBAR)),MINVAL(M%DZ(1:M%KBAR)))
+   DIV_LIMIT=512._EB*EPSILON(1._EB)*0.005_EB/DX_MIN
+   IF (DIV_MAX>DIV_LIMIT) THEN ; CALL SHUTDOWN('ERROR(UOBS): discrete-curl divergence gate failed.') ; RETURN ; ENDIF
+   DEALLOCATE(AZ,DU,DV)
+END SELECT
+M%US=M%U ; M%VS=M%V ; M%WS=M%W ; M%ZZS=M%ZZ ; M%RHOS=M%RHO
+CALL UOBS_EMIT_PACKET(T_BEGIN,NM,TF_PACKET_KIND,(/XC0,YC0,ZC0/),SIG,&
+   MERGE(0.005_EB,MERGE(1._EB,0.01_EB,TF_PACKET_KIND=='THERMAL'),TF_PACKET_KIND=='VORTEX'),&
+   INTEGRAL,KE,DIV_MAX,DIV_LIMIT)
+END SUBROUTINE APPLY_UOBS_PACKET
+
 END MODULE INIT
