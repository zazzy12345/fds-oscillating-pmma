+REAL(EB) :: X_FRAME(3),U_FRAME_LOCAL(3),A_FRAME_LOCAL(3)
+CHARACTER(LEN=4096) :: LINE
+
+MODE=DEV159_TRACE_MODE(NM)
+IF (MODE==0) RETURN
+CALL GET_FRAME_KINEMATICS(T,X_FRAME,U_FRAME_LOCAL,A_FRAME_LOCAL)
+IF (MODE==1 .AND. ROUTINE_NAME=='velocity_flux') THEN
+   DEV159_LAST_FLUX_DT=DT
+   DEV159_LAST_FLUX_T=T
+   DEV159_LAST_FLUX_ICYC=ICYC
+   DEV159_LAST_FLUX_STAGE=STAGE_NAME
+   DEV159_LAST_FLUX_VALID=.TRUE.
+ENDIF
+LINE='DEV161_G1_TRACE v=2 kind=frame mode='//TRIM(DEV159_MODE_NAME(MODE))//' chid='//TRIM(CHID)// &
+     ' restart='//MERGE('1','0',RESTART)//' rank='//TRIM(DEV159_INT(MY_RANK))// &
+     ' mesh='//TRIM(DEV159_INT(NM))//' icyc='//TRIM(DEV159_INT(ICYC))
+LINE=TRIM(LINE)//' routine='//TRIM(ROUTINE_NAME)//' stage='//TRIM(STAGE_NAME)// &
+     ' estimated='//MERGE('1','0',ESTIMATED)//' T='//TRIM(DEV159_REAL(T))// &
+     ' T_bits='//DEV159_BITS(T)//' DT='//TRIM(DEV159_REAL(DT))//' DT_bits='//DEV159_BITS(DT)
+LINE=TRIM(LINE)//' x='//TRIM(DEV159_VEC3(X_FRAME))//' x_bits='//TRIM(DEV159_BITS3(X_FRAME))// &
+     ' u='//TRIM(DEV159_VEC3(U_FRAME_LOCAL))//' u_bits='//TRIM(DEV159_BITS3(U_FRAME_LOCAL))// &
+     ' a='//TRIM(DEV159_VEC3(A_FRAME_LOCAL))//' a_bits='//TRIM(DEV159_BITS3(A_FRAME_LOCAL))
+WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+
+END SUBROUTINE DEV159_WRITE_FRAME
