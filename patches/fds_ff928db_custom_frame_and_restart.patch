+LOGICAL FUNCTION DEV161_BC_CACHE_MATCH(T,STAGE_NAME)
+
+REAL(EB), INTENT(IN) :: T
+CHARACTER(LEN=*), INTENT(IN) :: STAGE_NAME
+
+DEV161_BC_CACHE_MATCH=.FALSE.
+IF (.NOT.DEV159_LAST_FLUX_VALID) RETURN
+IF (DEV159_LAST_FLUX_ICYC/=ICYC) RETURN
+SELECT CASE(STAGE_NAME)
+   CASE('predictor_bc')
+      IF (DEV159_LAST_FLUX_STAGE/='predictor_flux') RETURN
+      IF (T/=DEV159_LAST_FLUX_T+DEV159_LAST_FLUX_DT) RETURN
+   CASE('corrector_bc')
+      IF (DEV159_LAST_FLUX_STAGE/='corrector_flux') RETURN
+      IF (T/=DEV159_LAST_FLUX_T) RETURN
+   CASE DEFAULT
+      RETURN
+END SELECT
+DEV161_BC_CACHE_MATCH=.TRUE.
+
+END FUNCTION DEV161_BC_CACHE_MATCH
