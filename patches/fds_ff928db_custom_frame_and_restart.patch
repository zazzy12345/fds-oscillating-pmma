+INTEGER FUNCTION DEV159_TRACE_MODE(NM)
+
+USE MATH_FUNCTIONS, ONLY: EVALUATE_RAMP
+INTEGER, INTENT(IN) :: NM
+INTEGER :: ENV_LENGTH,ENV_STATUS,I
+CHARACTER(LEN=8) :: ENV_VALUE
+
+DEV159_TRACE_MODE=0
+ENV_VALUE=''
+CALL GET_ENVIRONMENT_VARIABLE('FDS_DEV161_TRACE',ENV_VALUE,LENGTH=ENV_LENGTH,STATUS=ENV_STATUS)
+IF (ENV_STATUS/=0 .OR. ENV_LENGTH/=1) RETURN
+IF (ENV_VALUE(1:1)/='1' .OR. INITIALIZATION_PHASE) RETURN
+ENV_VALUE=''
+CALL GET_ENVIRONMENT_VARIABLE('FDS_G1_TRACE_ROLE',ENV_VALUE,LENGTH=ENV_LENGTH,STATUS=ENV_STATUS)
+IF (ENV_STATUS/=0 .OR. (ENV_LENGTH/=4 .AND. ENV_LENGTH/=5)) RETURN
+IF (MY_RANK/=0 .OR. N_MPI_PROCESSES/=1 .OR. NMESHES/=1 .OR. NM/=1) RETURN
+IF (IBAR/=4 .OR. JBAR/=4 .OR. KBAR/=4 .OR. TWO_D .OR. CYLINDRICAL .OR. CC_IBM) RETURN
+IF (NOISE .OR. STRATIFICATION) RETURN
+IF (.NOT.TRANSLATING_FRAME .OR. T_BEGIN/=0._EB .OR. STORAGE_SIZE(0._EB)/=64) RETURN
+IF (TF_MOTION_TYPE/='HARMONIC_TRANSLATION') RETURN
+IF (ANY(TF_AXIS/=[1._EB,0._EB,0._EB])) RETURN
+IF (TF_AMPLITUDE/=0.1_EB .OR. TF_FREQUENCY/=0.125_EB .OR. TF_PHASE/=0.5_EB*PI) RETURN
+IF (TF_T_START/=0._EB .OR. TF_RAMP_TIME/=0._EB) RETURN
+
+SELECT CASE(ENV_VALUE(1:ENV_LENGTH))
+CASE('KIN4')
+   IF (.NOT.LOCK_TIME_STEP .OR. DT_INITIAL/=0.125_EB) RETURN
+   IF (T_END/=27._EB .AND. T_END/=28._EB) RETURN
+   IF (.NOT.TF_APPLY_TO_OPEN_BOUNDARIES .OR. .NOT.OPEN_WIND_BOUNDARY) RETURN
+   DEV159_TRACE_MODE=1
+   RETURN
+
+CASE('RETRY')
+   IF (LOCK_TIME_STEP .OR. .NOT.RESTRICT_TIME_STEP .OR. RESTART) RETURN
+   IF (DT_INITIAL/=0.05_EB .OR. T_END/=0.1_EB .OR. CFL_MAX/=0.5_EB) RETURN
+   IF (TF_APPLY_TO_OPEN_BOUNDARIES .OR. OPEN_WIND_BOUNDARY) RETURN
+   IF (WIND_INPUT_PRESENT .OR. U0/=0._EB .OR. V0/=0._EB .OR. W0/=0._EB) RETURN
+   IF (I_RAMP_UX<=0 .OR. I_RAMP_UY/=0 .OR. I_RAMP_UZ/=0) RETURN
+   IF (I_RAMP_VX/=0 .OR. I_RAMP_VY/=0 .OR. I_RAMP_VZ/=0) RETURN
+   IF (I_RAMP_WX/=0 .OR. I_RAMP_WY/=0 .OR. I_RAMP_WZ/=0) RETURN
+   DO I=0,IBAR
+      IF (EVALUATE_RAMP(X(I),I_RAMP_UX)/=10._EB) RETURN
+   ENDDO
+   DEV159_TRACE_MODE=2
+CASE DEFAULT
+   RETURN
+END SELECT
+
+END FUNCTION DEV159_TRACE_MODE
+
+
