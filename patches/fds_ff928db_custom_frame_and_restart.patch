+      ENDDO
+   ENDDO
+ENDDO
+DO I=1,NN
+   IF (SUM(RN(I,:))<=0._EB) THEN
+      CALL SHUTDOWN('ERROR: CNF regrid zero-mass cell has no registered temperature rule.',PROCESS_0_ONLY=.FALSE.); RETURN
+   ENDIF
+   IL=0; IH=I_MAX_TEMP
+   HL=0._EB; HH=0._EB
+   DO K=1,NS
+      HL=HL+RN(I,K)*CNF_MATERIAL_SENSIBLE_H(OLD%MATL_INDEX(K),REAL(IL,EB))
+      HH=HH+RN(I,K)*CNF_MATERIAL_SENSIBLE_H(OLD%MATL_INDEX(K),REAL(IH,EB))
+   ENDDO
