+      INTEGRAL=INTEGRAL+M%RHO(I,J,K)*G*M%DX(I)*M%DY(J)*M%DZ(K)
+   ENDDO ; ENDDO ; ENDDO
+CASE('THERMAL')
+   DO K=1,M%KBAR ; DO J=1,M%JBAR ; DO I=1,M%IBAR
+      R2=(M%XC(I)-XC0)**2+(M%YC(J)-YC0)**2+(M%ZC(K)-ZC0)**2
+      G=EXP(-0.5_EB*R2/SIG**2) ; M%TMP(I,J,K)=293.15_EB+G
+      ZZ_GET=M%ZZ(I,J,K,1:N_TRACKED_SPECIES)
+      CALL GET_SPECIFIC_GAS_CONSTANT(ZZ_GET,M%RSUM(I,J,K))
+      M%RHO(I,J,K)=M%P_0(K)/(M%TMP(I,J,K)*M%RSUM(I,J,K)) ; M%RHOS(I,J,K)=M%RHO(I,J,K)
+      INTEGRAL=INTEGRAL+M%RHO(I,J,K)*G*M%DX(I)*M%DY(J)*M%DZ(K)
+   ENDDO ; ENDDO ; ENDDO
+CASE('VORTEX')
+   ALLOCATE(AZ(0:M%IBAR,0:M%JBAR,1:M%KBAR),DU(0:M%IBAR,1:M%JBAR,1:M%KBAR),&
+            DV(1:M%IBAR,0:M%JBAR,1:M%KBAR))
+   DO K=1,M%KBAR ; DO J=0,M%JBAR ; DO I=0,M%IBAR
+      R2=(M%X(I)-XC0)**2+(M%Y(J)-YC0)**2+(M%ZC(K)-ZC0)**2
+      AZ(I,J,K)=EXP(-0.5_EB*R2/SIG**2)
+   ENDDO ; ENDDO ; ENDDO
+   DU=0._EB ; DV=0._EB
+   DO K=1,M%KBAR ; DO J=1,M%JBAR ; DO I=0,M%IBAR
+      DU(I,J,K)=(AZ(I,J,K)-AZ(I,J-1,K))*M%RDY(J)
+   ENDDO ; ENDDO ; ENDDO
+   DO K=1,M%KBAR ; DO J=0,M%JBAR ; DO I=1,M%IBAR
+      DV(I,J,K)=-(AZ(I,J,K)-AZ(I-1,J,K))*M%RDX(I)
+   ENDDO ; ENDDO ; ENDDO
+   MAX_SPEED=MAX(MAXVAL(ABS(DU)),MAXVAL(ABS(DV)))
+   IF (MAX_SPEED<=0._EB) THEN ; CALL SHUTDOWN('ERROR(UOBS): zero discrete-curl packet.') ; RETURN ; ENDIF
+   SCALE=0.005_EB/MAX_SPEED ; DU=DU*SCALE ; DV=DV*SCALE
