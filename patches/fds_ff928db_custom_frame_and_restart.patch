+      CALL SHUTDOWN('ERROR: CNF regrid enthalpy outside native table.',PROCESS_0_ONLY=.FALSE.); RETURN
+   ENDIF
+   DO WHILE(IH-IL>1)
+      IM=(IL+IH)/2; HS=0._EB
+      DO K=1,NS
