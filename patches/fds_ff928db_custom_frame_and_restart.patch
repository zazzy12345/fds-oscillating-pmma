+SUBROUTINE VERIFY_PHYSICAL_PRESSURE_GAUGE_CONFIGURATION(NM)
+
+USE COMP_FUNCTIONS, ONLY: SHUTDOWN
+USE MMSD_FUNCTIONS, ONLY: MMSD_ACTIVE
+USE GLOBAL_CONSTANTS, ONLY: BAROCLINIC,CC_IBM,CONNECTED_ZONES,CYLINDRICAL,FFT_FLAG,FISHPAK_BC,FISHPAK_BC_PERIODIC, &
+                            FREEZE_VELOCITY,N_GEOM,NMESHES,N_MPI_PROCESSES,N_MOVE,N_ZONE,OPEN_BOUNDARY, &
+                            PERIODIC_BOUNDARY,PERIODIC_TEST,PHYSICAL_PRESSURE_GAUGE,PHYSICAL_PRESSURE_GAUGE_READY,PRES_FLAG, &
+                            RESTART,TUNNEL_PRECONDITIONER,TWO_D
+
+INTEGER, INTENT(IN) :: NM
+
+IF (.NOT.PHYSICAL_PRESSURE_GAUGE) RETURN
+PHYSICAL_PRESSURE_GAUGE_READY = .FALSE.
+
+IF (PRES_FLAG/=FFT_FLAG) THEN
+   CALL SHUTDOWN('ERROR: PHYSICAL_PRESSURE_GAUGE requires the FFT pressure solver.') ; RETURN
+ENDIF
+IF (.NOT.BAROCLINIC) THEN
+   CALL SHUTDOWN('ERROR: PHYSICAL_PRESSURE_GAUGE requires BAROCLINIC=.TRUE.') ; RETURN
+ENDIF
+IF (NMESHES/=1 .OR. N_MPI_PROCESSES/=1) THEN
+   CALL SHUTDOWN('ERROR: PHYSICAL_PRESSURE_GAUGE v1 requires one mesh and one MPI rank.') ; RETURN
+ENDIF
+IF (.NOT.TWO_D .OR. CYLINDRICAL .OR. CC_IBM) THEN
+   CALL SHUTDOWN('ERROR: PHYSICAL_PRESSURE_GAUGE v1 requires a 2-D Cartesian non-CC domain.') ; RETURN
+ENDIF
+IF (TUNNEL_PRECONDITIONER .OR. PERIODIC_TEST==7 .OR. FREEZE_VELOCITY .OR. RESTART) THEN
+   CALL SHUTDOWN('ERROR: PHYSICAL_PRESSURE_GAUGE v1 excludes tunnel, MMS, frozen-velocity, and restart modes.') ; RETURN
+ENDIF
+! MMSD is permitted only through its explicit card and strict independent
+! scope audit; it never aliases the legacy PERIODIC_TEST manufactured path.
+IF (MMSD_ACTIVE .AND. PERIODIC_TEST/=0) THEN
+   CALL SHUTDOWN('ERROR: PHYSICAL_PRESSURE_GAUGE with MMSD requires PERIODIC_TEST=0.') ; RETURN
+ENDIF
+IF (ANY(FISHPAK_BC/=FISHPAK_BC_PERIODIC)) THEN
+   CALL SHUTDOWN('ERROR: PHYSICAL_PRESSURE_GAUGE v1 requires input FISHPAK_BC=0,0,0.') ; RETURN
+ENDIF
+IF (N_GEOM/=0 .OR. N_MOVE/=0) THEN
+   CALL SHUTDOWN('ERROR: PHYSICAL_PRESSURE_GAUGE v1 excludes GEOM, MOVE, and dynamic geometry.') ; RETURN
+ENDIF
+
+CALL POINT_TO_MESH(NM)
+
+IF (N_VENT>0 .AND. ANY(VENTS(1:N_VENT)%BOUNDARY_TYPE==OPEN_BOUNDARY)) THEN
+   CALL SHUTDOWN('ERROR: PHYSICAL_PRESSURE_GAUGE v1 excludes every OPEN vent.') ; RETURN
+ENDIF
+IF (N_ZONE/=1) THEN
+   CALL SHUTDOWN('ERROR: PHYSICAL_PRESSURE_GAUGE v1 requires exactly one gas pressure zone.') ; RETURN
+ENDIF
+IF (CONNECTED_ZONES(1,0)/=0) THEN
+   CALL SHUTDOWN('ERROR: PHYSICAL_PRESSURE_GAUGE v1 requires a gas pressure zone not connected to exterior.') ; RETURN
+ENDIF
+IF (N_VENT<1 .OR. ANY(VENTS(1:N_VENT)%BOUNDARY_TYPE/=PERIODIC_BOUNDARY .AND. &
+                           (ABS(VENTS(1:N_VENT)%IOR)==1 .OR. ABS(VENTS(1:N_VENT)%IOR)==3)) .OR. &
+    COUNT(VENTS(1:N_VENT)%IOR== 1)<1 .OR. COUNT(VENTS(1:N_VENT)%IOR==-1)<1 .OR. &
+    COUNT(VENTS(1:N_VENT)%IOR== 3)<1 .OR. COUNT(VENTS(1:N_VENT)%IOR==-3)<1) THEN
+   CALL SHUTDOWN('ERROR: PHYSICAL_PRESSURE_GAUGE v1 requires periodic vents on XMIN/XMAX/ZMIN/ZMAX.') ; RETURN
+ENDIF
+IF (N_OBST/=0 .OR. N_INTERNAL_WALL_CELLS/=0 .OR. N_INTERNAL_CFACE_CELLS/=0) THEN
+   CALL SHUTDOWN('ERROR: PHYSICAL_PRESSURE_GAUGE v1 requires an empty box without OBST, walls, or CFACEs.') ; RETURN
+ENDIF
+IF (LBC/=FISHPAK_BC_PERIODIC .OR. MBC/=FISHPAK_BC_PERIODIC .OR. NBC/=FISHPAK_BC_PERIODIC) THEN
+   CALL SHUTDOWN('ERROR: PHYSICAL_PRESSURE_GAUGE v1 requires effective periodic FFT BCs on all axes.') ; RETURN
+ENDIF
+
+PHYSICAL_PRESSURE_GAUGE_READY = .TRUE.
+
+END SUBROUTINE VERIFY_PHYSICAL_PRESSURE_GAUGE_CONFIGURATION
+
+
+!> \brief Select a physical perturbation-pressure gauge for the explicit periodic FFT verification domain.
+!> \details The low-Mach pressure potential is H=KRES+p'/rho. For a singular
+!> FFT Poisson problem, H is only defined to an additive constant. This routine
+!> selects that constant so that the volume integral of p'=rho*(H-KRES) is zero.
+!> It is intentionally limited to one, two-dimensional, Cartesian, fully
+!> periodic pressure domain with exactly one automatically connected gas
+!> pressure zone that is not connected to exterior zone 0, no CC-IBM, tunnel
+!> preconditioner, or manufactured-solution override. Later verification must
+!> separately extend this scope to Neumann and multi-mesh pressure zones.
+
+SUBROUTINE APPLY_PHYSICAL_PRESSURE_GAUGE(NM,USE_ESTIMATED_STATE)
+
+USE GLOBAL_CONSTANTS, ONLY: BAROCLINIC,CC_IBM,CONNECTED_ZONES,CYLINDRICAL,FFT_FLAG,FISHPAK_BC_PERIODIC,LU_OUTPUT,MY_RANK, &
+                            N_GEOM,NMESHES,N_MPI_PROCESSES,N_MOVE,N_ZONE,OPEN_BOUNDARY,OUT_FILE_OPENED,PERIODIC_TEST, &
+                            PERIODIC_BOUNDARY,PHYSICAL_PRESSURE_GAUGE,PHYSICAL_PRESSURE_GAUGE_READY,PREDICTOR,PRES_FLAG, &
+                            TUNNEL_PRECONDITIONER,TWENTY_EPSILON_EB,TWO_D
+
+INTEGER, INTENT(IN) :: NM
+LOGICAL, INTENT(IN), OPTIONAL :: USE_ESTIMATED_STATE
+LOGICAL :: USE_ESTIMATED
+INTEGER :: I,J,K
+REAL(EB) :: NUMERATOR,DENOMINATOR,SHIFT_H,VOL
+REAL(EB), POINTER, DIMENSION(:,:,:) :: HP,RHOP
+
+IF (.NOT.PHYSICAL_PRESSURE_GAUGE .OR. .NOT.PHYSICAL_PRESSURE_GAUGE_READY) RETURN
+IF (.NOT.BAROCLINIC .OR. CYLINDRICAL .OR. CC_IBM) RETURN
+! FDS creates one connected pressure zone for a one-mesh periodic gas domain;
+! zero here is only the pre-connectivity input count and would disable this path.
+IF (PRES_FLAG/=FFT_FLAG .OR. NMESHES/=1 .OR. N_MPI_PROCESSES/=1 .OR. N_ZONE/=1) RETURN
+IF (.NOT.TWO_D .OR. TUNNEL_PRECONDITIONER .OR. PERIODIC_TEST==7 .OR. N_GEOM/=0 .OR. N_MOVE/=0) RETURN
+
+CALL POINT_TO_MESH(NM)
+
+IF (N_VENT>0 .AND. ANY(VENTS(1:N_VENT)%BOUNDARY_TYPE==OPEN_BOUNDARY)) RETURN
+IF (CONNECTED_ZONES(1,0)/=0) RETURN
+IF (N_VENT<1 .OR. ANY(VENTS(1:N_VENT)%BOUNDARY_TYPE/=PERIODIC_BOUNDARY .AND. &
+                           (ABS(VENTS(1:N_VENT)%IOR)==1 .OR. ABS(VENTS(1:N_VENT)%IOR)==3)) .OR. &
+    COUNT(VENTS(1:N_VENT)%IOR== 1)<1 .OR. COUNT(VENTS(1:N_VENT)%IOR==-1)<1 .OR. &
+    COUNT(VENTS(1:N_VENT)%IOR== 3)<1 .OR. COUNT(VENTS(1:N_VENT)%IOR==-3)<1) RETURN
+IF (N_OBST/=0 .OR. N_INTERNAL_WALL_CELLS/=0 .OR. N_INTERNAL_CFACE_CELLS/=0) RETURN
+IF (LBC/=FISHPAK_BC_PERIODIC .OR. MBC/=FISHPAK_BC_PERIODIC .OR. NBC/=FISHPAK_BC_PERIODIC) RETURN
+
+USE_ESTIMATED = .NOT.PREDICTOR
+IF (PRESENT(USE_ESTIMATED_STATE)) USE_ESTIMATED = USE_ESTIMATED_STATE
+
+IF (.NOT.USE_ESTIMATED) THEN
+   HP   => H
+   RHOP => RHO
+ELSE
+   HP   => HS
+   RHOP => RHOS
+ENDIF
+
+NUMERATOR = 0._EB
+DENOMINATOR = 0._EB
+
+!$OMP PARALLEL DO PRIVATE(VOL) REDUCTION(+:NUMERATOR,DENOMINATOR) SCHEDULE(STATIC)
+DO K=1,KBAR
+   DO J=1,JBAR
+      DO I=1,IBAR
+         IF (CELL(CELL_INDEX(I,J,K))%SOLID) CYCLE
+         VOL = DX(I)*DY(J)*DZ(K)
+         NUMERATOR = NUMERATOR + VOL*RHOP(I,J,K)*(KRES(I,J,K)-HP(I,J,K))
+         DENOMINATOR = DENOMINATOR + VOL*RHOP(I,J,K)
+      ENDDO
+   ENDDO
+ENDDO
+!$OMP END PARALLEL DO
+
+SHIFT_H = NUMERATOR/(DENOMINATOR+TWENTY_EPSILON_EB)
+
+! Shift ghost cells as well as interior cells.  For a fully periodic pressure
+! solve this preserves both the solution gradients and the periodic ghost
+! relations established by PRESSURE_SOLVER_FFT.
+
+!$OMP PARALLEL DO SCHEDULE(STATIC)
+DO K=0,KBP1
+   DO J=0,JBP1
+      DO I=0,IBP1
+         HP(I,J,K) = HP(I,J,K) + SHIFT_H
+      ENDDO
+   ENDDO
+ENDDO
+!$OMP END PARALLEL DO
+
+IF (FIRST_PHYSICAL_PRESSURE_GAUGE_CALL .AND. OUT_FILE_OPENED .AND. MY_RANK==0) THEN
+   WRITE(LU_OUTPUT,'(A)') ' Physical-pressure gauge enabled by &PRES: FFT, 1 mesh, 1 MPI rank, 2-D, fully periodic empty box.'
+   WRITE(LU_OUTPUT,'(A)') '   Gauge condition: integral rho*(H-KRES) dV = 0.'
+   WRITE(LU_OUTPUT,'(A,3(I0,1X))') '   Effective FFT BC codes (L,M,N): ',LBC,MBC,NBC
+   FIRST_PHYSICAL_PRESSURE_GAUGE_CALL = .FALSE.
+ENDIF
+
+END SUBROUTINE APPLY_PHYSICAL_PRESSURE_GAUGE
 
 
