+CHARACTER(LEN=16384) FUNCTION G1EQ_HEAD(KIND,T,DT,NM)
+USE FRAME_FUNCTIONS, ONLY: GET_FRAME_KINEMATICS,GET_FRAME_OPEN_TARGET
+
+CHARACTER(LEN=*), INTENT(IN) :: KIND
+REAL(EB), INTENT(IN) :: T,DT
+INTEGER, INTENT(IN) :: NM
+CHARACTER(LEN=64) :: SEGMENT,PARENT,MANIFEST
+CHARACTER(LEN=256) :: EVENT_KEY
+REAL(EB) :: TAU_MP,X_FRAME(3),U_FRAME_LOCAL(3),A_FRAME(3),OPEN_TARGET(3)
+
+CALL G1EQ_GET_IDS(SEGMENT,PARENT,MANIFEST)
+G1EQ_EVENT_ORDINAL=G1EQ_EVENT_ORDINAL+1
+TAU_MP=512._EB*EPSILON(1._EB)
+G1EQ_HEAD='G1_OPEN_FORMULATION_R2 schema=g1-open-formulation-r2-source-v1'
+CALL G1EQ_ADD_TEXT(G1EQ_HEAD,'upstream','ff928dbf68a2623ced3a007be75391c6dc6c9f90')
+CALL G1EQ_ADD_TEXT(G1EQ_HEAD,'formal_r2_diff', &
+   'e8614da59f051ad72c2119c856d8ea4ae9983e542494c43fa2dc0d335732e7eb')
+CALL G1EQ_ADD_TEXT(G1EQ_HEAD,'kind',KIND)
+CALL G1EQ_ADD_TEXT(G1EQ_HEAD,'segment_id',SEGMENT)
+CALL G1EQ_ADD_TEXT(G1EQ_HEAD,'parent_segment_id',PARENT)
+CALL G1EQ_ADD_TEXT(G1EQ_HEAD,'restart_set_manifest_sha256',MANIFEST)
+CALL G1EQ_ADD_TEXT(G1EQ_HEAD,'chid',CHID)
+CALL G1EQ_ADD_INT(G1EQ_HEAD,'rank',MY_RANK)
+CALL G1EQ_ADD_INT(G1EQ_HEAD,'mesh',NM)
+CALL G1EQ_ADD_INT(G1EQ_HEAD,'segment_event_ordinal',G1EQ_EVENT_ORDINAL)
+EVENT_KEY=SEGMENT//':'//TRIM(DEV159_INT(MY_RANK))//':'//TRIM(DEV159_INT(NM))//':'// &
+          TRIM(DEV159_INT(G1EQ_EVENT_ORDINAL))
+CALL G1EQ_ADD_TEXT(G1EQ_HEAD,'event_key',EVENT_KEY)
+CALL G1EQ_ADD_INT(G1EQ_HEAD,'icyc',ICYC)
+CALL G1EQ_ADD_INT(G1EQ_HEAD,'attempt',G1EQ_ATTEMPT_ORDINAL)
+CALL G1EQ_ADD_TEXT(G1EQ_HEAD,'attempt_disposition',G1EQ_ATTEMPT_DISPOSITION)
+CALL G1EQ_ADD_LOGICAL(G1EQ_HEAD,'attempt_accepted',G1EQ_ATTEMPT_DISPOSITION=='accepted')
+CALL G1EQ_ADD_INT(G1EQ_HEAD,'pressure_iteration',PRESSURE_ITERATIONS)
+CALL G1EQ_ADD_LOGICAL(G1EQ_HEAD,'predictor',PREDICTOR)
+CALL G1EQ_ADD_LOGICAL(G1EQ_HEAD,'restart',RESTART)
+CALL G1EQ_ADD_REAL(G1EQ_HEAD,'t',T)
+CALL G1EQ_ADD_REAL(G1EQ_HEAD,'dt',DT)
+CALL G1EQ_ADD_REAL(G1EQ_HEAD,'tau_mp',TAU_MP)
+CALL GET_FRAME_KINEMATICS(T,X_FRAME,U_FRAME_LOCAL,A_FRAME)
+CALL GET_FRAME_OPEN_TARGET(T,OPEN_TARGET)
+CALL G1EQ_ADD_VEC3(G1EQ_HEAD,'lab_velocity',TF_LAB_VELOCITY)
+CALL G1EQ_ADD_VEC3(G1EQ_HEAD,'frame_velocity',U_FRAME_LOCAL)
+CALL G1EQ_ADD_VEC3(G1EQ_HEAD,'open_target',OPEN_TARGET)
+CALL G1EQ_ADD_LOGICAL(G1EQ_HEAD,'restart_lineage_loaded',G1EQ_RESTART_LINEAGE_VALID)
+IF (G1EQ_RESTART_LINEAGE_VALID) THEN
+   CALL G1EQ_ADD_TEXT(G1EQ_HEAD,'loaded_restart_chid',G1EQ_LOADED_RESTART_CHID)
+   CALL G1EQ_ADD_TEXT(G1EQ_HEAD,'loaded_restart_file',G1EQ_LOADED_RESTART_FILE)
+   CALL G1EQ_ADD_REAL(G1EQ_HEAD,'loaded_t',G1EQ_LOADED_T)
+   CALL G1EQ_ADD_REAL(G1EQ_HEAD,'loaded_stime',G1EQ_LOADED_STIME)
+   CALL G1EQ_ADD_REAL(G1EQ_HEAD,'loaded_dt',G1EQ_LOADED_DT)
+   CALL G1EQ_ADD_INT(G1EQ_HEAD,'loaded_icyc',G1EQ_LOADED_ICYC)
+ENDIF
+
+END FUNCTION G1EQ_HEAD
