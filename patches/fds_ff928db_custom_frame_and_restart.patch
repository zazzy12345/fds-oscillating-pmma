+LOGICAL FUNCTION G1EQ_ACTIVE(NM)
+
+INTEGER, INTENT(IN) :: NM
+CHARACTER(LEN=16) :: FLAG,OMP_THREADS
+CHARACTER(LEN=64) :: SEGMENT,PARENT,MANIFEST
+INTEGER :: LENGTH_VALUE,STATUS_VALUE
+
+G1EQ_ACTIVE=.FALSE.
+CALL GET_ENVIRONMENT_VARIABLE('FDS_G1_OPEN_FORMULATION_R2',FLAG,LENGTH=LENGTH_VALUE,STATUS=STATUS_VALUE)
+IF (STATUS_VALUE/=0 .OR. LENGTH_VALUE/=1 .OR. FLAG(1:1)/='1') RETURN
+CALL GET_ENVIRONMENT_VARIABLE('OMP_NUM_THREADS',OMP_THREADS,LENGTH=LENGTH_VALUE,STATUS=STATUS_VALUE)
+IF (STATUS_VALUE/=0 .OR. LENGTH_VALUE/=1 .OR. OMP_THREADS(1:1)/='1') RETURN
+CALL GET_ENVIRONMENT_VARIABLE('FDS_G1_SEGMENT_ID',SEGMENT,LENGTH=LENGTH_VALUE,STATUS=STATUS_VALUE)
+IF (STATUS_VALUE/=0 .OR. LENGTH_VALUE/=64) RETURN
+IF (.NOT.G1EQ_IS_HEX64(SEGMENT,.FALSE.)) RETURN
+CALL GET_ENVIRONMENT_VARIABLE('FDS_G1_PARENT_SEGMENT_ID',PARENT,LENGTH=LENGTH_VALUE,STATUS=STATUS_VALUE)
+IF (STATUS_VALUE/=0 .OR. LENGTH_VALUE/=64) RETURN
+IF (.NOT.G1EQ_IS_HEX64(PARENT,.TRUE.)) RETURN
+CALL GET_ENVIRONMENT_VARIABLE('FDS_G1_RESTART_SET_MANIFEST_SHA256',MANIFEST, &
+                              LENGTH=LENGTH_VALUE,STATUS=STATUS_VALUE)
+IF (STATUS_VALUE/=0 .OR. LENGTH_VALUE/=64) RETURN
+IF (.NOT.G1EQ_IS_HEX64(MANIFEST,.TRUE.)) RETURN
+IF (RESTART) THEN
+   IF (PARENT==REPEAT('0',64) .OR. MANIFEST==REPEAT('0',64)) RETURN
+ELSE
+   IF (PARENT/=REPEAT('0',64) .OR. MANIFEST/=REPEAT('0',64)) RETURN
+ENDIF
+IF (NM/=1 .OR. MY_RANK/=0 .OR. N_MPI_PROCESSES/=1 .OR. NMESHES/=1) RETURN
+IF (PRES_FLAG/=FFT_FLAG .OR. TWO_D .OR. CYLINDRICAL .OR. CC_IBM) RETURN
+IF (.NOT.TRANSLATING_FRAME .OR. .NOT.OPEN_WIND_BOUNDARY) RETURN
+IF (.NOT.TF_APPLY_TO_OPEN_BOUNDARIES) RETURN
+G1EQ_ACTIVE=.TRUE.
+
+END FUNCTION G1EQ_ACTIVE
+
