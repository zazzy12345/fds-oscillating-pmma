+! G1 OPEN formulation-r2: behavior-neutral, direct-program-point evidence trace.
+LOGICAL FUNCTION G1EQ_IS_HEX64(VALUE,ALLOW_ZERO)
+
+CHARACTER(LEN=*), INTENT(IN) :: VALUE
+LOGICAL, INTENT(IN) :: ALLOW_ZERO
+INTEGER :: I
+
+G1EQ_IS_HEX64=.FALSE.
+IF (LEN(VALUE)/=64) RETURN
+DO I=1,64
+   IF (INDEX('0123456789abcdef',VALUE(I:I))==0) RETURN
+ENDDO
+IF (.NOT.ALLOW_ZERO .AND. VALUE==REPEAT('0',64)) RETURN
+G1EQ_IS_HEX64=.TRUE.
+
+END FUNCTION G1EQ_IS_HEX64
+
