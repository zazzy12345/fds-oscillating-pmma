+SUBROUTINE G1EQ_PRESSURE_BC(NM,IW,T_OPEN,DT,P_EXT,RHO_F,H0,SOURCE_UN,OUTFLOW, &
+                            RAMP_INDEX,RAMP_VALUE,P_RAW,EDDY)
+
+INTEGER, INTENT(IN) :: NM,IW,RAMP_INDEX
+REAL(EB), INTENT(IN) :: T_OPEN,DT,P_EXT,RHO_F,H0,SOURCE_UN,RAMP_VALUE,P_RAW,EDDY
+LOGICAL, INTENT(IN) :: OUTFLOW
+INTEGER :: I,J,K,IOR
+REAL(EB) :: HI,HG,RN,KRI,BV,TARGET
+CHARACTER(LEN=16384) :: LINE
+TYPE(WALL_TYPE), POINTER :: WC
+TYPE(BOUNDARY_COORD_TYPE), POINTER :: BC
+
+IF (.NOT.G1EQ_ACTIVE(NM)) RETURN
+IF (.NOT.G1EQ_PRESSURE_VALID .OR. .NOT.ALLOCATED(G1EQ_FACE_STATE)) RETURN
+IF (IW<1 .OR. IW>SIZE(G1EQ_FACE_STATE)) RETURN
+WC=>WALL(IW)
+BC=>BOUNDARY_COORD(WC%BC_INDEX)
+I=BC%II
+J=BC%JJ
+K=BC%KK
+IOR=BC%IOR
+IF (G1EQ_PRESSURE_PREDICTOR) THEN
+   CALL G1EQ_FACE_SAMPLE(IOR,I,J,K,H,HI,HG,RN)
+ELSE
+   CALL G1EQ_FACE_SAMPLE(IOR,I,J,K,HS,HI,HG,RN)
+ENDIF
+SELECT CASE(IOR)
+   CASE(1)
+      BV=BXS(J,K)
+      KRI=KRES(1,J,K)
+   CASE(-1)
+      BV=BXF(J,K)
+      KRI=KRES(IBAR,J,K)
+   CASE(2)
+      BV=BYS(I,K)
+      KRI=KRES(I,1,K)
+   CASE(-2)
+      BV=BYF(I,K)
+      KRI=KRES(I,JBAR,K)
+   CASE(3)
+      BV=BZS(I,J)
+      KRI=KRES(I,J,1)
+   CASE(-3)
+      BV=BZF(I,J)
+      KRI=KRES(I,J,KBAR)
+END SELECT
+TARGET=MERGE(KRI,H0,OUTFLOW)
+G1EQ_FACE_STATE(IW)%BRANCH=MERGE(2,1,OUTFLOW)
+G1EQ_FACE_STATE(IW)%PRESSURE_IOR=IOR
+G1EQ_FACE_STATE(IW)%HI_OLD=HI
+G1EQ_FACE_STATE(IW)%HG_OLD=HG
+G1EQ_FACE_STATE(IW)%PHI=P_EXT/RHO_F
+G1EQ_FACE_STATE(IW)%TARGET=TARGET
+G1EQ_FACE_STATE(IW)%BVALUE=BV
+G1EQ_FACE_STATE(IW)%SOURCE_UN=SOURCE_UN
+G1EQ_FACE_STATE(IW)%KRES_I=KRI
+G1EQ_FACE_STATE(IW)%P_EXT=P_EXT
+G1EQ_FACE_STATE(IW)%RHO_EXT=RHO_F
+G1EQ_FACE_STATE(IW)%RN=RN
+LINE=G1EQ_HEAD('pressure_open_assignment',T_OPEN,DT,NM)
+CALL G1EQ_ADD_INT(LINE,'iw',IW)
+CALL G1EQ_ADD_INT(LINE,'ior',IOR)
+CALL G1EQ_ADD_INT(LINE,'i',I)
+CALL G1EQ_ADD_INT(LINE,'j',J)
+CALL G1EQ_ADD_INT(LINE,'k',K)
+CALL G1EQ_ADD_TEXT(LINE,'branch',MERGE('outflow','inflow ',OUTFLOW))
+CALL G1EQ_ADD_REAL(LINE,'source_un',SOURCE_UN)
+CALL G1EQ_ADD_TEXT(LINE,'array_family',MERGE('H ','HS',G1EQ_PRESSURE_PREDICTOR))
+CALL G1EQ_ADD_REAL(LINE,'h_i_old',HI)
+CALL G1EQ_ADD_REAL(LINE,'h_g_old',HG)
+CALL G1EQ_ADD_REAL(LINE,'h0',H0)
+CALL G1EQ_ADD_REAL(LINE,'target',TARGET)
+CALL G1EQ_ADD_REAL(LINE,'phi',G1EQ_FACE_STATE(IW)%PHI)
+CALL G1EQ_ADD_REAL(LINE,'p_external',P_EXT)
+CALL G1EQ_ADD_REAL(LINE,'rho_external',RHO_F)
+CALL G1EQ_ADD_REAL(LINE,'kres_i',KRI)
+CALL G1EQ_ADD_REAL(LINE,'b_value',BV)
+CALL G1EQ_ADD_INT(LINE,'ramp_index',RAMP_INDEX)
+CALL G1EQ_ADD_REAL(LINE,'ramp_value',RAMP_VALUE)
+CALL G1EQ_ADD_REAL(LINE,'raw_dynamic_pressure',P_RAW)
+CALL G1EQ_ADD_REAL(LINE,'vel_eddy',EDDY)
+CALL G1EQ_ADD_INT(LINE,'wall_work1_applied',0)
+WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+
+END SUBROUTINE G1EQ_PRESSURE_BC
+
+
+SUBROUTINE G1EQ_PRESSURE_RETURN(NM,HP)
+
+INTEGER, INTENT(IN) :: NM
+REAL(EB), INTENT(IN) :: HP(0:,0:,0:)
+INTEGER :: IW,I,J,K,IOR
+REAL(EB) :: HI,HG,RN,O_RES,GHOST_RES,B_RES,GRAD_DIRECT,GRAD_RECON,GRAD_RES
+CHARACTER(LEN=16384) :: LINE
+TYPE(WALL_TYPE), POINTER :: WC
+TYPE(BOUNDARY_COORD_TYPE), POINTER :: BC
+
+IF (.NOT.G1EQ_ACTIVE(NM)) RETURN
+IF (.NOT.G1EQ_PRESSURE_VALID .OR. .NOT.ALLOCATED(G1EQ_FACE_STATE)) RETURN
+DO IW=1,N_EXTERNAL_WALL_CELLS
+   IF (G1EQ_FACE_STATE(IW)%BRANCH==0) CYCLE
+   WC=>WALL(IW)
+   BC=>BOUNDARY_COORD(WC%BC_INDEX)
+   I=BC%II
+   J=BC%JJ
+   K=BC%KK
+   IOR=BC%IOR
+   CALL G1EQ_FACE_SAMPLE(IOR,I,J,K,HP,HI,HG,RN)
+   O_RES=0.5_EB*(HG+HI)-G1EQ_FACE_STATE(IW)%PHI-G1EQ_FACE_STATE(IW)%TARGET
+   GHOST_RES=HG-(-HI+2._EB*G1EQ_FACE_STATE(IW)%BVALUE)
+   B_RES=0.5_EB*(HG+HI)-G1EQ_FACE_STATE(IW)%BVALUE
+   GRAD_DIRECT=RN*(HI-HG)
+   GRAD_RECON=2._EB*RN*(HI-G1EQ_FACE_STATE(IW)%BVALUE)
+   GRAD_RES=GRAD_DIRECT-GRAD_RECON
+   G1EQ_FACE_STATE(IW)%RN=RN
+   LINE=G1EQ_HEAD('pressure_direct_return',G1EQ_PRESSURE_T,G1EQ_PRESSURE_DT,NM)
+   CALL G1EQ_ADD_INT(LINE,'iw',IW)
+   CALL G1EQ_ADD_INT(LINE,'ior',IOR)
+   CALL G1EQ_ADD_TEXT(LINE,'array_family',MERGE('H ','HS',G1EQ_PRESSURE_PREDICTOR))
+   CALL G1EQ_ADD_REAL(LINE,'h_i_old',G1EQ_FACE_STATE(IW)%HI_OLD)
+   CALL G1EQ_ADD_REAL(LINE,'h_g_old',G1EQ_FACE_STATE(IW)%HG_OLD)
+   CALL G1EQ_ADD_REAL(LINE,'h_i_new',HI)
+   CALL G1EQ_ADD_REAL(LINE,'h_g_new',HG)
+   CALL G1EQ_ADD_REAL(LINE,'b_value',G1EQ_FACE_STATE(IW)%BVALUE)
+   CALL G1EQ_ADD_REAL(LINE,'kres_i',G1EQ_FACE_STATE(IW)%KRES_I)
+   CALL G1EQ_ADD_REAL(LINE,'phi',G1EQ_FACE_STATE(IW)%PHI)
+   CALL G1EQ_ADD_REAL(LINE,'r_n',RN)
+   CALL G1EQ_ADD_REAL(LINE,'ghost_residual',GHOST_RES)
+   CALL G1EQ_ADD_REAL(LINE,'b_residual',B_RES)
+   CALL G1EQ_ADD_REAL(LINE,'direct_gradient_n',GRAD_DIRECT)
+   CALL G1EQ_ADD_REAL(LINE,'reconstructed_gradient_n',GRAD_RECON)
+   CALL G1EQ_ADD_REAL(LINE,'gradient_residual',GRAD_RES)
+   CALL G1EQ_ADD_REAL(LINE,'o_residual',O_RES)
+   WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+ENDDO
+
+END SUBROUTINE G1EQ_PRESSURE_RETURN
+
+
+SUBROUTINE G1EQ_CATEGORICAL_FAILURE(KIND,T,DT,NM,IW,REASON)
+
+CHARACTER(LEN=*), INTENT(IN) :: KIND,REASON
+REAL(EB), INTENT(IN) :: T,DT
+INTEGER, INTENT(IN) :: NM,IW
+CHARACTER(LEN=16384) :: LINE
+
+IF (.NOT.G1EQ_ACTIVE(NM)) RETURN
+LINE=G1EQ_HEAD(KIND,T,DT,NM)
+CALL G1EQ_ADD_INT(LINE,'iw',IW)
+CALL G1EQ_ADD_LOGICAL(LINE,'join_valid',.FALSE.)
+CALL G1EQ_ADD_TEXT(LINE,'categorical_failure',REASON)
+WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+
+END SUBROUTINE G1EQ_CATEGORICAL_FAILURE
+
+
+SUBROUTINE G1EQ_FLUX_OBSERVE(PHASE,T,DT,NM,ESTIMATED,A_FRAME)
+
+USE FRAME_FUNCTIONS, ONLY: GET_FRAME_KINEMATICS
+CHARACTER(LEN=*), INTENT(IN) :: PHASE
+REAL(EB), INTENT(IN) :: T,DT,A_FRAME(3)
+INTEGER, INTENT(IN) :: NM
+LOGICAL, INTENT(IN) :: ESTIMATED
+INTEGER :: IW,I,J,K,IOR,Q
+REAL(EB) :: FVN,AFN,X_FRAME(3),U_FRAME(3),A_FRAME_ORACLE(3)
+LOGICAL :: CAPTURE_READY
+CHARACTER(LEN=16384) :: LINE
+TYPE(WALL_TYPE), POINTER :: WC
+TYPE(BOUNDARY_COORD_TYPE), POINTER :: BC
+
+IF (.NOT.G1EQ_ACTIVE(NM)) RETURN
+CALL G1EQ_STORAGE(NM)
+IF (.NOT.ALLOCATED(G1EQ_FACE_STATE)) RETURN
+SELECT CASE(PHASE)
+   CASE('pre_frame')
+      G1EQ_T_FLUX=T
+      G1EQ_DT_FLUX=DT
+      G1EQ_FLUX_ICYC=ICYC
+      G1EQ_FLUX_ATTEMPT=G1EQ_ATTEMPT_ORDINAL
+      G1EQ_FLUX_NM=NM
+      G1EQ_FLUX_ESTIMATED=ESTIMATED
+      G1EQ_FLUX_STAGE_OPEN=.TRUE.
+      G1EQ_FACE_STATE%FLUX_VALID=.FALSE.
+      G1EQ_FACE_STATE%HOOKS_VALID=.FALSE.
+      G1EQ_FACE_STATE%UPDATE_JOIN_VALID=.FALSE.
+      G1EQ_FACE_STATE%FLUX_IOR=0
+   CASE('post_frame')
+      CAPTURE_READY=G1EQ_FLUX_STAGE_OPEN
+      CAPTURE_READY=CAPTURE_READY .AND. G1EQ_FLUX_NM==NM
+      CAPTURE_READY=CAPTURE_READY .AND. G1EQ_FLUX_ICYC==ICYC
+      CAPTURE_READY=CAPTURE_READY .AND. G1EQ_FLUX_ATTEMPT==G1EQ_ATTEMPT_ORDINAL
+      CAPTURE_READY=CAPTURE_READY .AND. (G1EQ_FLUX_ESTIMATED .EQV. ESTIMATED)
+      CAPTURE_READY=CAPTURE_READY .AND. DEV159_BITS(G1EQ_T_FLUX)==DEV159_BITS(T)
+      CAPTURE_READY=CAPTURE_READY .AND. DEV159_BITS(G1EQ_DT_FLUX)==DEV159_BITS(DT)
+      IF (.NOT.CAPTURE_READY) THEN
+         CALL G1EQ_CATEGORICAL_FAILURE('frame_capture_failure',T,DT,NM,0,'pre_post_stage_mismatch')
+         G1EQ_FLUX_STAGE_OPEN=.FALSE.
+         RETURN
+      ENDIF
+   CASE('hooks_final')
+      CONTINUE
+   CASE DEFAULT
+      CALL G1EQ_CATEGORICAL_FAILURE('frame_capture_failure',T,DT,NM,0,'unknown_capture_phase')
+      RETURN
+END SELECT
+CALL GET_FRAME_KINEMATICS(T,X_FRAME,U_FRAME,A_FRAME_ORACLE)
+DO IW=1,N_EXTERNAL_WALL_CELLS
+   WC=>WALL(IW)
+   IF (WC%BOUNDARY_TYPE/=OPEN_BOUNDARY) CYCLE
+   BC=>BOUNDARY_COORD(WC%BC_INDEX)
+   I=BC%II
+   J=BC%JJ
+   K=BC%KK
+   IOR=BC%IOR
+   Q=ABS(IOR)
+   FVN=G1EQ_FVN(IOR,I,J,K)
+   AFN=SIGN(1._EB,REAL(IOR,EB))*A_FRAME(Q)
+   SELECT CASE(PHASE)
+      CASE('pre_frame')
+         G1EQ_FACE_STATE(IW)%FV_PRE=FVN
+         G1EQ_FACE_STATE(IW)%FLUX_IOR=IOR
+      CASE('post_frame')
+         IF (G1EQ_FACE_STATE(IW)%FLUX_IOR/=IOR) THEN
+            CALL G1EQ_CATEGORICAL_FAILURE('frame_capture_failure',T,DT,NM,IW,'face_ior_mismatch')
+            CYCLE
+         ENDIF
+         G1EQ_FACE_STATE(IW)%FV_POST=FVN
+         G1EQ_FACE_STATE(IW)%FRAME_DELTA_N=FVN-G1EQ_FACE_STATE(IW)%FV_PRE
+         G1EQ_FACE_STATE(IW)%A_FRAME_FLUX_N=AFN
+         G1EQ_FACE_STATE(IW)%FLUX_VALID=.TRUE.
+      CASE('hooks_final')
+         IF (.NOT.G1EQ_FACE_STATE(IW)%FLUX_VALID) CYCLE
+         G1EQ_FACE_STATE(IW)%FV_HOOKS=FVN
+         G1EQ_FACE_STATE(IW)%HOOKS_VALID=.TRUE.
+   END SELECT
+   LINE=G1EQ_HEAD('frame_flux_capture',T,DT,NM)
+   CALL G1EQ_ADD_TEXT(LINE,'capture_phase',PHASE)
+   CALL G1EQ_ADD_INT(LINE,'iw',IW)
+   CALL G1EQ_ADD_INT(LINE,'ior',IOR)
+   CALL G1EQ_ADD_LOGICAL(LINE,'estimated',ESTIMATED)
+   CALL G1EQ_ADD_REAL(LINE,'t_flux',G1EQ_T_FLUX)
+   CALL G1EQ_ADD_REAL(LINE,'dt_flux',G1EQ_DT_FLUX)
+   CALL G1EQ_ADD_INT(LINE,'flux_icyc',G1EQ_FLUX_ICYC)
+   CALL G1EQ_ADD_INT(LINE,'flux_attempt',G1EQ_FLUX_ATTEMPT)
+   CALL G1EQ_ADD_REAL(LINE,'fv_n',FVN)
+   CALL G1EQ_ADD_REAL(LINE,'a_frame_flux_n',AFN)
+   CALL G1EQ_ADD_VEC3(LINE,'x_frame',X_FRAME)
+   CALL G1EQ_ADD_VEC3(LINE,'u_frame',U_FRAME)
+   CALL G1EQ_ADD_VEC3(LINE,'a_frame_oracle',A_FRAME_ORACLE)
+   IF (PHASE/='pre_frame') THEN
+      CALL G1EQ_ADD_REAL(LINE,'fv_pre_frame',G1EQ_FACE_STATE(IW)%FV_PRE)
+      CALL G1EQ_ADD_REAL(LINE,'fv_post_frame',G1EQ_FACE_STATE(IW)%FV_POST)
+      CALL G1EQ_ADD_REAL(LINE,'frame_delta_n',G1EQ_FACE_STATE(IW)%FRAME_DELTA_N)
+   ENDIF
+   WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+ENDDO
+IF (PHASE=='post_frame') G1EQ_FLUX_STAGE_OPEN=.FALSE.
+
+END SUBROUTINE G1EQ_FLUX_OBSERVE
+
+
+SUBROUTINE G1EQ_UPDATE_JOIN_STATUS(IW,IOR,NM,DT,EXPECTED_ESTIMATED,VALID,REASON)
+
+INTEGER, INTENT(IN) :: IW,IOR,NM
+REAL(EB), INTENT(IN) :: DT
+LOGICAL, INTENT(IN) :: EXPECTED_ESTIMATED
+LOGICAL, INTENT(OUT) :: VALID
+CHARACTER(LEN=*), INTENT(OUT) :: REASON
+
+VALID=.FALSE.
+REASON='unknown'
+IF (.NOT.ALLOCATED(G1EQ_FACE_STATE)) THEN
+   REASON='snapshot_storage_missing'
+   RETURN
+ENDIF
+IF (IW<1 .OR. IW>SIZE(G1EQ_FACE_STATE)) THEN
+   REASON='snapshot_face_missing'
+   RETURN
+ENDIF
+IF (.NOT.G1EQ_FACE_STATE(IW)%FLUX_VALID) THEN
+   REASON='snapshot_invalid_or_consumed'
+   RETURN
+ENDIF
+IF (.NOT.G1EQ_FACE_STATE(IW)%HOOKS_VALID) THEN
+   REASON='final_hooks_snapshot_missing'
+   RETURN
+ENDIF
+IF (G1EQ_FACE_STATE(IW)%UPDATE_JOIN_VALID) THEN
+   REASON='snapshot_already_joined'
+   RETURN
+ENDIF
+IF (G1EQ_FLUX_NM/=NM) THEN
+   REASON='mesh_mismatch'
+   RETURN
+ENDIF
+IF (G1EQ_FLUX_ICYC/=ICYC) THEN
+   REASON='icyc_mismatch'
+   RETURN
+ENDIF
+IF (G1EQ_FLUX_ATTEMPT/=G1EQ_ATTEMPT_ORDINAL) THEN
+   REASON='attempt_mismatch'
+   RETURN
+ENDIF
+IF (DEV159_BITS(G1EQ_DT_FLUX)/=DEV159_BITS(DT)) THEN
+   REASON='dt_bits_mismatch'
+   RETURN
+ENDIF
+IF (G1EQ_FLUX_ESTIMATED .NEQV. EXPECTED_ESTIMATED) THEN
+   REASON='stage_estimated_mismatch'
+   RETURN
+ENDIF
+IF (G1EQ_FACE_STATE(IW)%FLUX_IOR/=IOR) THEN
+   REASON='face_ior_mismatch'
+   RETURN
+ENDIF
+VALID=.TRUE.
+REASON='valid'
+
+END SUBROUTINE G1EQ_UPDATE_JOIN_STATUS
+
+
+SUBROUTINE G1EQ_UPDATE(POINT,T,DT,NM,PRE)
+
+CHARACTER(LEN=*), INTENT(IN) :: POINT
+REAL(EB), INTENT(IN) :: T,DT
+INTEGER, INTENT(IN) :: NM
+LOGICAL, INTENT(IN) :: PRE
+INTEGER :: IW,I,J,K,IOR
+REAL(EB) :: UOLD,UEST,URES,HI,HG,RN,GRAD,FVN,AFN,FV_NONFRAME,FRAME_RES,FINAL_RES
+REAL(EB) :: DIRECT_EXPECTED,DIRECT_RES,REDUCED_GRAD,PC_EXPECTED,PC_RES
+LOGICAL :: EXPECTED_ESTIMATED,JOIN_VALID
+CHARACTER(LEN=64) :: REASON
+CHARACTER(LEN=16384) :: LINE
+TYPE(WALL_TYPE), POINTER :: WC
+TYPE(BOUNDARY_COORD_TYPE), POINTER :: BC
+
+IF (.NOT.G1EQ_ACTIVE(NM)) RETURN
+IF (.NOT.G1EQ_PRESSURE_VALID .OR. .NOT.ALLOCATED(G1EQ_FACE_STATE)) THEN
+   CALL G1EQ_CATEGORICAL_FAILURE('update_join_failure',T,DT,NM,0,'pressure_state_invalid')
+   RETURN
+ENDIF
+IF (G1EQ_PRESSURE_PREDICTOR .NEQV. PREDICTOR) THEN
+   CALL G1EQ_CATEGORICAL_FAILURE('update_join_failure',T,DT,NM,0,'pressure_stage_mismatch')
+   RETURN
+ENDIF
+EXPECTED_ESTIMATED=.NOT.G1EQ_PRESSURE_PREDICTOR
+DO IW=1,N_EXTERNAL_WALL_CELLS
+   IF (G1EQ_FACE_STATE(IW)%BRANCH==0) CYCLE
+   WC=>WALL(IW)
+   BC=>BOUNDARY_COORD(WC%BC_INDEX)
+   I=BC%II
+   J=BC%JJ
+   K=BC%KK
+   IOR=BC%IOR
+   IF (G1EQ_FACE_STATE(IW)%PRESSURE_IOR/=IOR) THEN
+      CALL G1EQ_CATEGORICAL_FAILURE('update_join_failure',T,DT,NM,IW,'pressure_face_ior_mismatch')
+      CYCLE
+   ENDIF
+   IF (PRE) THEN
+      CALL G1EQ_UPDATE_JOIN_STATUS(IW,IOR,NM,DT,EXPECTED_ESTIMATED,JOIN_VALID,REASON)
+      IF (.NOT.JOIN_VALID) THEN
+         CALL G1EQ_CATEGORICAL_FAILURE('update_join_failure',T,DT,NM,IW,REASON)
+         CYCLE
+      ENDIF
+      IF (G1EQ_PRESSURE_PREDICTOR) THEN
+         CALL G1EQ_FACE_SAMPLE(IOR,I,J,K,H,HI,HG,RN)
+      ELSE
+         CALL G1EQ_FACE_SAMPLE(IOR,I,J,K,HS,HI,HG,RN)
+      ENDIF
+      GRAD=RN*(HI-HG)
+      CALL G1EQ_NORMAL_SAMPLE(IOR,I,J,K,U,V,W,UOLD)
+      CALL G1EQ_NORMAL_SAMPLE(IOR,I,J,K,US,VS,WS,UEST)
+      FVN=G1EQ_FVN(IOR,I,J,K)
+      G1EQ_FACE_STATE(IW)%UPDATE_FV=FVN
+      G1EQ_FACE_STATE(IW)%UPDATE_GRAD=GRAD
+      G1EQ_FACE_STATE(IW)%UPDATE_OLD=UOLD
+      G1EQ_FACE_STATE(IW)%UPDATE_EST=UEST
+      G1EQ_FACE_STATE(IW)%UPDATE_T=T
+      G1EQ_FACE_STATE(IW)%UPDATE_DT=DT
+      G1EQ_FACE_STATE(IW)%UPDATE_ICYC=ICYC
+      G1EQ_FACE_STATE(IW)%UPDATE_ATTEMPT=G1EQ_ATTEMPT_ORDINAL
+      G1EQ_FACE_STATE(IW)%UPDATE_PREDICTOR=G1EQ_PRESSURE_PREDICTOR
+      G1EQ_FACE_STATE(IW)%UPDATE_JOIN_VALID=.TRUE.
+      AFN=G1EQ_FACE_STATE(IW)%A_FRAME_FLUX_N
+      FV_NONFRAME=FVN-G1EQ_FACE_STATE(IW)%FRAME_DELTA_N
+      FRAME_RES=G1EQ_FACE_STATE(IW)%FRAME_DELTA_N-AFN
+      FINAL_RES=FVN-FV_NONFRAME-AFN
+      LINE=G1EQ_HEAD(POINT,T,DT,NM)
+      CALL G1EQ_ADD_LOGICAL(LINE,'join_valid',.TRUE.)
+      CALL G1EQ_ADD_INT(LINE,'iw',IW)
+      CALL G1EQ_ADD_INT(LINE,'ior',IOR)
+      CALL G1EQ_ADD_LOGICAL(LINE,'flux_estimated',G1EQ_FLUX_ESTIMATED)
+      CALL G1EQ_ADD_REAL(LINE,'t_flux',G1EQ_T_FLUX)
+      CALL G1EQ_ADD_REAL(LINE,'t_update',T)
+      CALL G1EQ_ADD_REAL(LINE,'dt_flux',G1EQ_DT_FLUX)
+      CALL G1EQ_ADD_INT(LINE,'flux_icyc',G1EQ_FLUX_ICYC)
+      CALL G1EQ_ADD_INT(LINE,'flux_attempt',G1EQ_FLUX_ATTEMPT)
+      CALL G1EQ_ADD_REAL(LINE,'u_accepted_old',UOLD)
+      CALL G1EQ_ADD_REAL(LINE,'u_estimated',UEST)
+      CALL G1EQ_ADD_REAL(LINE,'fv_pre_frame',G1EQ_FACE_STATE(IW)%FV_PRE)
+      CALL G1EQ_ADD_REAL(LINE,'fv_post_frame',G1EQ_FACE_STATE(IW)%FV_POST)
+      CALL G1EQ_ADD_REAL(LINE,'frame_delta_n',G1EQ_FACE_STATE(IW)%FRAME_DELTA_N)
+      CALL G1EQ_ADD_REAL(LINE,'fv_hooks_final',G1EQ_FACE_STATE(IW)%FV_HOOKS)
+      CALL G1EQ_ADD_REAL(LINE,'fv_n_consumed',FVN)
+      CALL G1EQ_ADD_REAL(LINE,'fv_nonframe_final',FV_NONFRAME)
+      CALL G1EQ_ADD_REAL(LINE,'a_frame_flux_n',AFN)
+      CALL G1EQ_ADD_REAL(LINE,'frame_residual',FRAME_RES)
+      CALL G1EQ_ADD_REAL(LINE,'final_frame_residual',FINAL_RES)
+      CALL G1EQ_ADD_REAL(LINE,'direct_gradient_n',GRAD)
+      WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+   ELSE
+      JOIN_VALID=G1EQ_FACE_STATE(IW)%UPDATE_JOIN_VALID
+      JOIN_VALID=JOIN_VALID .AND. G1EQ_FACE_STATE(IW)%UPDATE_ICYC==ICYC
+      JOIN_VALID=JOIN_VALID .AND. G1EQ_FACE_STATE(IW)%UPDATE_ATTEMPT==G1EQ_ATTEMPT_ORDINAL
+      JOIN_VALID=JOIN_VALID .AND. DEV159_BITS(G1EQ_FACE_STATE(IW)%UPDATE_DT)==DEV159_BITS(DT)
+      JOIN_VALID=JOIN_VALID .AND. DEV159_BITS(G1EQ_FACE_STATE(IW)%UPDATE_T)==DEV159_BITS(T)
+      JOIN_VALID=JOIN_VALID .AND. &
+         (G1EQ_FACE_STATE(IW)%UPDATE_PREDICTOR .EQV. G1EQ_PRESSURE_PREDICTOR)
+      IF (.NOT.JOIN_VALID) THEN
+         CALL G1EQ_CATEGORICAL_FAILURE('update_join_failure',T,DT,NM,IW,'pre_post_update_mismatch')
+         G1EQ_FACE_STATE(IW)%UPDATE_JOIN_VALID=.FALSE.
+         G1EQ_FACE_STATE(IW)%FLUX_VALID=.FALSE.
+         G1EQ_FACE_STATE(IW)%HOOKS_VALID=.FALSE.
+         CYCLE
+      ENDIF
+      IF (G1EQ_PRESSURE_PREDICTOR) THEN
+         CALL G1EQ_NORMAL_SAMPLE(IOR,I,J,K,US,VS,WS,URES)
+         CALL G1EQ_FACE_SAMPLE(IOR,I,J,K,H,HI,HG,RN)
+      ELSE
+         CALL G1EQ_NORMAL_SAMPLE(IOR,I,J,K,U,V,W,URES)
+         CALL G1EQ_FACE_SAMPLE(IOR,I,J,K,HS,HI,HG,RN)
+      ENDIF
+      REDUCED_GRAD=2._EB*RN*(HI-G1EQ_FACE_STATE(IW)%HI_OLD-G1EQ_FACE_STATE(IW)%PHI)
+      IF (G1EQ_PRESSURE_PREDICTOR) THEN
+         DIRECT_EXPECTED=G1EQ_FACE_STATE(IW)%UPDATE_OLD- &
+            DT*(G1EQ_FACE_STATE(IW)%UPDATE_FV+G1EQ_FACE_STATE(IW)%UPDATE_GRAD)
+         PC_EXPECTED=G1EQ_FACE_STATE(IW)%SOURCE_UN- &
+            DT*(G1EQ_FACE_STATE(IW)%UPDATE_FV+REDUCED_GRAD)
+      ELSE
+         DIRECT_EXPECTED=0.5_EB*(G1EQ_FACE_STATE(IW)%UPDATE_OLD+G1EQ_FACE_STATE(IW)%UPDATE_EST- &
+            DT*(G1EQ_FACE_STATE(IW)%UPDATE_FV+G1EQ_FACE_STATE(IW)%UPDATE_GRAD))
+         PC_EXPECTED=G1EQ_FACE_STATE(IW)%SOURCE_UN+0.5_EB*(G1EQ_FACE_STATE(IW)%UPDATE_OLD- &
+            G1EQ_FACE_STATE(IW)%SOURCE_UN-DT*(G1EQ_FACE_STATE(IW)%UPDATE_FV+REDUCED_GRAD))
+      ENDIF
+      DIRECT_RES=URES-DIRECT_EXPECTED
+      PC_RES=URES-PC_EXPECTED
+      LINE=G1EQ_HEAD(POINT,T,DT,NM)
+      CALL G1EQ_ADD_LOGICAL(LINE,'join_valid',.TRUE.)
+      CALL G1EQ_ADD_INT(LINE,'iw',IW)
+      CALL G1EQ_ADD_INT(LINE,'ior',IOR)
+      CALL G1EQ_ADD_REAL(LINE,'t_flux',G1EQ_T_FLUX)
+      CALL G1EQ_ADD_REAL(LINE,'t_update',T)
+      CALL G1EQ_ADD_REAL(LINE,'target_source_un',G1EQ_FACE_STATE(IW)%SOURCE_UN)
+      CALL G1EQ_ADD_REAL(LINE,'minus_phi',-G1EQ_FACE_STATE(IW)%PHI)
+      CALL G1EQ_ADD_REAL(LINE,'u_accepted_old',G1EQ_FACE_STATE(IW)%UPDATE_OLD)
+      CALL G1EQ_ADD_REAL(LINE,'u_estimated',G1EQ_FACE_STATE(IW)%UPDATE_EST)
+      CALL G1EQ_ADD_REAL(LINE,'u_result',URES)
+      CALL G1EQ_ADD_REAL(LINE,'fv_n_consumed',G1EQ_FACE_STATE(IW)%UPDATE_FV)
+      CALL G1EQ_ADD_REAL(LINE,'direct_gradient_n',G1EQ_FACE_STATE(IW)%UPDATE_GRAD)
+      CALL G1EQ_ADD_REAL(LINE,'reduced_gradient_n',REDUCED_GRAD)
+      CALL G1EQ_ADD_REAL(LINE,'direct_expected',DIRECT_EXPECTED)
+      CALL G1EQ_ADD_REAL(LINE,'direct_residual',DIRECT_RES)
+      CALL G1EQ_ADD_REAL(LINE,'pc_expected',PC_EXPECTED)
+      CALL G1EQ_ADD_REAL(LINE,'pc_residual',PC_RES)
+      WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+      G1EQ_FACE_STATE(IW)%UPDATE_JOIN_VALID=.FALSE.
+      G1EQ_FACE_STATE(IW)%FLUX_VALID=.FALSE.
+      G1EQ_FACE_STATE(IW)%HOOKS_VALID=.FALSE.
+   ENDIF
+ENDDO
+
+END SUBROUTINE G1EQ_UPDATE
