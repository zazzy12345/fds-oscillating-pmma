+! Explicitly enabled restart-only Cartesian single-layer conservative remap.
+! All thermal time-stepping and the default restart path remain unchanged.
+SUBROUTINE CNF_REGRID_WALL(NM,IW,RG_CELL,RG_LOG,RG_AUDIT,RG_OK)
+USE COMP_FUNCTIONS, ONLY: SHUTDOWN
+USE, INTRINSIC :: IEEE_ARITHMETIC, ONLY: IEEE_IS_FINITE
+INTEGER, INTENT(IN) :: NM,IW,RG_LOG,RG_AUDIT
+REAL(EB), INTENT(IN) :: RG_CELL
+LOGICAL, INTENT(OUT) :: RG_OK
+TYPE(WALL_TYPE), POINTER :: WC
+TYPE(SURFACE_TYPE), POINTER :: SF
+TYPE(BOUNDARY_ONE_D_TYPE), POINTER :: OD
+TYPE(BOUNDARY_PROP1_TYPE), POINTER :: BP
+TYPE(BOUNDARY_COORD_TYPE), POINTER :: BC
+TYPE(BOUNDARY_ONE_D_TYPE) :: OLD
+INTEGER :: NO,NN,NC,NS,I,J,K,IL,IH,IM,IT
+REAL(EB) :: TH,DX,OV,HS,HL,HH,HNEW,HOLD,MERR,EERR,TF,TB,VSUM
