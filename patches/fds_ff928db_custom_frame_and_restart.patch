+IF (ALLOCATED(DEV161_OPEN_BRANCH)) THEN
+   IF (SIZE(DEV161_OPEN_BRANCH)/=N_EXTERNAL_WALL_CELLS) DEALLOCATE(DEV161_OPEN_BRANCH)
+ENDIF
+IF (ALLOCATED(DEV161_OPEN_BRANCH_UN)) THEN
+   IF (SIZE(DEV161_OPEN_BRANCH_UN)/=N_EXTERNAL_WALL_CELLS) DEALLOCATE(DEV161_OPEN_BRANCH_UN)
+ENDIF
+IF (.NOT.ALLOCATED(DEV161_OPEN_BRANCH)) ALLOCATE(DEV161_OPEN_BRANCH(N_EXTERNAL_WALL_CELLS))
+IF (.NOT.ALLOCATED(DEV161_OPEN_BRANCH_UN)) ALLOCATE(DEV161_OPEN_BRANCH_UN(N_EXTERNAL_WALL_CELLS))
+DEV161_OPEN_BRANCH=0
+DEV161_OPEN_BRANCH_UN=0._EB
+DEV161_OPEN_BRANCH_ICYC=ICYC
+DEV161_OPEN_BRANCH_PRESSURE_ITERATION=PRESSURE_ITERATIONS
+DEV161_OPEN_BRANCH_ESTIMATED=ESTIMATED
+DEV161_OPEN_BRANCH_VALID=.TRUE.
