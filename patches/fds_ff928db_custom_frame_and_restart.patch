+SUBROUTINE G1EQ_FACE_SAMPLE(IOR,I,J,K,HP,HI,HG,RN)
+
+INTEGER, INTENT(IN) :: IOR,I,J,K
+REAL(EB), INTENT(IN) :: HP(0:,0:,0:)
+REAL(EB), INTENT(OUT) :: HI,HG,RN
+
+SELECT CASE(IOR)
+   CASE(1)
+      HI=HP(1,J,K)
+      HG=HP(0,J,K)
+      RN=RDXN(0)
+   CASE(-1)
+      HI=HP(IBAR,J,K)
+      HG=HP(IBP1,J,K)
+      RN=RDXN(IBAR)
+   CASE(2)
+      HI=HP(I,1,K)
+      HG=HP(I,0,K)
+      RN=RDYN(0)
+   CASE(-2)
+      HI=HP(I,JBAR,K)
+      HG=HP(I,JBP1,K)
+      RN=RDYN(JBAR)
+   CASE(3)
+      HI=HP(I,J,1)
+      HG=HP(I,J,0)
+      RN=RDZN(0)
+   CASE(-3)
+      HI=HP(I,J,KBAR)
+      HG=HP(I,J,KBP1)
+      RN=RDZN(KBAR)
+END SELECT
+
+END SUBROUTINE G1EQ_FACE_SAMPLE
+
+
+REAL(EB) FUNCTION G1EQ_FVN(IOR,I,J,K)
+
+INTEGER, INTENT(IN) :: IOR,I,J,K
+
+G1EQ_FVN=0._EB
+SELECT CASE(IOR)
+   CASE(1)
+      G1EQ_FVN=FVX(0,J,K)
+   CASE(-1)
+      G1EQ_FVN=-FVX(IBAR,J,K)
+   CASE(2)
+      G1EQ_FVN=FVY(I,0,K)
+   CASE(-2)
+      G1EQ_FVN=-FVY(I,JBAR,K)
+   CASE(3)
+      G1EQ_FVN=FVZ(I,J,0)
+   CASE(-3)
+      G1EQ_FVN=-FVZ(I,J,KBAR)
+END SELECT
+
+END FUNCTION G1EQ_FVN
+
+
+SUBROUTINE G1EQ_NORMAL_SAMPLE(IOR,I,J,K,AA,BB,CC,VALUE)
+
+INTEGER, INTENT(IN) :: IOR,I,J,K
+REAL(EB), INTENT(IN) :: AA(-1:,0:,0:),BB(0:,-1:,0:),CC(0:,0:,-1:)
+REAL(EB), INTENT(OUT) :: VALUE
+
+VALUE=0._EB
+SELECT CASE(IOR)
+   CASE(1)
+      VALUE=AA(0,J,K)
+   CASE(-1)
+      VALUE=-AA(IBAR,J,K)
+   CASE(2)
+      VALUE=BB(I,0,K)
+   CASE(-2)
+      VALUE=-BB(I,JBAR,K)
+   CASE(3)
+      VALUE=CC(I,J,0)
+   CASE(-3)
+      VALUE=-CC(I,J,KBAR)
+END SELECT
+
+END SUBROUTINE G1EQ_NORMAL_SAMPLE
