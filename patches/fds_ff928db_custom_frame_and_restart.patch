+SUBROUTINE DEV161_OPEN_BRANCH_SET(IW,SOURCE_UN,CHARACTERISTIC_OUTFLOW)
+
+INTEGER, INTENT(IN) :: IW
+REAL(EB), INTENT(IN) :: SOURCE_UN
+LOGICAL, INTENT(IN) :: CHARACTERISTIC_OUTFLOW
+
+IF (.NOT.DEV161_OPEN_BRANCH_VALID) RETURN
+IF (.NOT.ALLOCATED(DEV161_OPEN_BRANCH) .OR. .NOT.ALLOCATED(DEV161_OPEN_BRANCH_UN)) THEN
+   DEV161_OPEN_BRANCH_VALID=.FALSE.
+   RETURN
+ENDIF
+IF (IW<1 .OR. IW>SIZE(DEV161_OPEN_BRANCH)) THEN
+   DEV161_OPEN_BRANCH_VALID=.FALSE.
+   RETURN
+ENDIF
+DEV161_OPEN_BRANCH(IW)=MERGE(2,1,CHARACTERISTIC_OUTFLOW)
+DEV161_OPEN_BRANCH_UN(IW)=SOURCE_UN
+
+END SUBROUTINE DEV161_OPEN_BRANCH_SET
