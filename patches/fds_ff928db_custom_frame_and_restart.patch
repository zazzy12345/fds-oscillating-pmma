+!> \brief Write the formal stage-consistent pressure successor in EB/float64.
+!> \details The read-only path is unreachable outside three exact CHIDs and
+!> the registered single-mesh periodic Taylor--Green scope.
+
+SUBROUTINE DUMP_TGV_PRESSURE_STAGE_S2(T,NM)
+
+USE ISO_FORTRAN_ENV, ONLY: INT32
+
+REAL(EB), INTENT(IN) :: T
+INTEGER, INTENT(IN) :: NM
+INTEGER, PARAMETER :: S2_NFIELDS=1
+CHARACTER(LEN=16), PARAMETER :: S2_MAGIC='CNF_TGV_S2_EB01!'
+CHARACTER(LEN=64), PARAMETER :: S2_FAMILY_SHA=&
+   'a0e5efc567bd182dfd181be427007aa1ff77f82807f50bf4edfa5be459b5e9d6'
+INTEGER :: I,K,LU_S2,EXPECTED_N
+INTEGER(INT32) :: S2_META(6)
+CHARACTER(LEN=256) :: FN_S2
+REAL(EB), ALLOCATABLE :: S2_FIELDS(:,:,:)
+
+SELECT CASE(TRIM(CHID))
+   CASE('tf_g2v3s2_stage_n064')
+      EXPECTED_N=64
+   CASE('tf_g2v3s2_stage_n128')
+      EXPECTED_N=128
+   CASE('tf_g2v3s2_stage_n256')
+      EXPECTED_N=256
+   CASE DEFAULT
+      RETURN
+END SELECT
+
+IF (ICYC<1) RETURN
+IF (NM/=1 .OR. MY_RANK/=0 .OR. NMESHES/=1 .OR. N_MPI_PROCESSES/=1 .OR. &
+    .NOT.CORRECTOR .OR. PREDICTOR .OR. RESTART .OR. PERIODIC_TEST/=1 .OR. &
+    .NOT.TWO_D .OR. CYLINDRICAL .OR. CC_IBM .OR. JBAR/=1 .OR. &
+    IBAR/=EXPECTED_N .OR. KBAR/=EXPECTED_N .OR. .NOT.BAROCLINIC .OR. &
+    PRES_FLAG/=FFT_FLAG .OR. &
+    .NOT.PHYSICAL_PRESSURE_GAUGE .OR. .NOT.PHYSICAL_PRESSURE_GAUGE_READY .OR. &
+    .NOT.TRANSLATING_FRAME .OR. .NOT.LOCK_TIME_STEP .OR. N_GEOM/=0 .OR. N_MOVE/=0 .OR. &
+    ANY(FISHPAK_BC/=0) .OR. LBC/=0 .OR. MBC/=0 .OR. NBC/=0) THEN
+   CALL SHUTDOWN('ERROR(S2PRESS): registered stage-pressure case is outside its exact scope.')
+   RETURN
+ENDIF
+
+ALLOCATE(S2_FIELDS(S2_NFIELDS,IBAR,KBAR))
+DO K=1,KBAR
+   DO I=1,IBAR
+      S2_FIELDS(1,I,K)=RHOS(I,1,K)*(HS(I,1,K)-KRES(I,1,K))
+   ENDDO
+ENDDO
+
+WRITE(FN_S2,'(A,A,A,I3.3,A)') TRIM(RESULTS_DIR),TRIM(CHID),'_s2eb_t',SLCF_COUNTER(NM),'.bin'
+OPEN(NEWUNIT=LU_S2,FILE=TRIM(FN_S2),ACCESS='STREAM',FORM='UNFORMATTED',STATUS='NEW',ACTION='WRITE')
+S2_META=[INT(1,INT32),INT(S2_NFIELDS,INT32),INT(IBAR,INT32),INT(JBAR,INT32), &
+         INT(KBAR,INT32),INT(SLCF_COUNTER(NM),INT32)]
+WRITE(LU_S2) S2_MAGIC
+WRITE(LU_S2) S2_FAMILY_SHA
+WRITE(LU_S2) S2_META
+WRITE(LU_S2) T
+WRITE(LU_S2) S2_FIELDS
+CLOSE(LU_S2)
+DEALLOCATE(S2_FIELDS)
+
+END SUBROUTINE DUMP_TGV_PRESSURE_STAGE_S2
 
 
