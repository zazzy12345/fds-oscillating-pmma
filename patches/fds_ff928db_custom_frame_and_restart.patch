+DEALLOCATE(OD%X,OD%TMP,OD%DX_OLD,OD%DELTA_TMP,OD%RHO_C_S,OD%K_S)
+ALLOCATE(OD%X(0:NC),OD%TMP(0:NC+1),OD%DX_OLD(NC),OD%DELTA_TMP(0:NC+1),OD%RHO_C_S(NC),OD%K_S(0:NC+1))
+OD%X=TH; OD%X(0:NN)=XE
+OD%TMP=TN(NN); OD%TMP(0:NN+1)=TN
+OD%DX_OLD=0._EB; OD%DX_OLD(1:NN)=XE(1:NN)-XE(0:NN-1)
+OD%DELTA_TMP=0._EB
+OD%RHO_C_S=0._EB; OD%K_S=0._EB
+DO K=1,NS
+   DEALLOCATE(OD%MATL_COMP(K)%RHO)
+   ALLOCATE(OD%MATL_COMP(K)%RHO(0:NC+1))
+   OD%MATL_COMP(K)%RHO=0._EB
+   OD%MATL_COMP(K)%RHO(1:NN)=RN(:,K)
+   OD%MATL_COMP(K)%RHO(0)=RN(1,K)
+   OD%MATL_COMP(K)%RHO(NN+1)=RN(NN,K)
+ENDDO
+DO I=1,NN
+   IT=MIN(I_MAX_TEMP-1,INT(TN(I))); VSUM=0._EB
+   DO K=1,NS
+      OD%RHO_C_S(I)=OD%RHO_C_S(I)+RN(I,K)*MATERIAL(OLD%MATL_INDEX(K))%C_S(IT)
+      VSUM=VSUM+RN(I,K)/MATERIAL(OLD%MATL_INDEX(K))%RHO_S
+      OD%K_S(I)=OD%K_S(I)+RN(I,K)/MATERIAL(OLD%MATL_INDEX(K))%RHO_S*MATERIAL(OLD%MATL_INDEX(K))%K_S(IT)
+   ENDDO
+   OD%K_S(I)=OD%K_S(I)/VSUM
+ENDDO
+OD%K_S(0)=OD%K_S(1); OD%K_S(NN+1)=OD%K_S(NN)
+OD%N_CELLS_MAX=NC; OD%N_CELLS_INI=SF%N_CELLS_INI
+OD%N_LAYER_CELLS(1)=NN; OD%REMESH_NWP(1)=NN
+OD%N_LAYER_CELLS_MAX=SF%N_LAYER_CELLS_MAX(1:1)
+OD%CELL_SIZE(1)=RG_CELL
+OD%SMALLEST_CELL_SIZE(1)=TH/REAL(NN,EB); OD%DDSUM(1)=REAL(NN,EB)
+OD%LAYER_THICKNESS_OLD(1)=TH
+WRITE(RG_LOG,'(4(I0,","),13(ES24.16E3,","),I0)') NM,IW,NO,NN,TH,MERR,EERR,HOLD,HNEW, &
+   TF,TB,BC%X,BC%Y,BC%Z,MINVAL(TN(1:NN)),MAXVAL(TN(1:NN)),MINVAL(RN),NS
+IF (RG_AUDIT/=0) THEN
