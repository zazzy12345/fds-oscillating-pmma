+USE PHYSICAL_FUNCTIONS, ONLY: GET_SPECIFIC_GAS_CONSTANT
+USE UNIFIED_OBSERVATIONS, ONLY: UOBS_ACTIVE,UOBS_EMIT_PACKET
+TYPE(MESH_TYPE), INTENT(INOUT) :: M
+INTEGER, INTENT(IN) :: NM
+INTEGER :: I,J,K,NT,NB
+REAL(EB), PARAMETER :: XC0=0._EB,YC0=-0.10_EB,ZC0=0._EB,SIG=0.0375_EB
+REAL(EB) :: G,R2,INTEGRAL,KE,DIV_MAX,DIV_LIMIT,SCALE,MAX_SPEED,DIV,DX_MIN
+REAL(EB), ALLOCATABLE :: AZ(:,:,:),DU(:,:,:),DV(:,:,:)
+REAL(EB) :: ZZ_GET(1:N_TRACKED_SPECIES)
+IF (.NOT.TF_UOBS_PACKET_REQUESTED) RETURN
+IF (.NOT.UOBS_ACTIVE('V7',NM)) THEN
+   CALL SHUTDOWN('ERROR(UOBS): packet requires fully identity-bound V7 observation activation.') ; RETURN
+ENDIF
+IF (UOBS_V7_CHID_ALLOWLIST_SHA256==REPEAT('0',64)) THEN
+   CALL SHUTDOWN('ERROR(UOBS): packet activation closed by unresolved V7 CHID allowlist.') ; RETURN
+ENDIF
+INTEGRAL=0._EB ; KE=0._EB ; DIV_MAX=0._EB ; DIV_LIMIT=0._EB
+SELECT CASE(TF_PACKET_KIND)
+CASE('PASSIVE')
+   NT=TF_PACKET_TRACER_INDEX ; NB=TF_PACKET_BACKGROUND_INDEX
+   IF (NT<1 .OR. NT>N_TRACKED_SPECIES .OR. NB<1 .OR. NB>N_TRACKED_SPECIES .OR. NT==NB) THEN
+      CALL SHUTDOWN('ERROR(UOBS): PASSIVE requires distinct valid tracer/background indices.') ; RETURN
+   ENDIF
+   IF (SPECIES_MIXTURE(NT)%MW/=SPECIES_MIXTURE(NB)%MW .OR. ANY(CP_Z(:,NT)/=CP_Z(:,NB)) .OR. &
+       ANY(K_RSQMW_Z(:,NT)/=K_RSQMW_Z(:,NB)) .OR. ANY(MU_RSQMW_Z(:,NT)/=MU_RSQMW_Z(:,NB)) .OR. &
+       ANY(D_Z(:,NT)/=D_Z(:,NB))) THEN
+      CALL SHUTDOWN('ERROR(UOBS): PASSIVE tracer/background properties are not exactly matched.') ; RETURN
+   ENDIF
+   DO K=1,M%KBAR ; DO J=1,M%JBAR ; DO I=1,M%IBAR
+      R2=(M%XC(I)-XC0)**2+(M%YC(J)-YC0)**2+(M%ZC(K)-ZC0)**2
+      G=0.01_EB*EXP(-0.5_EB*R2/SIG**2)
+      IF (M%ZZ(I,J,K,NB)<G) THEN
+         CALL SHUTDOWN('ERROR(UOBS): insufficient matched background fraction.') ; RETURN
+      ENDIF
