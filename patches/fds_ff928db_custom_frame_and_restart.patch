+SUBROUTINE DEV159_WRITE_FRAME(T,DT,NM,ROUTINE_NAME,STAGE_NAME,ESTIMATED)
+
+USE FRAME_FUNCTIONS, ONLY: GET_FRAME_KINEMATICS
+REAL(EB), INTENT(IN) :: T,DT
+INTEGER, INTENT(IN) :: NM
+CHARACTER(LEN=*), INTENT(IN) :: ROUTINE_NAME,STAGE_NAME
+LOGICAL, INTENT(IN) :: ESTIMATED
