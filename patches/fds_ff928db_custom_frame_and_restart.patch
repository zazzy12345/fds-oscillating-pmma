+SUBROUTINE G1EQ_TANGENTIAL_SAMPLE(IEC,ICD,II,JJ,KK,IOR,UU,VV,WW,VALID,COMPONENT, &
+                                  EDGE_VALUE,INTERIOR_VALUE,TARGET_VALUE,NORMAL_1,NORMAL_2)
+
+INTEGER, INTENT(IN) :: IEC,ICD,II,JJ,KK,IOR
+REAL(EB), INTENT(IN) :: UU(0:,0:,0:),VV(0:,0:,0:),WW(0:,0:,0:)
+LOGICAL, INTENT(OUT) :: VALID
+CHARACTER(LEN=*), INTENT(OUT) :: COMPONENT
+REAL(EB), INTENT(OUT) :: EDGE_VALUE,INTERIOR_VALUE,TARGET_VALUE,NORMAL_1,NORMAL_2
+
+VALID=.TRUE.
+COMPONENT='unknown'
+EDGE_VALUE=0._EB
+INTERIOR_VALUE=0._EB
+TARGET_VALUE=0._EB
+NORMAL_1=0._EB
+NORMAL_2=0._EB
+SELECT CASE(10*IEC+ICD)
+   CASE(11)
+      COMPONENT='W/y'
+      NORMAL_1=VV(II,MERGE(0,JBAR,IOR>0),KK)
+      NORMAL_2=VV(II,MERGE(0,JBAR,IOR>0),KK+1)
+      IF (IOR>0) THEN
+         EDGE_VALUE=WW(II,0,KK)
+         INTERIOR_VALUE=WW(II,1,KK)
+      ELSE
+         EDGE_VALUE=WW(II,JBP1,KK)
+         INTERIOR_VALUE=WW(II,JBAR,KK)
+      ENDIF
+      TARGET_VALUE=W_WIND(KK)
+   CASE(12)
+      COMPONENT='V/z'
+      NORMAL_1=WW(II,JJ,MERGE(0,KBAR,IOR>0))
+      NORMAL_2=WW(II,JJ+1,MERGE(0,KBAR,IOR>0))
+      IF (IOR>0) THEN
+         EDGE_VALUE=VV(II,JJ,0)
+         INTERIOR_VALUE=VV(II,JJ,1)
+      ELSE
+         EDGE_VALUE=VV(II,JJ,KBP1)
+         INTERIOR_VALUE=VV(II,JJ,KBAR)
+      ENDIF
+      TARGET_VALUE=V_WIND(KK)
+   CASE(21)
+      COMPONENT='U/z'
+      NORMAL_1=WW(II,JJ,MERGE(0,KBAR,IOR>0))
+      NORMAL_2=WW(II+1,JJ,MERGE(0,KBAR,IOR>0))
+      IF (IOR>0) THEN
+         EDGE_VALUE=UU(II,JJ,0)
+         INTERIOR_VALUE=UU(II,JJ,1)
+      ELSE
+         EDGE_VALUE=UU(II,JJ,KBP1)
+         INTERIOR_VALUE=UU(II,JJ,KBAR)
+      ENDIF
+      TARGET_VALUE=U_WIND(KK)
+   CASE(22)
+      COMPONENT='W/x'
+      NORMAL_1=UU(MERGE(0,IBAR,IOR>0),JJ,KK)
+      NORMAL_2=UU(MERGE(0,IBAR,IOR>0),JJ,KK+1)
+      IF (IOR>0) THEN
+         EDGE_VALUE=WW(0,JJ,KK)
+         INTERIOR_VALUE=WW(1,JJ,KK)
+      ELSE
+         EDGE_VALUE=WW(IBP1,JJ,KK)
+         INTERIOR_VALUE=WW(IBAR,JJ,KK)
+      ENDIF
+      TARGET_VALUE=W_WIND(KK)
+   CASE(31)
+      COMPONENT='V/x'
+      NORMAL_1=UU(MERGE(0,IBAR,IOR>0),JJ,KK)
+      NORMAL_2=UU(MERGE(0,IBAR,IOR>0),JJ+1,KK)
+      IF (IOR>0) THEN
+         EDGE_VALUE=VV(0,JJ,KK)
+         INTERIOR_VALUE=VV(1,JJ,KK)
+      ELSE
+         EDGE_VALUE=VV(IBP1,JJ,KK)
+         INTERIOR_VALUE=VV(IBAR,JJ,KK)
+      ENDIF
+      TARGET_VALUE=V_WIND(KK)
+   CASE(32)
+      COMPONENT='U/y'
+      NORMAL_1=VV(II,MERGE(0,JBAR,IOR>0),KK)
+      NORMAL_2=VV(II+1,MERGE(0,JBAR,IOR>0),KK)
+      IF (IOR>0) THEN
+         EDGE_VALUE=UU(II,0,KK)
+         INTERIOR_VALUE=UU(II,1,KK)
+      ELSE
+         EDGE_VALUE=UU(II,JBP1,KK)
+         INTERIOR_VALUE=UU(II,JBAR,KK)
+      ENDIF
+      TARGET_VALUE=U_WIND(KK)
+   CASE DEFAULT
+      VALID=.FALSE.
+END SELECT
+
+END SUBROUTINE G1EQ_TANGENTIAL_SAMPLE
+
+
+SUBROUTINE G1EQ_TANGENTIAL(PRE,T,NM,ESTIMATED,IE,IEC,ICD,II,JJ,KK,IOR,IWM,IWP, &
+                           VENT_INDEX,UPWIND,INFLOW,U_NORM,EDDY,UU,VV,WW)
+
+LOGICAL, INTENT(IN) :: PRE,ESTIMATED,UPWIND,INFLOW
+REAL(EB), INTENT(IN) :: T,U_NORM,EDDY,UU(0:,0:,0:),VV(0:,0:,0:),WW(0:,0:,0:)
+INTEGER, INTENT(IN) :: NM,IE,IEC,ICD,II,JJ,KK,IOR,IWM,IWP,VENT_INDEX
+REAL(EB) :: EDGE_VALUE,INTERIOR_VALUE,TARGET_VALUE,NORMAL_1,NORMAL_2
+REAL(EB) :: EXPECTED,RESIDUAL,U_NORM_RECON,U_NORM_RES
+LOGICAL :: SAMPLE_VALID,JOIN_VALID
+CHARACTER(LEN=8) :: COMPONENT
+CHARACTER(LEN=16384) :: LINE
+
+IF (.NOT.G1EQ_ACTIVE(NM)) RETURN
+CALL G1EQ_TANGENTIAL_SAMPLE(IEC,ICD,II,JJ,KK,IOR,UU,VV,WW,SAMPLE_VALID,COMPONENT, &
+                            EDGE_VALUE,INTERIOR_VALUE,TARGET_VALUE,NORMAL_1,NORMAL_2)
+IF (.NOT.SAMPLE_VALID) RETURN
+IF (PRE) THEN
+   G1EQ_TANGENTIAL_STATE%IE=IE
+   G1EQ_TANGENTIAL_STATE%IEC=IEC
+   G1EQ_TANGENTIAL_STATE%ICD=ICD
+   G1EQ_TANGENTIAL_STATE%II=II
+   G1EQ_TANGENTIAL_STATE%JJ=JJ
+   G1EQ_TANGENTIAL_STATE%KK=KK
+   G1EQ_TANGENTIAL_STATE%IOR=IOR
+   G1EQ_TANGENTIAL_STATE%IWM=IWM
+   G1EQ_TANGENTIAL_STATE%IWP=IWP
+   G1EQ_TANGENTIAL_STATE%VENT_INDEX=VENT_INDEX
+   G1EQ_TANGENTIAL_STATE%ICYC=ICYC
+   G1EQ_TANGENTIAL_STATE%ATTEMPT=G1EQ_ATTEMPT_ORDINAL
+   G1EQ_TANGENTIAL_STATE%EDGE=EDGE_VALUE
+   G1EQ_TANGENTIAL_STATE%INTERIOR=INTERIOR_VALUE
+   G1EQ_TANGENTIAL_STATE%TARGET=TARGET_VALUE
+   G1EQ_TANGENTIAL_STATE%NORMAL_1=NORMAL_1
+   G1EQ_TANGENTIAL_STATE%NORMAL_2=NORMAL_2
+   G1EQ_TANGENTIAL_STATE%U_NORM=U_NORM
+   G1EQ_TANGENTIAL_STATE%ESTIMATED=ESTIMATED
+   G1EQ_TANGENTIAL_STATE%VALID=.TRUE.
+   RETURN
+ENDIF
+JOIN_VALID=G1EQ_TANGENTIAL_STATE%VALID
+JOIN_VALID=JOIN_VALID .AND. G1EQ_TANGENTIAL_STATE%IE==IE
+JOIN_VALID=JOIN_VALID .AND. G1EQ_TANGENTIAL_STATE%IEC==IEC
+JOIN_VALID=JOIN_VALID .AND. G1EQ_TANGENTIAL_STATE%ICD==ICD
+JOIN_VALID=JOIN_VALID .AND. G1EQ_TANGENTIAL_STATE%II==II
+JOIN_VALID=JOIN_VALID .AND. G1EQ_TANGENTIAL_STATE%JJ==JJ
+JOIN_VALID=JOIN_VALID .AND. G1EQ_TANGENTIAL_STATE%KK==KK
+JOIN_VALID=JOIN_VALID .AND. G1EQ_TANGENTIAL_STATE%IOR==IOR
+JOIN_VALID=JOIN_VALID .AND. G1EQ_TANGENTIAL_STATE%IWM==IWM
+JOIN_VALID=JOIN_VALID .AND. G1EQ_TANGENTIAL_STATE%IWP==IWP
+JOIN_VALID=JOIN_VALID .AND. G1EQ_TANGENTIAL_STATE%VENT_INDEX==VENT_INDEX
+JOIN_VALID=JOIN_VALID .AND. G1EQ_TANGENTIAL_STATE%ICYC==ICYC
+JOIN_VALID=JOIN_VALID .AND. G1EQ_TANGENTIAL_STATE%ATTEMPT==G1EQ_ATTEMPT_ORDINAL
+JOIN_VALID=JOIN_VALID .AND. (G1EQ_TANGENTIAL_STATE%ESTIMATED .EQV. ESTIMATED)
+IF (.NOT.JOIN_VALID) THEN
+   CALL G1EQ_CATEGORICAL_FAILURE('tangential_join_failure',T,G1EQ_PRESSURE_DT,NM,IE, &
+                                 'pre_post_edge_mismatch')
+   G1EQ_TANGENTIAL_STATE%VALID=.FALSE.
+   RETURN
+ENDIF
+IF (UPWIND .AND. INFLOW) THEN
+   EXPECTED=G1EQ_TANGENTIAL_STATE%TARGET+EDDY
+ELSE
+   EXPECTED=G1EQ_TANGENTIAL_STATE%INTERIOR
+ENDIF
+RESIDUAL=EDGE_VALUE-EXPECTED
+U_NORM_RECON=0.5_EB*(G1EQ_TANGENTIAL_STATE%NORMAL_1+G1EQ_TANGENTIAL_STATE%NORMAL_2)
+U_NORM_RES=G1EQ_TANGENTIAL_STATE%U_NORM-U_NORM_RECON
+LINE=G1EQ_HEAD('tangential_join',T,G1EQ_PRESSURE_DT,NM)
+CALL G1EQ_ADD_LOGICAL(LINE,'join_valid',.TRUE.)
+CALL G1EQ_ADD_INT(LINE,'ie',IE)
+CALL G1EQ_ADD_INT(LINE,'iec',IEC)
+CALL G1EQ_ADD_INT(LINE,'icd',ICD)
+CALL G1EQ_ADD_TEXT(LINE,'component',COMPONENT)
+CALL G1EQ_ADD_INT(LINE,'ii',II)
+CALL G1EQ_ADD_INT(LINE,'jj',JJ)
+CALL G1EQ_ADD_INT(LINE,'kk',KK)
+CALL G1EQ_ADD_INT(LINE,'ior',IOR)
+CALL G1EQ_ADD_INT(LINE,'iwm',IWM)
+CALL G1EQ_ADD_INT(LINE,'iwp',IWP)
+CALL G1EQ_ADD_INT(LINE,'vent_index',VENT_INDEX)
+CALL G1EQ_ADD_LOGICAL(LINE,'estimated',ESTIMATED)
+CALL G1EQ_ADD_LOGICAL(LINE,'upwind',UPWIND)
+CALL G1EQ_ADD_LOGICAL(LINE,'inflow',INFLOW)
+CALL G1EQ_ADD_REAL(LINE,'normal_sample_1',G1EQ_TANGENTIAL_STATE%NORMAL_1)
+CALL G1EQ_ADD_REAL(LINE,'normal_sample_2',G1EQ_TANGENTIAL_STATE%NORMAL_2)
+CALL G1EQ_ADD_REAL(LINE,'u_norm',G1EQ_TANGENTIAL_STATE%U_NORM)
+CALL G1EQ_ADD_REAL(LINE,'u_norm_reconstructed',U_NORM_RECON)
+CALL G1EQ_ADD_REAL(LINE,'u_norm_residual',U_NORM_RES)
+CALL G1EQ_ADD_REAL(LINE,'edge_pre',G1EQ_TANGENTIAL_STATE%EDGE)
+CALL G1EQ_ADD_REAL(LINE,'edge_post',EDGE_VALUE)
+CALL G1EQ_ADD_REAL(LINE,'interior',G1EQ_TANGENTIAL_STATE%INTERIOR)
+CALL G1EQ_ADD_REAL(LINE,'target_base',G1EQ_TANGENTIAL_STATE%TARGET)
+CALL G1EQ_ADD_REAL(LINE,'vel_eddy',EDDY)
+CALL G1EQ_ADD_REAL(LINE,'expected_post',EXPECTED)
+CALL G1EQ_ADD_REAL(LINE,'tangential_residual',RESIDUAL)
+WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+G1EQ_TANGENTIAL_STATE%VALID=.FALSE.
+
+END SUBROUTINE G1EQ_TANGENTIAL
+
+
+SUBROUTINE G1EQ_NORMAL_BC(POINT,T,DT,NM,ESTIMATED,PRE)
+
+CHARACTER(LEN=*), INTENT(IN) :: POINT
+REAL(EB), INTENT(IN) :: T,DT
+INTEGER, INTENT(IN) :: NM
+LOGICAL, INTENT(IN) :: ESTIMATED,PRE
+INTEGER :: IW,I,J,K,IOR
+REAL(EB) :: VALUE,DELTA
+LOGICAL :: JOIN_VALID
+CHARACTER(LEN=16384) :: LINE
+TYPE(WALL_TYPE), POINTER :: WC
+TYPE(BOUNDARY_COORD_TYPE), POINTER :: BC
+
+IF (.NOT.G1EQ_ACTIVE(NM)) RETURN
+IF (.NOT.G1EQ_PRESSURE_VALID .OR. .NOT.ALLOCATED(G1EQ_FACE_STATE)) RETURN
+DO IW=1,N_EXTERNAL_WALL_CELLS
+   IF (G1EQ_FACE_STATE(IW)%BRANCH==0) CYCLE
+   WC=>WALL(IW)
+   BC=>BOUNDARY_COORD(WC%BC_INDEX)
+   I=BC%II
+   J=BC%JJ
+   K=BC%KK
+   IOR=BC%IOR
+   IF (ESTIMATED) THEN
+      CALL G1EQ_NORMAL_SAMPLE(IOR,I,J,K,US,VS,WS,VALUE)
+   ELSE
+      CALL G1EQ_NORMAL_SAMPLE(IOR,I,J,K,U,V,W,VALUE)
+   ENDIF
+   IF (PRE) THEN
+      G1EQ_FACE_STATE(IW)%VBC_PRE=VALUE
+      G1EQ_FACE_STATE(IW)%VBC_T=T
+      G1EQ_FACE_STATE(IW)%VBC_DT=DT
+      G1EQ_FACE_STATE(IW)%VBC_ICYC=ICYC
+      G1EQ_FACE_STATE(IW)%VBC_ATTEMPT=G1EQ_ATTEMPT_ORDINAL
+      G1EQ_FACE_STATE(IW)%VBC_ESTIMATED=ESTIMATED
+      G1EQ_FACE_STATE(IW)%VBC_VALID=.TRUE.
+      CYCLE
+   ENDIF
+   JOIN_VALID=G1EQ_FACE_STATE(IW)%VBC_VALID
+   JOIN_VALID=JOIN_VALID .AND. G1EQ_FACE_STATE(IW)%VBC_ICYC==ICYC
+   JOIN_VALID=JOIN_VALID .AND. G1EQ_FACE_STATE(IW)%VBC_ATTEMPT==G1EQ_ATTEMPT_ORDINAL
+   JOIN_VALID=JOIN_VALID .AND. DEV159_BITS(G1EQ_FACE_STATE(IW)%VBC_T)==DEV159_BITS(T)
+   JOIN_VALID=JOIN_VALID .AND. DEV159_BITS(G1EQ_FACE_STATE(IW)%VBC_DT)==DEV159_BITS(DT)
+   JOIN_VALID=JOIN_VALID .AND. (G1EQ_FACE_STATE(IW)%VBC_ESTIMATED .EQV. ESTIMATED)
+   IF (.NOT.JOIN_VALID) THEN
+      CALL G1EQ_CATEGORICAL_FAILURE('normal_bc_join_failure',T,DT,NM,IW,'pre_post_bc_mismatch')
+      G1EQ_FACE_STATE(IW)%VBC_VALID=.FALSE.
+      CYCLE
+   ENDIF
+   DELTA=VALUE-G1EQ_FACE_STATE(IW)%VBC_PRE
+   LINE=G1EQ_HEAD('normal_velocity_bc_join',T,DT,NM)
+   CALL G1EQ_ADD_TEXT(LINE,'caller_point',POINT)
+   CALL G1EQ_ADD_LOGICAL(LINE,'join_valid',.TRUE.)
+   CALL G1EQ_ADD_INT(LINE,'iw',IW)
+   CALL G1EQ_ADD_INT(LINE,'ior',IOR)
+   CALL G1EQ_ADD_LOGICAL(LINE,'estimated',ESTIMATED)
+   CALL G1EQ_ADD_REAL(LINE,'normal_pre',G1EQ_FACE_STATE(IW)%VBC_PRE)
+   CALL G1EQ_ADD_REAL(LINE,'normal_post',VALUE)
+   CALL G1EQ_ADD_REAL(LINE,'normal_delta',DELTA)
+   CALL G1EQ_ADD_REAL(LINE,'target_source_un',G1EQ_FACE_STATE(IW)%SOURCE_UN)
+   WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+   G1EQ_FACE_STATE(IW)%VBC_VALID=.FALSE.
+ENDDO
+
+END SUBROUTINE G1EQ_NORMAL_BC
+
+
