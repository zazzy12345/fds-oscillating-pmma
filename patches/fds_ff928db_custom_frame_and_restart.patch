+
+!> \brief Return current sensible solid enthalpy for this boundary face (J).
+!> The direct state difference across the density/shrinking/remesh update is
+!> the discrete counterpart of sum_a h_a(T) d(rho_a)/dt in a moving solid grid.
+
+REAL(EB) FUNCTION SENSIBLE_SOLID_ENTHALPY()
+
+INTEGER :: I_LOCAL,N_LOCAL,ITMP_LOCAL,ITMP_REF_LOCAL
+REAL(EB) :: VOL_LOCAL,H_LOCAL,H_REF_LOCAL,X0_LOCAL
+TYPE(MATERIAL_TYPE), POINTER :: ML_LOCAL
+
+SENSIBLE_SOLID_ENTHALPY = 0._EB
+X0_LOCAL = SUM(ONE_D%LAYER_THICKNESS)
+ITMP_REF_LOCAL = INT(SOLID_SENSIBLE_ENTHALPY_T_REF)
+
+DO I_LOCAL=1,NWP
+   SELECT CASE (SF%GEOMETRY)
+      CASE DEFAULT
+         VOL_LOCAL = B1%AREA*(ONE_D%X(I_LOCAL)-ONE_D%X(I_LOCAL-1))
+      CASE (SURF_CYLINDRICAL)
+         VOL_LOCAL = SF%LENGTH*PI*((SF%INNER_RADIUS+X0_LOCAL-ONE_D%X(I_LOCAL-1))**2-&
+                                   (SF%INNER_RADIUS+X0_LOCAL-ONE_D%X(I_LOCAL))**2)
+      CASE (SURF_INNER_CYLINDRICAL)
+         VOL_LOCAL = SF%LENGTH*PI*((SF%INNER_RADIUS+ONE_D%X(I_LOCAL))**2-&
+                                   (SF%INNER_RADIUS+ONE_D%X(I_LOCAL-1))**2)
+      CASE (SURF_SPHERICAL)
+         VOL_LOCAL = FOTHPI*((X0_LOCAL-ONE_D%X(I_LOCAL-1))**3-(X0_LOCAL-ONE_D%X(I_LOCAL))**3)
+   END SELECT
+   DO N_LOCAL=1,ONE_D%N_MATL
+      IF (ONE_D%MATL_COMP(N_LOCAL)%RHO(I_LOCAL)<=TWENTY_EPSILON_EB) CYCLE
+      ML_LOCAL => MATERIAL(ONE_D%MATL_INDEX(N_LOCAL))
+      ITMP_LOCAL = MIN(I_MAX_TEMP-1,MAX(0,INT(ONE_D%TMP(I_LOCAL))))
+      H_LOCAL = ML_LOCAL%H(ITMP_LOCAL) + (ONE_D%TMP(I_LOCAL)-REAL(ITMP_LOCAL,EB))*&
+                                          (ML_LOCAL%H(ITMP_LOCAL+1)-ML_LOCAL%H(ITMP_LOCAL))
+      H_REF_LOCAL = ML_LOCAL%H(ITMP_REF_LOCAL) + &
+                    (SOLID_SENSIBLE_ENTHALPY_T_REF-REAL(ITMP_REF_LOCAL,EB))*&
+                    (ML_LOCAL%H(ITMP_REF_LOCAL+1)-ML_LOCAL%H(ITMP_REF_LOCAL))
+      SENSIBLE_SOLID_ENTHALPY = SENSIBLE_SOLID_ENTHALPY + &
+         ONE_D%MATL_COMP(N_LOCAL)%RHO(I_LOCAL)*VOL_LOCAL*(H_LOCAL-H_REF_LOCAL)
+   ENDDO
+ENDDO
+
+END FUNCTION SENSIBLE_SOLID_ENTHALPY
 
