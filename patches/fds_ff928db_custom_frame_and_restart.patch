+SUBROUTINE G1EQ_ATTEMPT(POINT,T,DT,NEXT_DT)
+
+CHARACTER(LEN=*), INTENT(IN) :: POINT
+REAL(EB), INTENT(IN) :: T,DT,NEXT_DT
+CHARACTER(LEN=16384) :: LINE
+
+IF (.NOT.G1EQ_ACTIVE(1)) RETURN
+SELECT CASE(POINT)
+   CASE('attempt_reset')
+      G1EQ_ATTEMPT_ORDINAL=0
+      G1EQ_ATTEMPT_DISPOSITION='reset'
+   CASE('retry_attempt_begin')
+      G1EQ_ATTEMPT_ORDINAL=G1EQ_ATTEMPT_ORDINAL+1
+      G1EQ_ATTEMPT_DISPOSITION='active'
+      IF (ALLOCATED(G1EQ_FACE_STATE)) THEN
+         G1EQ_FACE_STATE%FLUX_VALID=.FALSE.
+         G1EQ_FACE_STATE%HOOKS_VALID=.FALSE.
+         G1EQ_FACE_STATE%UPDATE_JOIN_VALID=.FALSE.
+      ENDIF
+   CASE('retry_attempt_rejected')
+      G1EQ_ATTEMPT_DISPOSITION='rejected'
+   CASE('retry_attempt_aborted')
+      G1EQ_ATTEMPT_DISPOSITION='aborted'
+   CASE('retry_attempt_accepted')
+      G1EQ_ATTEMPT_DISPOSITION='accepted'
+   CASE DEFAULT
+      RETURN
+END SELECT
+LINE=G1EQ_HEAD(POINT,T,DT,1)
+CALL G1EQ_ADD_REAL(LINE,'next_candidate_dt',NEXT_DT)
+WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+
+END SUBROUTINE G1EQ_ATTEMPT
+
