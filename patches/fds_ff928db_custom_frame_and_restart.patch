+! DEV-136 diagnostic output only. These routines read the admitted FFT
+! operands/result and write LU_OUTPUT; they do not assign solver state.
+LOGICAL FUNCTION DEV136_EXTRA_GATE(NM)
+USE TRAN, ONLY: TRANS
+INTEGER, INTENT(IN) :: NM
+DEV136_EXTRA_GATE=IPS==0 .AND. ALL(TRANS(NM)%NOC==0) .AND. ITRN==IBAR .AND. JTRN==1 .AND. KTRN==KBAR
+END FUNCTION DEV136_EXTRA_GATE
+
+
+CHARACTER(LEN=2048) FUNCTION DEV136_PREFIX(PHASE,REGION)
+USE GLOBAL_CONSTANTS, ONLY: MY_RANK
+CHARACTER(LEN=*), INTENT(IN) :: PHASE,REGION
+CHARACTER(LEN=16) :: STAGE
+CHARACTER(LEN=4096) :: LINE
+IF (DEV135_TRACE_PREDICTOR) THEN
+   STAGE='predictor'
+ELSE
+   STAGE='corrector'
+ENDIF
+LINE='DEV136_POISSON_TRACE v=1 phase='//TRIM(PHASE)//' region='//TRIM(REGION)// &
+     ' role='//TRIM(DEV135_TRACE_ROLE)//' ICYC='//TRIM(DEV135_INT(DEV135_TRACE_ICYC))// &
+     ' stage='//TRIM(STAGE)//' pressure_iteration='//TRIM(DEV135_INT(DEV135_TRACE_ITERATION))// &
+     ' rank='//TRIM(DEV135_INT(MY_RANK))//' mesh=1 steps='//TRIM(DEV135_INT(DEV135_TRACE_STEPS))// &
+     ' target_cycle='//TRIM(DEV135_INT(DEV135_TRACE_TARGET))// &
+     ' T_ARG='//TRIM(DEV135_REAL(DEV135_TRACE_T_ARG))// &
+     ' DT='//TRIM(DEV135_REAL(DEV135_TRACE_DT_ARG))
+DEV136_PREFIX=TRIM(LINE)
+END FUNCTION DEV136_PREFIX
