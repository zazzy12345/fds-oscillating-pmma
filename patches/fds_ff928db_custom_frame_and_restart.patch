+SUBROUTINE G1EQ_RESTART_READ(T,STIME,DT,ICYC_LOADED,NM,FILENAME,RESTART_CHID_LOADED)
+
+REAL(EB), INTENT(IN) :: T,STIME,DT
+INTEGER, INTENT(IN) :: ICYC_LOADED,NM
+CHARACTER(LEN=*), INTENT(IN) :: FILENAME,RESTART_CHID_LOADED
+CHARACTER(LEN=64) :: SEGMENT,PARENT,MANIFEST
+CHARACTER(LEN=16384) :: LINE
+
+IF (.NOT.G1EQ_ACTIVE(NM)) RETURN
+CALL G1EQ_GET_IDS(SEGMENT,PARENT,MANIFEST)
+G1EQ_LOADED_T=T
+G1EQ_LOADED_STIME=STIME
+G1EQ_LOADED_DT=DT
+G1EQ_LOADED_ICYC=ICYC_LOADED
+G1EQ_LOADED_RESTART_FILE=FILENAME
+G1EQ_LOADED_RESTART_CHID=RESTART_CHID_LOADED
+G1EQ_RESTART_LINEAGE_VALID=.TRUE.
