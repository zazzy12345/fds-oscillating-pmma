+
+RG_OK=.TRUE.
+WC=>MESHES(NM)%WALL(IW)
+SF=>SURFACE(WC%SURF_INDEX)
+IF (.NOT.SF%INCLUDE_BOUNDARY_ONE_D_TYPE) RETURN
+OD=>MESHES(NM)%BOUNDARY_ONE_D(WC%OD_INDEX)
+IF (OD%N_LAYERS==0) RETURN
+NO=SUM(OD%N_LAYER_CELLS)
+IF (NO==0) RETURN
+! An unchanged numerical input needs no projection.
+IF (ALL(ABS(OD%CELL_SIZE-SF%CELL_SIZE(1:OD%N_LAYERS))<1.E-14_EB)) RETURN
+RG_OK=.FALSE.
+IF (OD%N_LAYERS/=1 .OR. SF%N_LAYERS/=1 .OR. SF%GEOMETRY/=SURF_CARTESIAN .OR. &
+    SF%HT_DIM/=1 .OR. WC%TD_INDEX/=0) THEN
+   CALL SHUTDOWN('ERROR: CNF regrid supports only single-layer Cartesian 1-D walls.',PROCESS_0_ONLY=.FALSE.); RETURN
+ENDIF
+IF (ABS(SF%CELL_SIZE(1)-RG_CELL)>1.E-14_EB .OR. ABS(SF%STRETCH_FACTOR(1)-1._EB)>1.E-12_EB .OR. &
+    RG_CELL<=0._EB .OR. RG_CELL>=OD%CELL_SIZE(1)) THEN
+   CALL SHUTDOWN('ERROR: CNF regrid target must be the declared uniform refinement.',PROCESS_0_ONLY=.FALSE.); RETURN
+ENDIF
+IF (OD%N_MATL/=SF%N_MATL .OR. ANY(OD%MATL_INDEX/=SF%MATL_INDEX)) THEN
+   CALL SHUTDOWN('ERROR: CNF regrid material identities changed.',PROCESS_0_ONLY=.FALSE.); RETURN
+ENDIF
+BP=>MESHES(NM)%BOUNDARY_PROP1(WC%B1_INDEX)
+BC=>MESHES(NM)%BOUNDARY_COORD(WC%BC_INDEX)
+OLD=OD
+TH=OLD%X(NO)-OLD%X(0)
+IF (TH<=0._EB .OR. ABS(OLD%X(0))>1.E-14_EB .OR. &
+    ABS(TH-OLD%LAYER_THICKNESS(1))>1.E-12_EB .OR. &
+    ANY(OLD%X(1:NO)<=OLD%X(0:NO-1))) THEN
+   CALL SHUTDOWN('ERROR: CNF regrid invalid saved column extent.',PROCESS_0_ONLY=.FALSE.); RETURN
+ENDIF
+NN=MAX(1,CEILING(TH/RG_CELL-1.E-10_EB))
+NC=SF%N_CELLS_MAX
+NS=OLD%N_MATL
+IF (NN>NC .OR. NC>NWP_MAX) THEN
+   CALL SHUTDOWN('ERROR: CNF regrid insufficient target capacity.',PROCESS_0_ONLY=.FALSE.); RETURN
+ENDIF
+ALLOCATE(XE(0:NN),RN(NN,NS),EN(NN),TN(0:NN+1),MO(NS),MN(NS),EO(NO))
+DO I=0,NN
+   XE(I)=TH*REAL(I,EB)/REAL(NN,EB)
+ENDDO
+RN=0._EB; EN=0._EB; MO=0._EB; EO=0._EB
+DO J=1,NO
+   IF (.NOT.IEEE_IS_FINITE(OLD%TMP(J)) .OR. OLD%TMP(J)<0._EB .OR. OLD%TMP(J)>REAL(I_MAX_TEMP,EB)) THEN
+      CALL SHUTDOWN('ERROR: CNF regrid invalid saved temperature.',PROCESS_0_ONLY=.FALSE.); RETURN
+   ENDIF
+   DO K=1,NS
+      IF (.NOT.IEEE_IS_FINITE(OLD%MATL_COMP(K)%RHO(J)) .OR. OLD%MATL_COMP(K)%RHO(J)<0._EB) THEN
+         CALL SHUTDOWN('ERROR: CNF regrid invalid saved material density.',PROCESS_0_ONLY=.FALSE.); RETURN
+      ENDIF
+      EO(J)=EO(J)+OLD%MATL_COMP(K)%RHO(J)*CNF_MATERIAL_SENSIBLE_H(OLD%MATL_INDEX(K),OLD%TMP(J))
+      MO(K)=MO(K)+OLD%MATL_COMP(K)%RHO(J)*(OLD%X(J)-OLD%X(J-1))
+   ENDDO
+   DO I=1,NN
+      OV=MAX(0._EB,MIN(XE(I),OLD%X(J))-MAX(XE(I-1),OLD%X(J-1)))
+      IF (OV<=0._EB) CYCLE
+      DX=XE(I)-XE(I-1)
+      EN(I)=EN(I)+OV/DX*EO(J)
