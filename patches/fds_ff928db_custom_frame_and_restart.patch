+SUBROUTINE DEV136_ADD_PRE(IR,QR,PRHS_VALUE,ALG,SUM_QR,SUM_QR2,SUM_PRHS,SUM_ALG,MAX_QR,MAX_ALG,COUNT)
+INTEGER, INTENT(IN) :: IR
+INTEGER, INTENT(INOUT) :: COUNT(3)
+REAL(EB), INTENT(IN) :: QR,PRHS_VALUE,ALG
+REAL(EB), INTENT(INOUT) :: SUM_QR(3),SUM_QR2(3),SUM_PRHS(3),SUM_ALG(3),MAX_QR(3),MAX_ALG(3)
+COUNT(IR)=COUNT(IR)+1
+SUM_QR(IR)=SUM_QR(IR)+QR
+SUM_QR2(IR)=SUM_QR2(IR)+QR*QR
+SUM_PRHS(IR)=SUM_PRHS(IR)+PRHS_VALUE
+SUM_ALG(IR)=SUM_ALG(IR)+ALG
+MAX_QR(IR)=MAX(MAX_QR(IR),ABS(QR))
+MAX_ALG(IR)=MAX(MAX_ALG(IR),ABS(ALG))
+END SUBROUTINE DEV136_ADD_PRE
+
+
+SUBROUTINE DEV136_TRACE_PRE(T_ARG,DT_ARG,NM)
+USE GLOBAL_CONSTANTS, ONLY: CORRECTOR,ICYC,LU_OUTPUT,PREDICTOR,PRESSURE_ITERATIONS
+INTEGER, INTENT(IN) :: NM
+REAL(EB), INTENT(IN) :: T_ARG,DT_ARG
+INTEGER :: I,J,K,IR,STEPS,N_TARGET,COUNT(3)
+REAL(EB) :: QF,QD,QR,ALG
+REAL(EB) :: SUM_QR(3),SUM_QR2(3),SUM_PRHS(3),SUM_ALG(3),MAX_QR(3),MAX_ALG(3)
+CHARACTER(LEN=24) :: ROLE
+CHARACTER(LEN=16), PARAMETER :: REGION(3)=[CHARACTER(LEN=16) :: 'all','belt','strict']
+CHARACTER(LEN=4096) :: LINE
+
+IF (.NOT.DEV135_EVENT_GATE(NM,T_ARG,DT_ARG,STEPS,N_TARGET,ROLE)) RETURN
+IF (.NOT.DEV136_EXTRA_GATE(NM)) THEN
+   WRITE(LU_OUTPUT,'(A)') 'DEV136_POISSON_TRACE v=1 phase=pre region=none error=extra-gate'
+   RETURN
+ENDIF
+IF (.NOT.DEV135_TRACE_VALID) THEN
+   WRITE(LU_OUTPUT,'(A)') 'DEV136_POISSON_TRACE v=1 phase=pre region=none error=missing-dev135-pre'
+   RETURN
+ENDIF
+IF (ICYC/=DEV135_TRACE_ICYC .OR. PRESSURE_ITERATIONS/=DEV135_TRACE_ITERATION .OR. &
+    PREDICTOR.NEQV.DEV135_TRACE_PREDICTOR .OR. CORRECTOR.NEQV.DEV135_TRACE_CORRECTOR .OR. &
+    STEPS/=DEV135_TRACE_STEPS .OR. N_TARGET/=DEV135_TRACE_TARGET .OR. ROLE/=DEV135_TRACE_ROLE) THEN
+   WRITE(LU_OUTPUT,'(A)') 'DEV136_POISSON_TRACE v=1 phase=pre region=none error=tuple-mismatch'
+   RETURN
+ENDIF
+
+COUNT=0; SUM_QR=0._EB; SUM_QR2=0._EB; SUM_PRHS=0._EB; SUM_ALG=0._EB
+MAX_QR=0._EB; MAX_ALG=0._EB
+DO K=1,KBAR
+   DO J=1,JBAR
+      DO I=1,IBAR
+         QF=(R(I-1)*FVX(I-1,J,K)-R(I)*FVX(I,J,K))*RDX(I)*RRN(I) + &
+            (FVY(I,J-1,K)-FVY(I,J,K))*RDY(J) + (FVZ(I,J,K-1)-FVZ(I,J,K))*RDZ(K)
+         QD=-DDDT(I,J,K); QR=QF+QD; ALG=PRHS(I,1,K)-QR
+         CALL DEV136_ADD_PRE(1,QR,PRHS(I,1,K),ALG,SUM_QR,SUM_QR2,SUM_PRHS,SUM_ALG,MAX_QR,MAX_ALG,COUNT)
+         IF (I==1 .OR. I==IBAR .OR. K==1 .OR. K==KBAR) THEN
+            IR=2
+         ELSE
+            IR=3
+         ENDIF
+         CALL DEV136_ADD_PRE(IR,QR,PRHS(I,1,K),ALG,SUM_QR,SUM_QR2,SUM_PRHS,SUM_ALG,MAX_QR,MAX_ALG,COUNT)
+      ENDDO
+   ENDDO
+ENDDO
+DO IR=1,3
+   LINE=TRIM(DEV136_PREFIX('pre',REGION(IR)))//' CELL_COUNT='//TRIM(DEV135_INT(COUNT(IR)))// &
+        ' QR_MEAN='//TRIM(DEV135_REAL(SUM_QR(IR)/REAL(COUNT(IR),EB)))// &
+        ' PRHS_MEAN='//TRIM(DEV135_REAL(SUM_PRHS(IR)/REAL(COUNT(IR),EB)))// &
+        ' ALG_MEAN='//TRIM(DEV135_REAL(SUM_ALG(IR)/REAL(COUNT(IR),EB)))// &
+        ' QR_RMS='//TRIM(DEV135_REAL(SQRT(SUM_QR2(IR)/REAL(COUNT(IR),EB))))// &
+        ' QR_LINF='//TRIM(DEV135_REAL(MAX_QR(IR)))//' ALG_LINF='//TRIM(DEV135_REAL(MAX_ALG(IR)))
+   WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+ENDDO
+END SUBROUTINE DEV136_TRACE_PRE
+
+
+SUBROUTINE DEV136_ADD_POST(IR,QR,LH,R0,RC,SUM_QR,SUM_LH,SUM_R0,SUM_R02,MAX_R0, &
+                           SUM_RC,SUM_RC2,MAX_RC,COUNT)
+INTEGER, INTENT(IN) :: IR
+INTEGER, INTENT(INOUT) :: COUNT(3)
+REAL(EB), INTENT(IN) :: QR,LH,R0,RC
+REAL(EB), INTENT(INOUT) :: SUM_QR(3),SUM_LH(3),SUM_R0(3),SUM_R02(3),MAX_R0(3)
+REAL(EB), INTENT(INOUT) :: SUM_RC(3),SUM_RC2(3),MAX_RC(3)
+COUNT(IR)=COUNT(IR)+1
+SUM_QR(IR)=SUM_QR(IR)+QR
+SUM_LH(IR)=SUM_LH(IR)+LH
+SUM_R0(IR)=SUM_R0(IR)+R0
+SUM_R02(IR)=SUM_R02(IR)+R0*R0
+MAX_R0(IR)=MAX(MAX_R0(IR),ABS(R0))
+SUM_RC(IR)=SUM_RC(IR)+RC
+SUM_RC2(IR)=SUM_RC2(IR)+RC*RC
+MAX_RC(IR)=MAX(MAX_RC(IR),ABS(RC))
+END SUBROUTINE DEV136_ADD_POST
+
+
+SUBROUTINE DEV136_TRACE_POST(NM)
+USE GLOBAL_CONSTANTS, ONLY: CORRECTOR,ICYC,LU_OUTPUT,PREDICTOR,PRESSURE_ITERATIONS
+INTEGER, INTENT(IN) :: NM
+INTEGER :: I,J,K,IR,STEPS,N_TARGET,COUNT(3)
+REAL(EB), POINTER, DIMENSION(:,:,:) :: HP
+REAL(EB) :: QF,QD,QR,LH,R0,RC
+REAL(EB) :: SUM_QR(3),SUM_LH(3),SUM_R0(3),SUM_R02(3),MAX_R0(3)
+REAL(EB) :: SUM_RC(3),SUM_RC2(3),MAX_RC(3)
+CHARACTER(LEN=24) :: ROLE
+CHARACTER(LEN=16), PARAMETER :: REGION(3)=[CHARACTER(LEN=16) :: 'all','belt','strict']
+CHARACTER(LEN=4096) :: LINE
+
+IF (.NOT.DEV135_TRACE_VALID) RETURN
+IF (.NOT.DEV135_EVENT_GATE(NM,DEV135_TRACE_T_ARG,DEV135_TRACE_DT_ARG,STEPS,N_TARGET,ROLE)) THEN
+   WRITE(LU_OUTPUT,'(A)') 'DEV136_POISSON_TRACE v=1 phase=post region=none error=event-gate'
+   RETURN
+ENDIF
+IF (.NOT.DEV136_EXTRA_GATE(NM)) THEN
+   WRITE(LU_OUTPUT,'(A)') 'DEV136_POISSON_TRACE v=1 phase=post region=none error=extra-gate'
+   RETURN
+ENDIF
+IF (ICYC/=DEV135_TRACE_ICYC .OR. PRESSURE_ITERATIONS/=DEV135_TRACE_ITERATION .OR. &
+    PREDICTOR.NEQV.DEV135_TRACE_PREDICTOR .OR. CORRECTOR.NEQV.DEV135_TRACE_CORRECTOR .OR. &
+    STEPS/=DEV135_TRACE_STEPS .OR. N_TARGET/=DEV135_TRACE_TARGET .OR. ROLE/=DEV135_TRACE_ROLE) THEN
+   WRITE(LU_OUTPUT,'(A)') 'DEV136_POISSON_TRACE v=1 phase=post region=none error=tuple-mismatch'
+   RETURN
+ENDIF
+IF (PREDICTOR) THEN
+   HP=>H
+ELSE
+   HP=>HS
+ENDIF
+IF (.NOT.ALL(HP(0,1:JBAR,1:KBAR)==HP(IBAR,1:JBAR,1:KBAR)) .OR. &
+    .NOT.ALL(HP(IBP1,1:JBAR,1:KBAR)==HP(1,1:JBAR,1:KBAR)) .OR. &
+    .NOT.ALL(HP(1:IBAR,1:JBAR,0)==HP(1:IBAR,1:JBAR,KBAR)) .OR. &
+    .NOT.ALL(HP(1:IBAR,1:JBAR,KBP1)==HP(1:IBAR,1:JBAR,1))) THEN
+   WRITE(LU_OUTPUT,'(A)') 'DEV136_POISSON_TRACE v=1 phase=post region=none error=periodic-ghost'
+   RETURN
+ENDIF
+
+COUNT=0; SUM_QR=0._EB; SUM_LH=0._EB; SUM_R0=0._EB; SUM_R02=0._EB; MAX_R0=0._EB
+SUM_RC=0._EB; SUM_RC2=0._EB; MAX_RC=0._EB
+DO K=1,KBAR
+   DO J=1,JBAR
+      DO I=1,IBAR
+         QF=(R(I-1)*FVX(I-1,J,K)-R(I)*FVX(I,J,K))*RDX(I)*RRN(I) + &
+            (FVY(I,J-1,K)-FVY(I,J,K))*RDY(J) + (FVZ(I,J,K-1)-FVZ(I,J,K))*RDZ(K)
+         QD=-DDDT(I,J,K); QR=QF+QD
+         LH=((HP(I+1,J,K)-HP(I,J,K))*RDXN(I)*R(I) - &
+             (HP(I,J,K)-HP(I-1,J,K))*RDXN(I-1)*R(I-1))*RDX(I)*RRN(I) + &
+            ((HP(I,J+1,K)-HP(I,J,K))*RDYN(J) - &
+             (HP(I,J,K)-HP(I,J-1,K))*RDYN(J-1))*RDY(J) + &
+            ((HP(I,J,K+1)-HP(I,J,K))*RDZN(K) - &
+             (HP(I,J,K)-HP(I,J,K-1))*RDZN(K-1))*RDZ(K)
+         R0=LH-QR; RC=LH-(QR-POIS_PTB)
+         CALL DEV136_ADD_POST(1,QR,LH,R0,RC,SUM_QR,SUM_LH,SUM_R0,SUM_R02,MAX_R0, &
+                              SUM_RC,SUM_RC2,MAX_RC,COUNT)
+         IF (I==1 .OR. I==IBAR .OR. K==1 .OR. K==KBAR) THEN
+            IR=2
+         ELSE
+            IR=3
+         ENDIF
+         CALL DEV136_ADD_POST(IR,QR,LH,R0,RC,SUM_QR,SUM_LH,SUM_R0,SUM_R02,MAX_R0, &
+                              SUM_RC,SUM_RC2,MAX_RC,COUNT)
+      ENDDO
+   ENDDO
+ENDDO
+DO IR=1,3
+   LINE=TRIM(DEV136_PREFIX('post',REGION(IR)))//' CELL_COUNT='//TRIM(DEV135_INT(COUNT(IR)))// &
+        ' QR_MEAN='//TRIM(DEV135_REAL(SUM_QR(IR)/REAL(COUNT(IR),EB)))// &
+        ' LH_MEAN='//TRIM(DEV135_REAL(SUM_LH(IR)/REAL(COUNT(IR),EB)))// &
+        ' POIS_PTB='//TRIM(DEV135_REAL(POIS_PTB))// &
+        ' R0_MEAN='//TRIM(DEV135_REAL(SUM_R0(IR)/REAL(COUNT(IR),EB)))// &
+        ' R0_RMS='//TRIM(DEV135_REAL(SQRT(SUM_R02(IR)/REAL(COUNT(IR),EB))))// &
+        ' R0_LINF='//TRIM(DEV135_REAL(MAX_R0(IR)))// &
+        ' RC_MEAN='//TRIM(DEV135_REAL(SUM_RC(IR)/REAL(COUNT(IR),EB)))// &
+        ' RC_RMS='//TRIM(DEV135_REAL(SQRT(SUM_RC2(IR)/REAL(COUNT(IR),EB))))// &
+        ' RC_LINF='//TRIM(DEV135_REAL(MAX_RC(IR)))
+   WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+ENDDO
+END SUBROUTINE DEV136_TRACE_POST
+
+
+! DEV-138 reads only the just-returned FISHPAK payload and caller arrays.
+! It is entered only for the inherited six-event, TWO_D x-z H2CZSS call.
+CHARACTER(LEN=2048) FUNCTION DEV138_PREFIX(RECORD,REGION)
+USE GLOBAL_CONSTANTS, ONLY: MY_RANK
+CHARACTER(LEN=*), INTENT(IN) :: RECORD,REGION
+CHARACTER(LEN=16) :: STAGE
+IF (DEV135_TRACE_PREDICTOR) THEN
+   STAGE='predictor'
+ELSE
+   STAGE='corrector'
+ENDIF
+DEV138_PREFIX='DEV138_'//TRIM(RECORD)//' v=1 region='//TRIM(REGION)//' role='//TRIM(DEV135_TRACE_ROLE)// &
+   ' ICYC='//TRIM(DEV135_INT(DEV135_TRACE_ICYC))//' stage='//TRIM(STAGE)// &
+   ' pressure_iteration='//TRIM(DEV135_INT(DEV135_TRACE_ITERATION))//' rank='//TRIM(DEV135_INT(MY_RANK))// &
+   ' mesh=1 steps='//TRIM(DEV135_INT(DEV135_TRACE_STEPS))//' target_cycle='//TRIM(DEV135_INT(DEV135_TRACE_TARGET))// &
+   ' T_ARG='//TRIM(DEV135_REAL(DEV135_TRACE_T_ARG))//' DT='//TRIM(DEV135_REAL(DEV135_TRACE_DT_ARG))
+END FUNCTION DEV138_PREFIX
+
+
+SUBROUTINE DEV138_TRACE_POST(NM,S,PROBE)
+USE GLOBAL_CONSTANTS, ONLY: LU_OUTPUT,PREDICTOR,TWO_D
+INTEGER, INTENT(IN) :: NM
+REAL(EB), INTENT(IN) :: S(29),PROBE(5,4)
+INTEGER :: I,J,K,IR,P,COUNT(3),IP(4),KP(4),STEPS,N_TARGET
+REAL(EB), POINTER, DIMENSION(:,:,:) :: HP
+REAL(EB) :: Q(8,3),Q2(8,3),QM(8,3),V(8),LHX,LHY,LHZ,QF,QD,QR,RXZ,RXYZ
+CHARACTER(LEN=4096) :: LINE
+CHARACTER(LEN=24) :: ROLE
+CHARACTER(LEN=16), PARAMETER :: REGION(3)=[CHARACTER(LEN=16) :: 'all','belt','strict']
+IP=[1,32,64,96]; KP=[1,32,64,96]
+IF (.NOT.DEV135_TRACE_VALID) RETURN
+IF (.NOT.DEV135_EVENT_GATE(NM,DEV135_TRACE_T_ARG,DEV135_TRACE_DT_ARG,STEPS,N_TARGET,ROLE)) RETURN
+IF (.NOT.DEV136_EXTRA_GATE(NM)) RETURN
+IF (LBC/=0 .OR. MBC/=0 .OR. NBC/=0 .OR. .NOT.TWO_D) RETURN
+IF (PREDICTOR) THEN; HP=>H; ELSE; HP=>HS; ENDIF
+
+LINE=TRIM(DEV138_PREFIX('FISH_TRACE','all'))//' L='//TRIM(DEV135_INT(NINT(S(1))))//' M='//TRIM(DEV135_INT(NINT(S(2))))// &
+ ' LDIMF='//TRIM(DEV135_INT(NINT(S(3))))//' LP='//TRIM(DEV135_INT(NINT(S(4))))//' MP='//TRIM(DEV135_INT(NINT(S(5))))// &
+ ' H_MIN='//TRIM(DEV135_REAL(S(6)))//' H_MAX='//TRIM(DEV135_REAL(S(7)))//' H_SUM='//TRIM(DEV135_REAL(S(8)))// &
+ ' RHS_RAW_MEAN='//TRIM(DEV135_REAL(S(9)))//' RHS_RAW_RMS='//TRIM(DEV135_REAL(S(10)))// &
+ ' RHS_RAW_LINF='//TRIM(DEV135_REAL(S(11)))//' RHS_RAW_WMEAN='//TRIM(DEV135_REAL(S(12)))// &
+ ' RHS_CORR_MEAN='//TRIM(DEV135_REAL(S(13)))//' RHS_CORR_RMS='//TRIM(DEV135_REAL(S(14)))// &
+ ' RHS_CORR_LINF='//TRIM(DEV135_REAL(S(15)))//' PERT='//TRIM(DEV135_REAL(S(16)))//' PERTRB='//TRIM(DEV135_REAL(S(17)))// &
+ ' SOL_MEAN='//TRIM(DEV135_REAL(S(18)))//' SOL_RMS='//TRIM(DEV135_REAL(S(19)))//' SOL_LINF='//TRIM(DEV135_REAL(S(20)))// &
+ ' A_SOL_MEAN='//TRIM(DEV135_REAL(S(21)))//' A_SOL_RMS='//TRIM(DEV135_REAL(S(22)))//' A_SOL_LINF='//TRIM(DEV135_REAL(S(23)))// &
+ ' POS_MEAN='//TRIM(DEV135_REAL(S(24)))//' POS_RMS='//TRIM(DEV135_REAL(S(25)))//' POS_LINF='//TRIM(DEV135_REAL(S(26)))// &
+ ' NEG_MEAN='//TRIM(DEV135_REAL(S(27)))//' NEG_RMS='//TRIM(DEV135_REAL(S(28)))//' NEG_LINF='//TRIM(DEV135_REAL(S(29)))
+DO P=1,4
+   LINE=TRIM(LINE)//' P'//TRIM(DEV135_INT(P))//'_RAW='//TRIM(DEV135_REAL(PROBE(1,P)))// &
+      ' P'//TRIM(DEV135_INT(P))//'_CORR='//TRIM(DEV135_REAL(PROBE(2,P)))// &
+      ' P'//TRIM(DEV135_INT(P))//'_SOL='//TRIM(DEV135_REAL(PROBE(3,P)))// &
+      ' P'//TRIM(DEV135_INT(P))//'_ASOL='//TRIM(DEV135_REAL(PROBE(4,P)))// &
+      ' P'//TRIM(DEV135_INT(P))//'_POS='//TRIM(DEV135_REAL(PROBE(5,P)))
+ENDDO
+WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+
+COUNT=0; Q=0._EB; Q2=0._EB; QM=0._EB
+DO K=1,KBAR
+ DO J=1,JBAR
+  DO I=1,IBAR
+   LHX=((HP(I+1,J,K)-HP(I,J,K))*RDXN(I)*R(I)-(HP(I,J,K)-HP(I-1,J,K))*RDXN(I-1)*R(I-1))*RDX(I)*RRN(I)
+   LHY=((HP(I,J+1,K)-HP(I,J,K))*RDYN(J)-(HP(I,J,K)-HP(I,J-1,K))*RDYN(J-1))*RDY(J)
+   LHZ=((HP(I,J,K+1)-HP(I,J,K))*RDZN(K)-(HP(I,J,K)-HP(I,J,K-1))*RDZN(K-1))*RDZ(K)
+   QF=(R(I-1)*FVX(I-1,J,K)-R(I)*FVX(I,J,K))*RDX(I)*RRN(I) + &
+      (FVY(I,J-1,K)-FVY(I,J,K))*RDY(J) + (FVZ(I,J,K-1)-FVZ(I,J,K))*RDZ(K)
+   QD=-DDDT(I,J,K); QR=QF+QD
+   RXZ=(LHX+LHZ)-(QR-S(17)); RXYZ=(LHX+LHY+LHZ)-(QR-S(17))
+   DO IR=1,3
+    IF (IR==1 .OR. (IR==2 .AND. (I==1 .OR. I==IBAR .OR. K==1 .OR. K==KBAR)) .OR. &
+        (IR==3 .AND. I/=1 .AND. I/=IBAR .AND. K/=1 .AND. K/=KBAR)) THEN
+     COUNT(IR)=COUNT(IR)+1
+     V=[HP(I,J,K)-PRHS(I,J,K),HP(I,0,K)-HP(I,1,K),HP(I,JBP1,K)-HP(I,1,K),LHX,LHY,LHZ,RXZ,RXYZ]
+     Q(:,IR)=Q(:,IR)+V; Q2(:,IR)=Q2(:,IR)+V**2; QM(:,IR)=MAX(QM(:,IR),ABS(V))
+    ENDIF
+   ENDDO
+  ENDDO
+ ENDDO
+ENDDO
+DO IR=1,3
+ LINE=TRIM(DEV138_PREFIX('MAP_TRACE',REGION(IR)))//' CELL_COUNT='//TRIM(DEV135_INT(COUNT(IR)))//' JBAR='//TRIM(DEV135_INT(JBAR))// &
+  ' TWO_D='//TRIM(DEV135_INT(MERGE(1,0,TWO_D)))//' LBC='//TRIM(DEV135_INT(LBC))// &
+  ' MBC='//TRIM(DEV135_INT(MBC))//' NBC='//TRIM(DEV135_INT(NBC))// &
+  ' ITRN='//TRIM(DEV135_INT(ITRN))//' JTRN='//TRIM(DEV135_INT(JTRN))//' KTRN='//TRIM(DEV135_INT(KTRN))
+ DO P=1,8
+  LINE=TRIM(LINE)//' Q'//TRIM(DEV135_INT(P))//'_MEAN='//TRIM(DEV135_REAL(Q(P,IR)/REAL(COUNT(IR),EB)))// &
+   ' Q'//TRIM(DEV135_INT(P))//'_RMS='//TRIM(DEV135_REAL(SQRT(Q2(P,IR)/REAL(COUNT(IR),EB))))// &
+   ' Q'//TRIM(DEV135_INT(P))//'_LINF='//TRIM(DEV135_REAL(QM(P,IR)))
+ ENDDO
+ DO P=1,4
+  I=IP(P); K=KP(P)
+  LHX=((HP(I+1,1,K)-HP(I,1,K))*RDXN(I)*R(I)-(HP(I,1,K)-HP(I-1,1,K))*RDXN(I-1)*R(I-1))*RDX(I)*RRN(I)
+  LHY=((HP(I,2,K)-HP(I,1,K))*RDYN(1)-(HP(I,1,K)-HP(I,0,K))*RDYN(0))*RDY(1)
+  LHZ=((HP(I,1,K+1)-HP(I,1,K))*RDZN(K)-(HP(I,1,K)-HP(I,1,K-1))*RDZN(K-1))*RDZ(K)
+  QF=(R(I-1)*FVX(I-1,1,K)-R(I)*FVX(I,1,K))*RDX(I)*RRN(I) + &
+     (FVY(I,0,K)-FVY(I,1,K))*RDY(1) + (FVZ(I,1,K-1)-FVZ(I,1,K))*RDZ(K)
+  QD=-DDDT(I,1,K); QR=QF+QD; RXZ=(LHX+LHZ)-(QR-S(17)); RXYZ=RXZ+LHY
+  LINE=TRIM(LINE)//' P'//TRIM(DEV135_INT(P))//'_PRHS='//TRIM(DEV135_REAL(PRHS(I,1,K)))// &
+   ' P'//TRIM(DEV135_INT(P))//'_HP='//TRIM(DEV135_REAL(HP(I,1,K)))// &
+   ' P'//TRIM(DEV135_INT(P))//'_LHX='//TRIM(DEV135_REAL(LHX))//' P'//TRIM(DEV135_INT(P))//'_LHY='//TRIM(DEV135_REAL(LHY))// &
+   ' P'//TRIM(DEV135_INT(P))//'_LHZ='//TRIM(DEV135_REAL(LHZ))//' P'//TRIM(DEV135_INT(P))//'_RXZ='//TRIM(DEV135_REAL(RXZ))// &
+   ' P'//TRIM(DEV135_INT(P))//'_RXYZ='//TRIM(DEV135_REAL(RXYZ))
+ ENDDO
+ WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+ENDDO
+END SUBROUTINE DEV138_TRACE_POST
+
