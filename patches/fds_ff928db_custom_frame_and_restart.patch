+LOGICAL FUNCTION DEV135_EVENT_GATE(NM,T_ARG,DT_ARG,STEPS,N_TARGET,ROLE)
+USE GLOBAL_CONSTANTS, ONLY: BAROCLINIC,CC_IBM,CORRECTOR,DT_INITIAL,FFT_FLAG,FREEZE_VELOCITY,ICYC, &
+                            INITIALIZATION_PHASE,ITERATE_PRESSURE,LEVEL_SET_MODE,MY_RANK,NMESHES, &
+                            N_MPI_PROCESSES,PHYSICAL_PRESSURE_GAUGE,PREDICTOR,PRES_FLAG,PRESSURE_ITERATIONS, &
+                            PERIODIC_TEST,SOLID_PHASE_ONLY,TRANSLATING_FRAME,TUNNEL_PRECONDITIONER,TWO_D
+INTEGER, INTENT(IN) :: NM
+INTEGER, INTENT(OUT) :: STEPS,N_TARGET
+REAL(EB), INTENT(IN) :: T_ARG,DT_ARG
+CHARACTER(LEN=24), INTENT(OUT) :: ROLE
+LOGICAL :: ADMITTED_EVENT,ADMITTED_STEP
+
+CALL POINT_TO_MESH(NM)
+STEPS=NINT(1._EB/DT_INITIAL)
+ADMITTED_STEP=ANY(STEPS==[1920,3840,7680,15360]) .AND. &
+               DT_INITIAL==1._EB/REAL(STEPS,EB) .AND. DT_ARG==DT_INITIAL
+N_TARGET=STEPS/4
+ROLE='invalid'
+ADMITTED_EVENT=.FALSE.
+IF (ICYC==1 .AND. PREDICTOR) THEN
+   ROLE='startup-1-predictor'; ADMITTED_EVENT=.TRUE.
+ELSEIF (ICYC==1 .AND. CORRECTOR) THEN
+   ROLE='startup-1-corrector'; ADMITTED_EVENT=.TRUE.
+ELSEIF (ICYC==2 .AND. PREDICTOR) THEN
+   ROLE='startup-2-predictor'; ADMITTED_EVENT=.TRUE.
+ELSEIF (ICYC==2 .AND. CORRECTOR) THEN
+   ROLE='startup-2-corrector'; ADMITTED_EVENT=.TRUE.
+ELSEIF (ICYC==N_TARGET .AND. CORRECTOR) THEN
+   ROLE='target-corrector'; ADMITTED_EVENT=.TRUE.
+ELSEIF (ICYC==N_TARGET+1 .AND. PREDICTOR) THEN
+   ROLE='target-predictor'; ADMITTED_EVENT=.TRUE.
+ENDIF
+DEV135_EVENT_GATE=ADMITTED_STEP .AND. ADMITTED_EVENT .AND. .NOT.INITIALIZATION_PHASE .AND. &
+                  PERIODIC_TEST==1 .AND. NMESHES==1 .AND. N_MPI_PROCESSES==1 .AND. MY_RANK==0 .AND. NM==1 .AND. &
+                  IBAR==128 .AND. JBAR==1 .AND. KBAR==128 .AND. TWO_D .AND. .NOT.CC_IBM .AND. &
+                  .NOT.TRANSLATING_FRAME .AND. .NOT.SOLID_PHASE_ONLY .AND. .NOT.FREEZE_VELOCITY .AND. &
+                  LEVEL_SET_MODE/=1 .AND. PRES_FLAG==FFT_FLAG .AND. ITERATE_PRESSURE .AND. &
+                  PRESSURE_ITERATIONS==1 .AND. .NOT.BAROCLINIC .AND. .NOT.PHYSICAL_PRESSURE_GAUGE .AND. &
+                  .NOT.TUNNEL_PRECONDITIONER .AND. (PREDICTOR .NEQV. CORRECTOR) .AND. &
+                  IPS==0 .AND. LBC==0 .AND. MBC==0 .AND. NBC==0 .AND. &
+                  T_ARG==T_ARG
+END FUNCTION DEV135_EVENT_GATE
+
+
+CHARACTER(LEN=2048) FUNCTION DEV135_PREFIX(PHASE,RECORD,REGION)
+USE GLOBAL_CONSTANTS, ONLY: MY_RANK
+CHARACTER(LEN=*), INTENT(IN) :: PHASE,RECORD,REGION
+CHARACTER(LEN=16) :: STAGE
+CHARACTER(LEN=4096) :: LINE
+IF (DEV135_TRACE_PREDICTOR) THEN
+   STAGE='predictor'
+ELSE
+   STAGE='corrector'
+ENDIF
+LINE='DEV135_INTEGRATOR_TRACE v=1 record='//TRIM(RECORD)//' phase='//TRIM(PHASE)// &
+     ' region='//TRIM(REGION)//' role='//TRIM(DEV135_TRACE_ROLE)// &
+     ' ICYC='//TRIM(DEV135_INT(DEV135_TRACE_ICYC))//' stage='//TRIM(STAGE)// &
+     ' pressure_iteration='//TRIM(DEV135_INT(DEV135_TRACE_ITERATION))// &
+     ' rank='//TRIM(DEV135_INT(MY_RANK))//' mesh=1 steps='//TRIM(DEV135_INT(DEV135_TRACE_STEPS))// &
+     ' target_cycle='//TRIM(DEV135_INT(DEV135_TRACE_TARGET))// &
+     ' T_ARG='//TRIM(DEV135_REAL(DEV135_TRACE_T_ARG))// &
+     ' DT='//TRIM(DEV135_REAL(DEV135_TRACE_DT_ARG))// &
+     ' T_NEXT='//TRIM(DEV135_REAL(DEV135_TRACE_T_ARG+DEV135_TRACE_DT_ARG))
+DEV135_PREFIX=TRIM(LINE)
+END FUNCTION DEV135_PREFIX
+
+
+SUBROUTINE DEV135_ADD_CELL(IR,QF,QD,QR,CLOSURE,SUM_QF,SUM_QD,SUM_QR,SUM_C,MAX_QF,MAX_QD,MAX_QR,MAX_C,COUNT)
+INTEGER, INTENT(IN) :: IR
+INTEGER, INTENT(INOUT) :: COUNT(3)
+REAL(EB), INTENT(IN) :: QF,QD,QR,CLOSURE
+REAL(EB), INTENT(INOUT) :: SUM_QF(3),SUM_QD(3),SUM_QR(3),SUM_C(3),MAX_QF(3),MAX_QD(3),MAX_QR(3),MAX_C(3)
+COUNT(IR)=COUNT(IR)+1
+SUM_QF(IR)=SUM_QF(IR)+QF*QF
+SUM_QD(IR)=SUM_QD(IR)+QD*QD
+SUM_QR(IR)=SUM_QR(IR)+QR*QR
+SUM_C(IR)=SUM_C(IR)+CLOSURE*CLOSURE
+MAX_QF(IR)=MAX(MAX_QF(IR),ABS(QF))
+MAX_QD(IR)=MAX(MAX_QD(IR),ABS(QD))
+MAX_QR(IR)=MAX(MAX_QR(IR),ABS(QR))
+MAX_C(IR)=MAX(MAX_C(IR),ABS(CLOSURE))
+END SUBROUTINE DEV135_ADD_CELL
+
+
+SUBROUTINE DEV135_TRACE_PRE(T_ARG,DT_ARG,NM)
+USE GLOBAL_CONSTANTS, ONLY: CORRECTOR,ICYC,LU_OUTPUT,PREDICTOR,PRESSURE_ITERATIONS
+INTEGER, INTENT(IN) :: NM
+REAL(EB), INTENT(IN) :: T_ARG,DT_ARG
+INTEGER :: I,J,K,IR,STEPS,N_TARGET,COUNT(3),POINT_I(4),POINT_K(4),P
+REAL(EB) :: QF,QD,QR,CLOSURE
+REAL(EB) :: SUM_QF(3),SUM_QD(3),SUM_QR(3),SUM_C(3),MAX_QF(3),MAX_QD(3),MAX_QR(3),MAX_C(3)
+CHARACTER(LEN=24) :: ROLE
+CHARACTER(LEN=16), PARAMETER :: REGION(3)=[CHARACTER(LEN=16) :: 'all','belt','strict']
+CHARACTER(LEN=8192) :: LINE
+
+IF (.NOT.DEV135_EVENT_GATE(NM,T_ARG,DT_ARG,STEPS,N_TARGET,ROLE)) RETURN
+IF (DEV135_TRACE_VALID) THEN
+   WRITE(LU_OUTPUT,'(A)') 'DEV135_INTEGRATOR_TRACE v=1 record=error code=unmatched-pre'
+   RETURN
+ENDIF
+DEV135_TRACE_VALID=.TRUE.
+DEV135_TRACE_PREDICTOR=PREDICTOR
+DEV135_TRACE_CORRECTOR=CORRECTOR
+DEV135_TRACE_ICYC=ICYC
+DEV135_TRACE_ITERATION=PRESSURE_ITERATIONS
+DEV135_TRACE_STEPS=STEPS
+DEV135_TRACE_TARGET=N_TARGET
+DEV135_TRACE_T_ARG=T_ARG
+DEV135_TRACE_DT_ARG=DT_ARG
+DEV135_TRACE_ROLE=ROLE
+WRITE(LU_OUTPUT,'(A)') TRIM(DEV135_PREFIX('pre','event','none'))
+
+COUNT=0; SUM_QF=0._EB; SUM_QD=0._EB; SUM_QR=0._EB; SUM_C=0._EB
+MAX_QF=0._EB; MAX_QD=0._EB; MAX_QR=0._EB; MAX_C=0._EB
+DO K=1,KBAR
+   DO J=1,JBAR
+      DO I=1,IBAR
+         QF=(R(I-1)*FVX(I-1,J,K)-R(I)*FVX(I,J,K))*RDX(I)*RRN(I) + &
+            (FVY(I,J-1,K)-FVY(I,J,K))*RDY(J) + (FVZ(I,J,K-1)-FVZ(I,J,K))*RDZ(K)
+         QD=-DDDT(I,J,K)
+         QR=QF+QD
+         CLOSURE=PRHS(I,J,K)-QR
+         CALL DEV135_ADD_CELL(1,QF,QD,QR,CLOSURE,SUM_QF,SUM_QD,SUM_QR,SUM_C, &
+                              MAX_QF,MAX_QD,MAX_QR,MAX_C,COUNT)
+         IF (I==1 .OR. I==IBAR .OR. K==1 .OR. K==KBAR) THEN
+            IR=2
+         ELSE
+            IR=3
+         ENDIF
+         CALL DEV135_ADD_CELL(IR,QF,QD,QR,CLOSURE,SUM_QF,SUM_QD,SUM_QR,SUM_C, &
+                              MAX_QF,MAX_QD,MAX_QR,MAX_C,COUNT)
+      ENDDO
+   ENDDO
+ENDDO
+DO IR=1,3
+   LINE=TRIM(DEV135_PREFIX('pre','region',REGION(IR)))// &
+        ' CELL_COUNT='//TRIM(DEV135_INT(COUNT(IR)))// &
+        ' QF_RMS='//TRIM(DEV135_REAL(SQRT(SUM_QF(IR)/REAL(COUNT(IR),EB))))// &
+        ' QF_LINF='//TRIM(DEV135_REAL(MAX_QF(IR)))// &
+        ' QD_RMS='//TRIM(DEV135_REAL(SQRT(SUM_QD(IR)/REAL(COUNT(IR),EB))))// &
+        ' QD_LINF='//TRIM(DEV135_REAL(MAX_QD(IR)))// &
+        ' QR_RMS='//TRIM(DEV135_REAL(SQRT(SUM_QR(IR)/REAL(COUNT(IR),EB))))// &
+        ' QR_LINF='//TRIM(DEV135_REAL(MAX_QR(IR)))// &
+        ' ALG_RMS='//TRIM(DEV135_REAL(SQRT(SUM_C(IR)/REAL(COUNT(IR),EB))))// &
+        ' ALG_LINF='//TRIM(DEV135_REAL(MAX_C(IR)))
+   WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+ENDDO
+
+POINT_I=[16,48,80,112]; POINT_K=[16,48,80,112]
+LINE=TRIM(DEV135_PREFIX('pre','fingerprint','strict'))
+DO P=1,4
+   I=POINT_I(P); J=1; K=POINT_K(P)
+   QF=(R(I-1)*FVX(I-1,J,K)-R(I)*FVX(I,J,K))*RDX(I)*RRN(I) + &
+      (FVY(I,J-1,K)-FVY(I,J,K))*RDY(J) + (FVZ(I,J,K-1)-FVZ(I,J,K))*RDZ(K)
+   QD=-DDDT(I,J,K); QR=QF+QD; CLOSURE=PRHS(I,J,K)-QR
+   LINE=TRIM(LINE)//' F'//TRIM(DEV135_INT(4*P-3))//'='//TRIM(DEV135_REAL(QF))// &
+        ' F'//TRIM(DEV135_INT(4*P-2))//'='//TRIM(DEV135_REAL(QD))// &
+        ' F'//TRIM(DEV135_INT(4*P-1))//'='//TRIM(DEV135_REAL(QR))// &
+        ' F'//TRIM(DEV135_INT(4*P  ))//'='//TRIM(DEV135_REAL(CLOSURE))
+ENDDO
+WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+END SUBROUTINE DEV135_TRACE_PRE
+
+
+REAL(EB) FUNCTION DEV135_DUDT(XX,ZZ,TT)
+REAL(EB), INTENT(IN) :: XX,ZZ,TT
+REAL(EB) :: EX,T1,T2
+EX=EXP(-0.2_EB*TT)
+T1=XX-TT; T2=ZZ-TT
+DEV135_DUDT=-2._EB*EX*(SIN(T1)*SIN(T2)-COS(T1)*COS(T2)-0.2_EB*COS(T1)*SIN(T2))
+END FUNCTION DEV135_DUDT
+
+
+REAL(EB) FUNCTION DEV135_DWDT(XX,ZZ,TT)
+REAL(EB), INTENT(IN) :: XX,ZZ,TT
+REAL(EB) :: EX,T1,T2
+EX=EXP(-0.2_EB*TT)
+T1=XX-TT; T2=ZZ-TT
+DEV135_DWDT=2._EB*EX*(-COS(T1)*COS(T2)+SIN(T1)*SIN(T2)-0.2_EB*SIN(T1)*COS(T2))
+END FUNCTION DEV135_DWDT
+
+
+SUBROUTINE DEV135_ADD_POST_CELL(IR,QR,POIS,LEX,SUM_QR,SUM_POIS,SUM_LEX,MAX_QR,MAX_POIS,MAX_LEX,COUNT)
+INTEGER, INTENT(IN) :: IR
+INTEGER, INTENT(INOUT) :: COUNT(3)
+REAL(EB), INTENT(IN) :: QR,POIS,LEX(3)
+REAL(EB), INTENT(INOUT) :: SUM_QR(3),SUM_POIS(3),SUM_LEX(3,3),MAX_QR(3),MAX_POIS(3),MAX_LEX(3,3)
+INTEGER :: IH
+COUNT(IR)=COUNT(IR)+1
+SUM_QR(IR)=SUM_QR(IR)+QR*QR
+SUM_POIS(IR)=SUM_POIS(IR)+POIS*POIS
+MAX_QR(IR)=MAX(MAX_QR(IR),ABS(QR))
+MAX_POIS(IR)=MAX(MAX_POIS(IR),ABS(POIS))
+DO IH=1,3
+   SUM_LEX(IH,IR)=SUM_LEX(IH,IR)+LEX(IH)*LEX(IH)
+   MAX_LEX(IH,IR)=MAX(MAX_LEX(IH,IR),ABS(LEX(IH)))
+ENDDO
+END SUBROUTINE DEV135_ADD_POST_CELL
+
+
+SUBROUTINE DEV135_ADD_POST_FACE(IR,GERR,AERR,SUM_G,SUM_A,MAX_G,MAX_A,COUNT)
+INTEGER, INTENT(IN) :: IR
+INTEGER, INTENT(INOUT) :: COUNT(3)
+REAL(EB), INTENT(IN) :: GERR(3),AERR(3)
+REAL(EB), INTENT(INOUT) :: SUM_G(3,3),SUM_A(3,3),MAX_G(3,3),MAX_A(3,3)
+INTEGER :: IH
+COUNT(IR)=COUNT(IR)+1
+DO IH=1,3
+   SUM_G(IH,IR)=SUM_G(IH,IR)+GERR(IH)*GERR(IH)
+   SUM_A(IH,IR)=SUM_A(IH,IR)+AERR(IH)*AERR(IH)
+   MAX_G(IH,IR)=MAX(MAX_G(IH,IR),ABS(GERR(IH)))
+   MAX_A(IH,IR)=MAX(MAX_A(IH,IR),ABS(AERR(IH)))
+ENDDO
+END SUBROUTINE DEV135_ADD_POST_FACE
+
+
+SUBROUTINE DEV135_TRACE_POST(NM)
+USE GLOBAL_CONSTANTS, ONLY: CORRECTOR,ICYC,LU_OUTPUT,PREDICTOR,PRESSURE_ITERATIONS
+USE TURBULENCE, ONLY: NS_H_EXACT
+INTEGER, INTENT(IN) :: NM
+INTEGER :: I,J,K,IR,IH,STEPS,N_TARGET,CELL_COUNT(3),FACE_COUNT(3),P
+INTEGER :: XI(2),XK(2),ZI(2),ZK(2)
+REAL(EB), POINTER, DIMENSION(:,:,:) :: HP
+REAL(EB) :: QF,QD,QR,LH,POIS,LEX(3),TH(3),H0,HXP,HXM,HZP,HZM
+REAL(EB) :: GRAD,NUM_A,GEX,AEX,GERR(3),AERR(3),TNATIVE
+REAL(EB) :: SUM_QR(3),SUM_POIS(3),SUM_LEX(3,3),MAX_QR(3),MAX_POIS(3),MAX_LEX(3,3)
+REAL(EB) :: SUM_G(3,3),SUM_A(3,3),MAX_G(3,3),MAX_A(3,3)
+CHARACTER(LEN=24) :: ROLE
+CHARACTER(LEN=16), PARAMETER :: REGION(3)=[CHARACTER(LEN=16) :: 'all','belt','strict']
+CHARACTER(LEN=8192) :: LINE
+
+IF (.NOT.DEV135_EVENT_GATE(NM,DEV135_TRACE_T_ARG,DEV135_TRACE_DT_ARG,STEPS,N_TARGET,ROLE)) RETURN
+IF (.NOT.DEV135_TRACE_VALID) THEN
+   WRITE(LU_OUTPUT,'(A)') 'DEV135_INTEGRATOR_TRACE v=1 record=error code=post-without-pre'
+   RETURN
+ENDIF
+IF (ICYC/=DEV135_TRACE_ICYC .OR. PRESSURE_ITERATIONS/=DEV135_TRACE_ITERATION .OR. &
+    PREDICTOR.NEQV.DEV135_TRACE_PREDICTOR .OR. CORRECTOR.NEQV.DEV135_TRACE_CORRECTOR .OR. &
+    STEPS/=DEV135_TRACE_STEPS .OR. N_TARGET/=DEV135_TRACE_TARGET .OR. ROLE/=DEV135_TRACE_ROLE) THEN
+   WRITE(LU_OUTPUT,'(A)') 'DEV135_INTEGRATOR_TRACE v=1 record=error code=pre-post-tuple-mismatch'
+   DEV135_TRACE_VALID=.FALSE.
+   RETURN
+ENDIF
+IF (PREDICTOR) THEN
+   HP=>H
+   TH=[DEV135_TRACE_T_ARG,DEV135_TRACE_T_ARG+0.5_EB*DEV135_TRACE_DT_ARG, &
+       DEV135_TRACE_T_ARG+DEV135_TRACE_DT_ARG]
+   TNATIVE=TH(1)
+ELSE
+   HP=>HS
+   TH=[DEV135_TRACE_T_ARG-DEV135_TRACE_DT_ARG,DEV135_TRACE_T_ARG-0.5_EB*DEV135_TRACE_DT_ARG, &
+       DEV135_TRACE_T_ARG]
+   TNATIVE=TH(3)
+ENDIF
+IF (.NOT.ALL(HP(0,1:JBAR,1:KBAR)==HP(IBAR,1:JBAR,1:KBAR)) .OR. &
+    .NOT.ALL(HP(IBP1,1:JBAR,1:KBAR)==HP(1,1:JBAR,1:KBAR)) .OR. &
+    .NOT.ALL(HP(1:IBAR,1:JBAR,0)==HP(1:IBAR,1:JBAR,KBAR)) .OR. &
+    .NOT.ALL(HP(1:IBAR,1:JBAR,KBP1)==HP(1:IBAR,1:JBAR,1))) THEN
+   WRITE(LU_OUTPUT,'(A)') 'DEV135_INTEGRATOR_TRACE v=1 record=error code=periodic-ghost-mismatch'
+   DEV135_TRACE_VALID=.FALSE.
+   RETURN
+ENDIF
+WRITE(LU_OUTPUT,'(A)') TRIM(DEV135_PREFIX('post','event','none'))
+
+CELL_COUNT=0; FACE_COUNT=0
+SUM_QR=0._EB; SUM_POIS=0._EB; SUM_LEX=0._EB
+MAX_QR=0._EB; MAX_POIS=0._EB; MAX_LEX=0._EB
+SUM_G=0._EB; SUM_A=0._EB; MAX_G=0._EB; MAX_A=0._EB
+DO K=1,KBAR
+   DO J=1,JBAR
+      DO I=1,IBAR
+         QF=(R(I-1)*FVX(I-1,J,K)-R(I)*FVX(I,J,K))*RDX(I)*RRN(I) + &
+            (FVY(I,J-1,K)-FVY(I,J,K))*RDY(J) + (FVZ(I,J,K-1)-FVZ(I,J,K))*RDZ(K)
+         QD=-DDDT(I,J,K); QR=QF+QD
+         LH=((HP(I+1,J,K)-HP(I,J,K))*RDXN(I)*R(I) - &
+             (HP(I,J,K)-HP(I-1,J,K))*RDXN(I-1)*R(I-1))*RDX(I)*RRN(I) + &
+            ((HP(I,J+1,K)-HP(I,J,K))*RDYN(J) - &
+             (HP(I,J,K)-HP(I,J-1,K))*RDYN(J-1))*RDY(J) + &
+            ((HP(I,J,K+1)-HP(I,J,K))*RDZN(K) - &
+             (HP(I,J,K)-HP(I,J,K-1))*RDZN(K-1))*RDZ(K)
+         POIS=LH-QR
+         DO IH=1,3
+            H0=NS_H_EXACT(XC(I),ZC(K),TH(IH),0.1_EB,1._EB,2._EB)
+            HXP=NS_H_EXACT(XC(I+1),ZC(K),TH(IH),0.1_EB,1._EB,2._EB)
+            HXM=NS_H_EXACT(XC(I-1),ZC(K),TH(IH),0.1_EB,1._EB,2._EB)
+            HZP=NS_H_EXACT(XC(I),ZC(K+1),TH(IH),0.1_EB,1._EB,2._EB)
+            HZM=NS_H_EXACT(XC(I),ZC(K-1),TH(IH),0.1_EB,1._EB,2._EB)
+            LEX(IH)=((HXP-H0)*RDXN(I)*R(I)-(H0-HXM)*RDXN(I-1)*R(I-1))*RDX(I)*RRN(I) + &
+                    ((HZP-H0)*RDZN(K)-(H0-HZM)*RDZN(K-1))*RDZ(K)-QR
+         ENDDO
+         CALL DEV135_ADD_POST_CELL(1,QR,POIS,LEX,SUM_QR,SUM_POIS,SUM_LEX,MAX_QR,MAX_POIS,MAX_LEX,CELL_COUNT)
+         IF (I==1 .OR. I==IBAR .OR. K==1 .OR. K==KBAR) THEN
+            IR=2
+         ELSE
+            IR=3
+         ENDIF
+         CALL DEV135_ADD_POST_CELL(IR,QR,POIS,LEX,SUM_QR,SUM_POIS,SUM_LEX,MAX_QR,MAX_POIS,MAX_LEX,CELL_COUNT)
+      ENDDO
+   ENDDO
+ENDDO
+
+DO K=1,KBAR
+   DO J=1,JBAR
+      DO I=0,IBAR
+         GRAD=RDXN(I)*(HP(I+1,J,K)-HP(I,J,K)); NUM_A=-(FVX(I,J,K)+GRAD)
+         DO IH=1,3
+            GEX=RDXN(I)*(NS_H_EXACT(XC(I+1),ZC(K),TH(IH),0.1_EB,1._EB,2._EB) - &
+                           NS_H_EXACT(XC(I),ZC(K),TH(IH),0.1_EB,1._EB,2._EB))
+            AEX=DEV135_DUDT(X(I),ZC(K),TH(IH)); GERR(IH)=GRAD-GEX; AERR(IH)=NUM_A-AEX
+         ENDDO
+         CALL DEV135_ADD_POST_FACE(1,GERR,AERR,SUM_G,SUM_A,MAX_G,MAX_A,FACE_COUNT)
+         IF (I==0 .OR. I==IBAR .OR. K==1 .OR. K==KBAR) THEN
+            IR=2
+         ELSE
+            IR=3
+         ENDIF
+         CALL DEV135_ADD_POST_FACE(IR,GERR,AERR,SUM_G,SUM_A,MAX_G,MAX_A,FACE_COUNT)
+      ENDDO
+   ENDDO
+ENDDO
+DO K=0,KBAR
+   DO J=1,JBAR
+      DO I=1,IBAR
+         GRAD=RDZN(K)*(HP(I,J,K+1)-HP(I,J,K)); NUM_A=-(FVZ(I,J,K)+GRAD)
+         DO IH=1,3
+            GEX=RDZN(K)*(NS_H_EXACT(XC(I),ZC(K+1),TH(IH),0.1_EB,1._EB,2._EB) - &
+                          NS_H_EXACT(XC(I),ZC(K),TH(IH),0.1_EB,1._EB,2._EB))
+            AEX=DEV135_DWDT(XC(I),Z(K),TH(IH)); GERR(IH)=GRAD-GEX; AERR(IH)=NUM_A-AEX
+         ENDDO
+         CALL DEV135_ADD_POST_FACE(1,GERR,AERR,SUM_G,SUM_A,MAX_G,MAX_A,FACE_COUNT)
+         IF (K==0 .OR. K==KBAR .OR. I==1 .OR. I==IBAR) THEN
+            IR=2
+         ELSE
+            IR=3
+         ENDIF
+         CALL DEV135_ADD_POST_FACE(IR,GERR,AERR,SUM_G,SUM_A,MAX_G,MAX_A,FACE_COUNT)
+      ENDDO
+   ENDDO
+ENDDO
+
+DO IR=1,3
+   LINE=TRIM(DEV135_PREFIX('post','region',REGION(IR)))// &
+        ' CELL_COUNT='//TRIM(DEV135_INT(CELL_COUNT(IR)))// &
+        ' FACE_COUNT='//TRIM(DEV135_INT(FACE_COUNT(IR)))// &
+        ' QR_RMS='//TRIM(DEV135_REAL(SQRT(SUM_QR(IR)/REAL(CELL_COUNT(IR),EB))))// &
+        ' QR_LINF='//TRIM(DEV135_REAL(MAX_QR(IR)))// &
+        ' POIS_RMS='//TRIM(DEV135_REAL(SQRT(SUM_POIS(IR)/REAL(CELL_COUNT(IR),EB))))// &
+        ' POIS_LINF='//TRIM(DEV135_REAL(MAX_POIS(IR)))
+   DO IH=1,3
+      LINE=TRIM(LINE)//' LEX'//TRIM(DEV135_INT(IH))//'_RMS='// &
+           TRIM(DEV135_REAL(SQRT(SUM_LEX(IH,IR)/REAL(CELL_COUNT(IR),EB))))// &
+           ' LEX'//TRIM(DEV135_INT(IH))//'_LINF='//TRIM(DEV135_REAL(MAX_LEX(IH,IR)))// &
+           ' GERR'//TRIM(DEV135_INT(IH))//'_RMS='// &
+           TRIM(DEV135_REAL(SQRT(SUM_G(IH,IR)/REAL(FACE_COUNT(IR),EB))))// &
+           ' GERR'//TRIM(DEV135_INT(IH))//'_LINF='//TRIM(DEV135_REAL(MAX_G(IH,IR)))// &
+           ' AERR'//TRIM(DEV135_INT(IH))//'_RMS='// &
+           TRIM(DEV135_REAL(SQRT(SUM_A(IH,IR)/REAL(FACE_COUNT(IR),EB))))// &
+           ' AERR'//TRIM(DEV135_INT(IH))//'_LINF='//TRIM(DEV135_REAL(MAX_A(IH,IR)))
+   ENDDO
+   WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+ENDDO
+
+XI=[16,48]; XK=[32,64]; ZI=[32,64]; ZK=[16,48]
+LINE=TRIM(DEV135_PREFIX('post','fingerprint','strict'))
+DO P=1,2
+   I=XI(P); J=1; K=XK(P)
+   GRAD=RDXN(I)*(HP(I+1,J,K)-HP(I,J,K)); NUM_A=-(FVX(I,J,K)+GRAD)
+   GEX=RDXN(I)*(NS_H_EXACT(XC(I+1),ZC(K),TNATIVE,0.1_EB,1._EB,2._EB) - &
+                  NS_H_EXACT(XC(I),ZC(K),TNATIVE,0.1_EB,1._EB,2._EB))
+   AEX=DEV135_DUDT(X(I),ZC(K),TNATIVE)
+   LINE=TRIM(LINE)//' F'//TRIM(DEV135_INT(4*P-3))//'='//TRIM(DEV135_REAL(GRAD))// &
+        ' F'//TRIM(DEV135_INT(4*P-2))//'='//TRIM(DEV135_REAL(NUM_A))// &
+        ' F'//TRIM(DEV135_INT(4*P-1))//'='//TRIM(DEV135_REAL(GEX))// &
+        ' F'//TRIM(DEV135_INT(4*P  ))//'='//TRIM(DEV135_REAL(AEX))
+ENDDO
+DO P=1,2
+   I=ZI(P); J=1; K=ZK(P)
+   GRAD=RDZN(K)*(HP(I,J,K+1)-HP(I,J,K)); NUM_A=-(FVZ(I,J,K)+GRAD)
+   GEX=RDZN(K)*(NS_H_EXACT(XC(I),ZC(K+1),TNATIVE,0.1_EB,1._EB,2._EB) - &
+                 NS_H_EXACT(XC(I),ZC(K),TNATIVE,0.1_EB,1._EB,2._EB))
+   AEX=DEV135_DWDT(XC(I),Z(K),TNATIVE)
+   LINE=TRIM(LINE)//' F'//TRIM(DEV135_INT(8+4*P-3))//'='//TRIM(DEV135_REAL(GRAD))// &
+        ' F'//TRIM(DEV135_INT(8+4*P-2))//'='//TRIM(DEV135_REAL(NUM_A))// &
+        ' F'//TRIM(DEV135_INT(8+4*P-1))//'='//TRIM(DEV135_REAL(GEX))// &
+        ' F'//TRIM(DEV135_INT(8+4*P  ))//'='//TRIM(DEV135_REAL(AEX))
+ENDDO
+WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+DEV135_TRACE_VALID=.FALSE.
+END SUBROUTINE DEV135_TRACE_POST
+
