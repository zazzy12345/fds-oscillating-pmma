+!> \brief Read one non-rotating translating FRAME namelist line.
+!> \details FRAME is deliberately read after WIND and VENT processing so that
+!> conflicts and the OPEN-boundary contract are checked against final input state.
+
+SUBROUTINE READ_FRAME
+
+REAL(EB) :: AXIS(3),AMPLITUDE,FREQUENCY,PHASE,T_START,RAMP_TIME,AXIS_NORM,GRAVITY_NORM,LAB_VELOCITY(3)
+INTEGER :: N,NM,N_FRAME_READ
+LOGICAL :: APPLY_TO_OPEN_BOUNDARIES,FOUND_OPEN
+CHARACTER(LABEL_LENGTH) :: ID,MOTION_TYPE,PACKET_KIND
+CHARACTER(LEN=64) :: PACKET_FAMILY_SHA256
+INTEGER :: PACKET_TRACER_INDEX,PACKET_BACKGROUND_INDEX
+NAMELIST /FRAM/ AMPLITUDE,APPLY_TO_OPEN_BOUNDARIES,AXIS,FREQUENCY,FYI,ID,LAB_VELOCITY,MOTION_TYPE,PHASE,&
+                RAMP_TIME,T_START,PACKET_KIND,PACKET_FAMILY_SHA256,PACKET_TRACER_INDEX,PACKET_BACKGROUND_INDEX
+
+TRANSLATING_FRAME = .FALSE.
+TF_APPLY_TO_OPEN_BOUNDARIES = .FALSE.
+TF_AXIS = 0._EB
+TF_AMPLITUDE = 0._EB
+TF_FREQUENCY = 0._EB
+TF_PHASE = 0._EB
+TF_T_START = T_BEGIN
+TF_RAMP_TIME = 0._EB
+TF_LAB_VELOCITY = 0._EB
+TF_PACKET_KIND='OFF'
+TF_PACKET_FAMILY_SHA256=REPEAT('0',64)
+TF_PACKET_TRACER_INDEX=-1
+TF_PACKET_BACKGROUND_INDEX=-1
+TF_UOBS_PACKET_REQUESTED=.FALSE.
+TF_ID = 'null'
+TF_MOTION_TYPE = 'HARMONIC_TRANSLATION'
+
+N_FRAME_READ = 0
+REWIND(LU_INPUT) ; INPUT_FILE_LINE_NUMBER = 0
+FRAME_LOOP: DO
+   AXIS = 0._EB
+   AMPLITUDE = -1._EB
+   FREQUENCY = -1._EB
+   PHASE = 0._EB
+   T_START = T_BEGIN
+   RAMP_TIME = 0._EB
+   APPLY_TO_OPEN_BOUNDARIES = .FALSE.
+   LAB_VELOCITY=0._EB
+   PACKET_KIND='OFF'
+   PACKET_FAMILY_SHA256=REPEAT('0',64)
+   PACKET_TRACER_INDEX=-1
+   PACKET_BACKGROUND_INDEX=-1
+   ID = 'PLATE_FRAME'
+   MOTION_TYPE = 'HARMONIC_TRANSLATION'
+   CALL CHECKREAD('FRAM',LU_INPUT,IOS) ; IF (STOP_STATUS==SETUP_STOP) RETURN
+   IF (IOS==1) EXIT FRAME_LOOP
+   READ(LU_INPUT,FRAM,END=11,ERR=12,IOSTAT=IOS)
+   12 IF (IOS>0) THEN
+      CALL SHUTDOWN('ERROR(101): Problem with FRAME line.') ; RETURN
+   ENDIF
+   N_FRAME_READ = N_FRAME_READ + 1
+   IF (N_FRAME_READ>1) THEN
+      CALL SHUTDOWN('ERROR(FRAME): Only one active FRAME line is supported.') ; RETURN
+   ENDIF
+   TF_AXIS = AXIS
+   TF_AMPLITUDE = AMPLITUDE
+   TF_FREQUENCY = FREQUENCY
+   TF_PHASE = PHASE
+   TF_T_START = T_START
+   TF_RAMP_TIME = RAMP_TIME
+   TF_APPLY_TO_OPEN_BOUNDARIES = APPLY_TO_OPEN_BOUNDARIES
+   TF_LAB_VELOCITY=LAB_VELOCITY
+   TF_PACKET_KIND=PACKET_KIND
+   TF_PACKET_FAMILY_SHA256=PACKET_FAMILY_SHA256
+   TF_PACKET_TRACER_INDEX=PACKET_TRACER_INDEX
+   TF_PACKET_BACKGROUND_INDEX=PACKET_BACKGROUND_INDEX
+   TF_UOBS_PACKET_REQUESTED=PACKET_KIND/='OFF'
+   TF_ID = ID
+   TF_MOTION_TYPE = MOTION_TYPE
+ENDDO FRAME_LOOP
+11 REWIND(LU_INPUT) ; INPUT_FILE_LINE_NUMBER = 0
+
+IF (N_FRAME_READ==0) RETURN
+
+IF (TF_MOTION_TYPE/='HARMONIC_TRANSLATION') THEN
+   CALL SHUTDOWN('ERROR(FRAME): Only MOTION_TYPE=''HARMONIC_TRANSLATION'' is supported.') ; RETURN
+ENDIF
+AXIS_NORM = SQRT(DOT_PRODUCT(TF_AXIS,TF_AXIS))
+IF (AXIS_NORM<=TWENTY_EPSILON_EB) THEN
+   CALL SHUTDOWN('ERROR(FRAME): AXIS must be non-zero.') ; RETURN
+ENDIF
+TF_AXIS = TF_AXIS/AXIS_NORM
+IF (TF_AMPLITUDE<=0._EB .OR. TF_FREQUENCY<=0._EB .OR. TF_RAMP_TIME<0._EB) THEN
+   CALL SHUTDOWN('ERROR(FRAME): Require AMPLITUDE>0, FREQUENCY>0, and RAMP_TIME>=0.') ; RETURN
+ENDIF
+GRAVITY_NORM = SQRT(DOT_PRODUCT(GVEC,GVEC))
+IF (GRAVITY_NORM>TWENTY_EPSILON_EB) THEN
+   IF (ABS(DOT_PRODUCT(TF_AXIS,GVEC))/GRAVITY_NORM>TWENTY_EPSILON_EB) THEN
+      CALL SHUTDOWN('ERROR(FRAME): Version 1 requires frame motion perpendicular to gravity.') ; RETURN
+   ENDIF
+ENDIF
+IF (ABS(TIME_SHRINK_FACTOR-1._EB)>SPACING(1._EB)) THEN
+   CALL SHUTDOWN('ERROR(FRAME): TIME_SHRINK_FACTOR is not supported with FRAME.') ; RETURN
+ENDIF
+IF (PRES_FLAG/=FFT_FLAG) THEN
+   CALL SHUTDOWN('ERROR(FRAME): only the FFT pressure solver is supported by FRAME.') ; RETURN
+ENDIF
+IF (CYLINDRICAL .OR. CC_IBM .OR. N_MOVE>0 .OR. N_LAGRANGIAN_CLASSES>0 .OR. SYNTHETIC_EDDY_METHOD .OR. &
+    CTRL_DIRECT_FORCE .OR. SOLID_PHASE_ONLY .OR. FREEZE_VELOCITY) THEN
+   CALL SHUTDOWN('ERROR(FRAME): CYLINDRICAL, MOVE, CC_IBM, particles, direct force, freeze, and solid-only modes are unsupported.')
+   RETURN
+ENDIF
+IF (WIND_INPUT_PRESENT .OR. ANY(ABS(FVEC)>TWENTY_EPSILON_EB) .OR. ANY(ABS(OVEC)>TWENTY_EPSILON_EB)) THEN
+   CALL SHUTDOWN('ERROR(FRAME): FRAME cannot be combined with WIND, FORCE_VECTOR, pressure-gradient force, or Coriolis.')
+   RETURN
+ENDIF
+IF (I_RAMP_GX>0 .OR. I_RAMP_GY>0 .OR. I_RAMP_GZ>0) THEN
+   CALL SHUTDOWN('ERROR(FRAME): Time-varying gravity is not supported with FRAME.') ; RETURN
+ENDIF
+FOUND_OPEN = .FALSE.
+DO NM=1,NMESHES
+   DO N=1,MESHES(NM)%N_VENT
+      IF (MESHES(NM)%VENTS(N)%BOUNDARY_TYPE==OPEN_BOUNDARY) FOUND_OPEN=.TRUE.
+   ENDDO
+ENDDO
+IF (FOUND_OPEN .AND. .NOT.TF_APPLY_TO_OPEN_BOUNDARIES) THEN
+   CALL SHUTDOWN('ERROR(FRAME): OPEN with FRAME requires APPLY_TO_OPEN_BOUNDARIES=.TRUE.') ; RETURN
+ENDIF
+IF (ANY(ABS(TF_LAB_VELOCITY)>TWENTY_EPSILON_EB)) THEN
+   IF (.NOT.TF_APPLY_TO_OPEN_BOUNDARIES .OR. .NOT.FOUND_OPEN .OR. WIND_INPUT_PRESENT) THEN
+      CALL SHUTDOWN('ERROR(FRAME): nonzero LAB_VELOCITY requires APPLY, OPEN, and no WIND.') ; RETURN
+   ENDIF
+ENDIF
+IF (TF_UOBS_PACKET_REQUESTED) THEN
+   SELECT CASE(TF_PACKET_KIND)
+   CASE('PASSIVE','THERMAL','VORTEX')
+   CASE DEFAULT
+      CALL SHUTDOWN('ERROR(FRAME): PACKET_KIND must be OFF, PASSIVE, THERMAL, or VORTEX.') ; RETURN
+   END SELECT
+   IF (UOBS_V7_CHID_ALLOWLIST_SHA256==REPEAT('0',64)) THEN
+      CALL SHUTDOWN('ERROR(FRAME): packet activation closed: frozen V7 CHID allowlist is not registered.') ; RETURN
+   ENDIF
+   IF (TF_PACKET_FAMILY_SHA256/=UOBS_V7_CHID_ALLOWLIST_SHA256) THEN
+      CALL SHUTDOWN('ERROR(FRAME): packet family manifest identity mismatch.') ; RETURN
+   ENDIF
+
+   SELECT CASE(TF_PACKET_KIND)
+   CASE('PASSIVE')
+      SELECT CASE(TRIM(CHID))
+      CASE('tf_g2v7_v7c_passive_d1')
+      CASE('tf_g2v7_v7c_passive_d1p5')
+      CASE('tf_g2v7_v7c_passive_d2')
+      CASE DEFAULT
+         CALL SHUTDOWN('ERROR(FRAME): PASSIVE packet CHID is not registered.') ; RETURN
+      END SELECT
+   CASE('THERMAL')
+      SELECT CASE(TRIM(CHID))
+      CASE('tf_g2v7_v7c_thermal_d1')
+      CASE('tf_g2v7_v7c_thermal_d1p5')
+      CASE('tf_g2v7_v7c_thermal_d2')
+      CASE DEFAULT
+         CALL SHUTDOWN('ERROR(FRAME): THERMAL packet CHID is not registered.') ; RETURN
+      END SELECT
+   CASE('VORTEX')
+      SELECT CASE(TRIM(CHID))
+      CASE('tf_g2v7_v7c_vortex_d1')
+      CASE('tf_g2v7_v7c_vortex_d1p5')
+      CASE('tf_g2v7_v7c_vortex_d2')
+      CASE DEFAULT
+         CALL SHUTDOWN('ERROR(FRAME): VORTEX packet CHID is not registered.') ; RETURN
+      END SELECT
+   END SELECT
+ENDIF
+IF (TF_APPLY_TO_OPEN_BOUNDARIES) THEN
+   IF (.NOT.FOUND_OPEN) THEN
+      CALL SHUTDOWN('ERROR(FRAME): APPLY_TO_OPEN_BOUNDARIES requires at least one OPEN vent.') ; RETURN
+   ENDIF
+   OPEN_WIND_BOUNDARY = .TRUE.
+ENDIF
+
+TRANSLATING_FRAME = .TRUE.
+
+END SUBROUTINE READ_FRAME
+
