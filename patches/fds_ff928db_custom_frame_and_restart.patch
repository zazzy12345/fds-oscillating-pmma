+SUBROUTINE G1EQ_SCALAR_OBSERVE(NM)
+USE UNIFIED_OBSERVATIONS, ONLY: UOBS_ACTIVE,UOBS_CLOCK_SELECTED,UOBS_SAMPLE_SLOT,UOBS_GET_MANIFEST,UOBS_HEAD
+INTEGER, INTENT(IN) :: NM
+INTEGER :: IW,I,J,K,IOR,N,SLOT,BRANCH
+REAL(EB) :: T
+REAL(EB), POINTER, DIMENSION(:,:,:,:) :: ZZP
+CHARACTER(LEN=64) :: MANIFEST
+CHARACTER(LEN=16384) :: LINE
+TYPE(WALL_TYPE), POINTER :: WC
+TYPE(BOUNDARY_COORD_TYPE), POINTER :: BC
+TYPE(BOUNDARY_PROP1_TYPE), POINTER :: B1
+T=G1EQ_PRESSURE_T
+IF (.NOT.G1EQ_ACTIVE(NM) .OR. .NOT.UOBS_ACTIVE('V7',NM)) RETURN
+IF (.NOT.UOBS_CLOCK_SELECTED(T)) RETURN
+IF (.NOT.G1EQ_PRESSURE_VALID .OR. .NOT.ALLOCATED(G1EQ_FACE_STATE)) RETURN
+IF (PREDICTOR) THEN ; ZZP=>ZZS ; ELSE ; ZZP=>ZZ ; ENDIF
+CALL UOBS_GET_MANIFEST(MANIFEST)
+LINE=UOBS_HEAD('V7','g1_header',T,NM) ; WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+DO IW=1,N_EXTERNAL_WALL_CELLS
+   WC=>WALL(IW) ; IF (WC%BOUNDARY_TYPE/=OPEN_BOUNDARY) CYCLE
+   BC=>BOUNDARY_COORD(WC%BC_INDEX) ; B1=>BOUNDARY_PROP1(WC%B1_INDEX)
+   I=BC%II ; J=BC%JJ ; K=BC%KK ; IOR=BC%IOR
+   SLOT=UOBS_SAMPLE_SLOT(IOR,I,J,K,IBAR,JBAR,KBAR) ; IF (SLOT==0) CYCLE
+   BRANCH=G1EQ_FACE_STATE(IW)%BRANCH ; IF (BRANCH/=1 .AND. BRANCH/=2) CYCLE
+   DO N=1,N_TRACKED_SPECIES
+      LINE=G1EQ_HEAD('sampled_scalar_endpoint',T,G1EQ_PRESSURE_DT,NM)
+      CALL G1EQ_ADD_TEXT(LINE,'observation_manifest_sha256',MANIFEST)
+      CALL G1EQ_ADD_INT(LINE,'iw',IW) ; CALL G1EQ_ADD_INT(LINE,'ior',IOR)
+      CALL G1EQ_ADD_INT(LINE,'sample_slot',SLOT) ; CALL G1EQ_ADD_INT(LINE,'scalar_index',N)
+      CALL G1EQ_ADD_TEXT(LINE,'scalar_inflow_mode',MERGE('inflow ','outflow',BRANCH==1))
+      CALL G1EQ_ADD_REAL(LINE,'scalar_ghost',ZZP(BC%II,BC%JJ,BC%KK,N))
+      CALL G1EQ_ADD_REAL(LINE,'scalar_interior',ZZP(BC%IIG,BC%JJG,BC%KKG,N))
+      CALL G1EQ_ADD_REAL(LINE,'scalar_target_native',B1%ZZ_F(N))
+      CALL G1EQ_ADD_REAL(LINE,'temperature_ghost',TMP(BC%II,BC%JJ,BC%KK))
+      CALL G1EQ_ADD_REAL(LINE,'temperature_interior',TMP(BC%IIG,BC%JJG,BC%KKG))
+      CALL G1EQ_ADD_REAL(LINE,'temperature_target_native',B1%TMP_F)
+      WRITE(LU_OUTPUT,'(A)') TRIM(LINE)
+   ENDDO
+ENDDO
+END SUBROUTINE G1EQ_SCALAR_OBSERVE
+
